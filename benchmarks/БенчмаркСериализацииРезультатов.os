&Параметры(1, 100, 1000)
Перем КоличествоКейсов Экспорт; // Число

Перем _РезультатЗапуска; // РезультатЗапускаБенчмарков
Перем _Json;              // Строка

#Область ОбработчикиСобытий

// Создает бенчмарк сериализации результатов.
&КоличествоИтераций(1)
&КоличествоПрогревочныхИтераций(0)
&КоличествоВызововЗаИтерацию(1)
&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает синтетический результат запуска с заданным количеством кейсов.
&ПередКаждымКейсом
Процедура ПодготовитьРезультатЗапуска(Контекст) Экспорт

	_РезультатЗапуска = Новый РезультатЗапускаБенчмарков();
	Дескриптор = Новый ДескрипторБенчмарка(ТипЗнч(ЭтотОбъект), "Сериализовать");
	_РезультатЗапуска.ДескрипторыБенчмарков.Добавить(Дескриптор);

	Для Идентификатор = 1 По КоличествоКейсов Цикл
		РезультатКейса = Новый РезультатЗапускаКейса();
		РезультатКейса.Кейс = Новый КейсБенчмарка(Идентификатор, Дескриптор);
		РезультатКейса.Статистика = СоздатьСтатистику();
		_РезультатЗапуска.Запуски.Добавить(РезультатКейса);
	КонецЦикла;

	_Json = СериализацияОбъектовБенчмаркинга.ВJson(_РезультатЗапуска);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Сериализует подготовленный результат запуска в JSON.
&Бенчмарк
Процедура Сериализовать() Экспорт
	Json = СериализацияОбъектовБенчмаркинга.ВJson(_РезультатЗапуска);
КонецПроцедуры

// Десериализует подготовленное представление результата запуска из JSON.
&Бенчмарк
Процедура Десериализовать() Экспорт
	Результат = СериализацияОбъектовБенчмаркинга.ИзJson(_Json, Тип("РезультатЗапускаБенчмарков"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьСтатистику()

	ЗамерыВремени = Новый Массив();
	ЗамерыПамяти = Новый Массив();

	Для Значение = 1 По 5 Цикл
		ЗамерыВремени.Добавить(Значение);
		ЗамерыПамяти.Добавить(Значение * 64);
	КонецЦикла;

	Замеры = Новый Структура(
		"ЗамерыВремени, ЗамерыПамяти",
		ЗамерыВремени,
		ЗамерыПамяти);

	Возврат Новый СтатистикаБенчмарка(Замеры);

КонецФункции

#КонецОбласти
