&Параметры(15, 50, 100)
Перем КоличествоЗамеров Экспорт; // Число

Перем _ТекущаяСтатистика; // СтатистикаБенчмарка
Перем _ЭталоннаяСтатистика; // СтатистикаБенчмарка
Перем _Результат; // СтатистикаБенчмарка

#Область ОбработчикиСобытий

// Создает бенчмарк расчета относительной статистики.
&КоличествоИтераций(10)
&КоличествоПрогревочныхИтераций(4)
&КоличествоВызововЗаИтерацию(1)
&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает два независимых набора положительных замеров одинаковой длины.
&ПередКаждымКейсом
Процедура ПодготовитьСтатистику(Контекст) Экспорт

	_ТекущаяСтатистика = СоздатьСтатистику(1.2, 80, 3);
	_ЭталоннаяСтатистика = СоздатьСтатистику(1, 64, 1);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Рассчитывает отношение текущей статистики к эталонной.
&Бенчмарк
Процедура РассчитатьОтносительнуюСтатистику() Экспорт
	_Результат = _ТекущаяСтатистика.Разделить(_ЭталоннаяСтатистика);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьСтатистику(МножительВремени, МножительПамяти, Смещение)

	ЗамерыВремени = Новый Массив(КоличествоЗамеров);
	ЗамерыПамяти = Новый Массив(КоличествоЗамеров);

	Для Индекс = 0 По КоличествоЗамеров - 1 Цикл
		ЗамерыВремени[Индекс] = (Индекс + 1) * МножительВремени + Смещение;
		ЗамерыПамяти[Индекс] = (Индекс + 1) * МножительПамяти + Смещение;
	КонецЦикла;

	Замеры = Новый Структура(
		"ЗамерыВремени, ЗамерыПамяти",
		ЗамерыВремени,
		ЗамерыПамяти);

	Возврат Новый СтатистикаБенчмарка(Замеры);

КонецФункции

#КонецОбласти
