&Параметры(10, 100, 1000)
Перем КоличествоКомбинаций Экспорт; // Число

Перем ПараметрА Экспорт; // Число
Перем ПараметрБ Экспорт; // Число

Перем _Конфигурация; // КонфигурацияБенчмарков
Перем _Комбинатор;   // КомбинаторПараметровБенчмарка
Перем _Генератор;    // ГенераторКейсовБенчмарков
Перем _Результат;    // Массив

#Область ОбработчикиСобытий

// Создает бенчмарк генерации кейсов.
&КоличествоИтераций(10)
&КоличествоПрогревочныхИтераций(4)
&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подготавливает синтетическую конфигурацию с заданным количеством комбинаций параметров.
&ПередКаждымКейсом
Процедура ПодготовитьГенерациюКейсов(Контекст) Экспорт

	_Конфигурация = Новый КонфигурацияБенчмарков();
	ДобавитьЗначенияПараметра(_Конфигурация, "ПараметрА", 10);
	ДобавитьЗначенияПараметра(_Конфигурация, "ПараметрБ", КоличествоКомбинаций / 10);

	_Комбинатор = Новый КомбинаторПараметровБенчмарка();

	ДескрипторыБенчмарков = Новый КоллекцияДескрипторовБенчмарков();
	ДескрипторыБенчмарков.Добавить(
		Новый ДескрипторБенчмарка(ТипЗнч(ЭтотОбъект), "СгенерироватьКейсы")
	);

	_Генератор = Новый ГенераторКейсовБенчмарков(ДескрипторыБенчмарков, _Конфигурация);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Формирует декартово произведение параметров синтетической конфигурации.
&Бенчмарк
Процедура СкомбинироватьПараметры() Экспорт
	_Результат = _Комбинатор.Комбинировать(_Конфигурация.Параметры());
КонецПроцедуры

// Генерирует все кейсы для синтетической конфигурации.
&Бенчмарк
Процедура СгенерироватьКейсы() Экспорт
	_Результат = _Генератор.СгенерироватьВсеКейсы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЗначенияПараметра(Конфигурация, ИмяПараметра, КоличествоЗначений)

	Для Значение = 1 По КоличествоЗначений Цикл
		Конфигурация.ДобавитьПараметр(ИмяПараметра, Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
