#Область ПрограммныйИнтерфейс

// Возвращает уровень диагностического события-предупреждения.
//
// Возвращаемое значение:
//   Строка - Идентификатор уровня диагностического события.
Функция Предупреждение() Экспорт
	Возврат "Warning";
КонецФункции

// Возвращает информационный уровень диагностического события.
//
// Возвращаемое значение:
//   Строка - Идентификатор уровня диагностического события.
Функция Информация() Экспорт
	Возврат "Information";
КонецФункции

#КонецОбласти
