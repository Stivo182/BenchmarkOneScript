#Область ПрограммныйИнтерфейс

// Возвращает код недостаточного количества измерений.
//
// Возвращаемое значение:
//   Строка - Идентификатор диагностического события.
Функция НедостаточноИзмерений() Экспорт
	Возврат "InsufficientMeasurements";
КонецФункции

// Возвращает код невозможности оценки относительной погрешности.
//
// Возвращаемое значение:
//   Строка - Идентификатор диагностического события.
Функция НевозможноОценитьПогрешность() Экспорт
	Возврат "RelativeErrorUnavailable";
КонецФункции

// Возвращает код превышения целевой относительной погрешности.
//
// Возвращаемое значение:
//   Строка - Идентификатор диагностического события.
Функция ПогрешностьВышеЦели() Экспорт
	Возврат "RelativeErrorExceedsTarget";
КонецФункции

// Возвращает код превышения рекомендованной относительной погрешности.
//
// Возвращаемое значение:
//   Строка - Идентификатор диагностического события.
Функция ПогрешностьВышеОриентира() Экспорт
	Возврат "RelativeErrorExceedsRecommendation";
КонецФункции

// Возвращает код слишком короткой итерации.
//
// Возвращаемое значение:
//   Строка - Идентификатор диагностического события.
Функция СлишкомКороткаяИтерация() Экспорт
	Возврат "IterationTooShort";
КонецФункции

// Возвращает код обнаруженных выбросов.
//
// Возвращаемое значение:
//   Строка - Идентификатор диагностического события.
Функция ОбнаруженыВыбросы() Экспорт
	Возврат "OutliersDetected";
КонецФункции

#КонецОбласти
