#Использовать logos

Перем _Наблюдатели;             // Массив Из Произвольный
Перем _БлокировкаНаблюдателей;  // БлокировкаРесурса
Перем _Лог;                     // Лог

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_Наблюдатели = Новый Массив();
	_БлокировкаНаблюдателей = Новый БлокировкаРесурса(_Наблюдатели);
	_Лог = Логирование.ПолучитьЛог("oscript.lib.benchmark.ДиспетчерСобытийВыполненияБенчмарков");
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет наблюдателя событий выполнения.
//
// Параметры:
//   Наблюдатель - Произвольный - Объект с методом ОбработатьСобытие(Событие).
Процедура ДобавитьНаблюдатель(Наблюдатель) Экспорт

	_БлокировкаНаблюдателей.Заблокировать();

	Попытка
		_Наблюдатели.Добавить(Наблюдатель);
	Исключение
		_БлокировкаНаблюдателей.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаНаблюдателей.Разблокировать();

КонецПроцедуры

// Публикует событие всем наблюдателям; ошибка одного наблюдателя не прерывает рассылку.
// Изменения подписок во время обработки применяются со следующей публикации.
//
// Параметры:
//   Событие - СобытиеВыполненияБенчмарков - Публикуемое событие.
Процедура Опубликовать(Событие) Экспорт

	Наблюдатели = ПолучитьСнимокНаблюдателей();

	Для Каждого Наблюдатель Из Наблюдатели Цикл
		Попытка
			Наблюдатель.ОбработатьСобытие(Событие);
		Исключение
			_Лог.Ошибка("Ошибка наблюдателя при обработке события выполнения: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСнимокНаблюдателей()

	_БлокировкаНаблюдателей.Заблокировать();

	Попытка
		Наблюдатели = Новый Массив();

		Для Каждого Наблюдатель Из _Наблюдатели Цикл
			Наблюдатели.Добавить(Наблюдатель);
		КонецЦикла;
	Исключение
		_БлокировкаНаблюдателей.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаНаблюдателей.Разблокировать();

	Возврат Наблюдатели;

КонецФункции

#КонецОбласти
