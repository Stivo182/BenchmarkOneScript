#Использовать fs

Перем _ПутьКФайлу; // Строка
Перем _СодержимоеФайла; // Строка, Неопределено
Перем _РегуляркаДирективыИспользования; // РегулярноеВыражение
Перем _РегуляркаАргументаДирективыИспользования; // РегулярноеВыражение
Перем _РегуляркаДирективыОбласти; // РегулярноеВыражение
Перем _РегуляркаУсловнойДирективы; // РегулярноеВыражение
Перем _РегуляркаРежимаКомпиляции; // РегулярноеВыражение

#Область ОбработчикиСобытий

// Инициализирует анализатор входного сценария бенчмарка.
//
// Параметры:
//   ПутьКФайлу - Строка - Полный путь к файлу сценария
Процедура ПриСозданииОбъекта(ПутьКФайлу)

	_ПутьКФайлу = ПутьКФайлу;
	_СодержимоеФайла = Неопределено;

	_РегуляркаДирективыИспользования = Новый РегулярноеВыражение(
		"^\s*#(?:Использовать|Use)(?:\s|$)"
	);
	_РегуляркаДирективыИспользования.ИгнорироватьРегистр = Истина;

	_РегуляркаАргументаДирективыИспользования = Новый РегулярноеВыражение(
		"^\s*#(?:Использовать|Use)\s+(?:""([^""]+)""|(\S+))"
	);
	_РегуляркаАргументаДирективыИспользования.ИгнорироватьРегистр = Истина;

	_РегуляркаДирективыОбласти = Новый РегулярноеВыражение(
		"^\s*#(?:Область|КонецОбласти)(?:\s|$)"
	);
	_РегуляркаДирективыОбласти.ИгнорироватьРегистр = Истина;

	_РегуляркаУсловнойДирективы = Новый РегулярноеВыражение(
		"^\s*#(?:Если|ИначеЕсли|Иначе|КонецЕсли|If|ElseIf|Else|EndIf)(?:\s|$)"
	);
	_РегуляркаУсловнойДирективы.ИгнорироватьРегистр = Истина;

	_РегуляркаРежимаКомпиляции = Новый РегулярноеВыражение("^\s*#(?:native|stack)(?:\s|$)");
	_РегуляркаРежимаКомпиляции.ИгнорироватьРегистр = Истина;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает директивы #Использовать и #Use из сценария вместе с их условиями.
// Путевые аргументы заменяются абсолютными путями, именованные остаются без изменений.
//
// Возвращаемое значение:
//   Массив из Строка - Директивы использования и их условия в порядке объявления
Функция ДирективыИспользования() Экспорт

	Возврат РазобратьДирективыИспользования();

КонецФункции

// Возвращает части алгоритма, из которого можно сформировать бенчмарк.
//
// Возвращаемое значение:
//   Структура - Свойства:
//     * ИмяФайла     - Строка - Имя исходного файла без расширения
//     * Преамбула    - Массив из Строка - Строки преамбулы сценария
//     * ТелоАлгоритма - Массив из Строка - Остальной текст сценария
Функция ОписаниеАлгоритма() Экспорт

	Преамбула = Новый Массив();
	ТелоАлгоритма = Новый Массив();
	ТелоМодуляНачалось = Ложь;

	Для Каждого СтрокаФайла Из СтрокиСценария() Цикл
		СтрокаБезОтступов = СокрЛП(СтрокаФайла);

		Если ЭтоДирективаИспользования(СтрокаБезОтступов) Тогда
			Продолжить;
		КонецЕсли;

		Если _РегуляркаРежимаКомпиляции.Совпадает(СтрокаБезОтступов) Тогда
			Преамбула.Добавить(СтрокаФайла);
			Продолжить;
		КонецЕсли;

		Если Не ТелоМодуляНачалось И (ПустаяСтрока(СтрокаБезОтступов)
			Или СтрНачинаетсяС(СтрокаБезОтступов, "//")
			Или ЭтоДирективаОбласти(СтрокаБезОтступов)) Тогда
			Преамбула.Добавить(СтрокаФайла);
			Продолжить;
		КонецЕсли;

		ТелоМодуляНачалось = Истина;
		ТелоАлгоритма.Добавить(СтрокаФайла);
	КонецЦикла;

	Для Каждого Директива Из РазобратьДирективыИспользования() Цикл
		Преамбула.Добавить(Директива);
	КонецЦикла;

	ИмяФайла = Новый Файл(_ПутьКФайлу).ИмяБезРасширения;
	Возврат Новый Структура("ИмяФайла, Преамбула, ТелоАлгоритма", ИмяФайла, Преамбула, ТелоАлгоритма);

КонецФункции

// Проверяет, содержит ли сценарий аннотацию бенчмарка.
//
// Возвращаемое значение:
//   Булево - Истина, если в сценарии найдена аннотация &Бенчмарк
Функция СодержитБенчмарки() Экспорт

	Для Каждого СтрокаФайла Из СтрокиСценария() Цикл
		Если СтрНачинаетсяС(НРег(СокрЛП(СтрокаФайла)), "&бенчмарк") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьДирективыИспользования()

	Директивы = Новый Массив();
	ЕстьИспользование = Ложь;
	Для Каждого СтрокаФайла Из СтрокиСценария() Цикл
		СтрокаБезОтступов = СокрЛП(СтрокаФайла);

		Если _РегуляркаУсловнойДирективы.Совпадает(СтрокаБезОтступов) Тогда
			Директивы.Добавить(СтрокаБезОтступов);
			Продолжить;
		КонецЕсли;

		Если Не ЭтоДирективаИспользования(СтрокаБезОтступов) Тогда
			Продолжить;
		КонецЕсли;

		Аргумент = АргументДирективыИспользования(СтрокаБезОтступов);
		Если Аргумент = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Директивы.Добавить(НормализоватьДирективуИспользования(СтрокаБезОтступов));
		ЕстьИспользование = Истина;
	КонецЦикла;

	Возврат ?(ЕстьИспользование, Директивы, Новый Массив());

КонецФункции

Функция ЭтоДирективаИспользования(Строка)

	Возврат _РегуляркаДирективыИспользования.Совпадает(Строка);

КонецФункции

Функция НормализоватьДирективуИспользования(СтрокаИспользования)

	Если Не ЭтоДирективаИспользования(СтрокаИспользования) Тогда
		Возврат СтрокаИспользования;
	КонецЕсли;

	Аргумент = АргументДирективыИспользования(СтрокаИспользования);
	Если Аргумент = Неопределено Тогда
		Возврат СтрокаИспользования;
	КонецЕсли;

	Если Не Аргумент.ВКавычках И Не РаботаСПутямиФайловойСистемы.ЭтоЯвныйПуть(Аргумент.Значение) Тогда
		Возврат СтрокаИспользования;
	КонецЕсли;

	КаталогСценария = Новый Файл(_ПутьКФайлу).Путь;
	ПолныйПуть = РаботаСПутямиФайловойСистемы.ПолучитьАбсолютныйПуть(Аргумент.Значение, КаталогСценария);

	Возврат "#Использовать """ + ЭкранироватьКавычки(ПолныйПуть) + """";

КонецФункции

Функция СтрокиСценария()

	Если _СодержимоеФайла = Неопределено Тогда
		ЧтениеТекста = Новый ЧтениеТекста(_ПутьКФайлу, КодировкаТекста.UTF8);
		_СодержимоеФайла = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
	КонецЕсли;

	Возврат СтрРазделить(_СодержимоеФайла, Символы.ПС, Ложь);

КонецФункции

Функция АргументДирективыИспользования(СтрокаИспользования)

	Совпадения = _РегуляркаАргументаДирективыИспользования.НайтиСовпадения(СтрокаИспользования);
	Если Совпадения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПутьВКавычках = Совпадения[0].Группы[1].Значение;
	ВКавычках = ЗначениеЗаполнено(ПутьВКавычках);
	Значение = ?(ВКавычках, ПутьВКавычках, Совпадения[0].Группы[2].Значение);

	Возврат Новый Структура("Значение, ВКавычках", Значение, ВКавычках);

КонецФункции

Функция ЭтоДирективаОбласти(Строка)

	Возврат _РегуляркаДирективыОбласти.Совпадает(Строка);

КонецФункции

Функция ЭкранироватьКавычки(Значение)

	Кавычка = """";
	Возврат СтрЗаменить(Значение, Кавычка, Кавычка + Кавычка);

КонецФункции

#КонецОбласти
