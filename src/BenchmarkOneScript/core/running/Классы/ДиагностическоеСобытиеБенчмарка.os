// BSLLS:ExportVariables-off

&Сериализуемое("Code")
&Тип("Строка")
Перем Код Экспорт; // Строка

&Сериализуемое("Severity")
&Тип("Строка")
Перем Уровень Экспорт; // Строка

&Сериализуемое("NumericParameters")
&Тип("Структура")
Перем ЧисловыеПараметры Экспорт; // Структура

#Область ОбработчикиСобытий

// Создает диагностическое событие измерений.
//
// Параметры:
//   Код                 - Строка - Стабильный код события.
//   Уровень             - Строка - Уровень серьезности события.
//   ЧисловыеПараметры   - Структура - Измеренные значения и пороги.
Процедура ПриСозданииОбъекта(Код = "", Уровень = "", ЧисловыеПараметры = Неопределено)

	ЭтотОбъект.Код = Код;
	ЭтотОбъект.Уровень = Уровень;
	ЭтотОбъект.ЧисловыеПараметры = ?(ЧисловыеПараметры = Неопределено, Новый Структура(), ЧисловыеПараметры);

КонецПроцедуры

#КонецОбласти
