// BSLLS:ExportVariables-off

Перем _Конфигурация; // КонфигурацияБенчмарков

#Область ОбработчикиСобытий

// Создает оценщик достоверности результатов бенчмарков.
//
// Параметры:
//   Конфигурация - КонфигурацияБенчмарков - Настройки запуска и оценки результатов.
Процедура ПриСозданииОбъекта(Конфигурация) Экспорт

	_Конфигурация = Конфигурация;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Оценивает статистическое сравнение и качество измерений для результатов запусков.
// Изменяет свойства результатов запусков: статистическое сравнение и диагностические события.
//
// Параметры:
//   Запуски - Массив из РезультатЗапускаКейса - Результаты запусков для оценки.
Процедура Оценить(Запуски) Экспорт

	Для Каждого РезультатЗапуска Из Запуски Цикл
		РезультатЗапуска.Предупреждения.Очистить();

		ОценитьСтатистическоеСравнение(РезультатЗапуска);
		ДобавитьПредупреждениеОНедостаткеИзмерений(РезультатЗапуска);
		ДобавитьПредупреждениеОПогрешности(РезультатЗапуска);
		ДобавитьПредупреждениеОКороткойИтерации(РезультатЗапуска);
		ДобавитьПредупреждениеОВыбросах(РезультатЗапуска);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОценитьСтатистическоеСравнение(РезультатЗапуска)

	Если Не _Конфигурация.СтатистическоеСравнениеСЭталономВключено() Тогда
		РезультатЗапуска.РезультатСтатистическогоСравнения = "";
		Возврат;
	КонецЕсли;

	Если РезультатЗапуска.ЭтоЭталон Тогда
		РезультатЗапуска.РезультатСтатистическогоСравнения = РезультатыСравненияБенчмарков.Эталон();
		Возврат;
	КонецЕсли;

	Если РезультатЗапуска.Эталон = Неопределено Тогда
		РезультатЗапуска.РезультатСтатистическогоСравнения = "";
		Возврат;
	КонецЕсли;

	РезультатЗапуска.РезультатСтатистическогоСравнения = МатематическиеФункцииБенчмарков.ОценитьРазличиеПоКритериюМаннаУитни(
		РезультатЗапуска.Статистика.ЗамерыВремени(),
		РезультатЗапуска.Эталон.Статистика.ЗамерыВремени(),
		_Конфигурация.ОтносительныйПорогПрактическойЗначимости(),
		_Конфигурация.УровеньЗначимостиСтатистическогоСравнения()
	);

КонецПроцедуры

Процедура ДобавитьПредупреждениеОНедостаткеИзмерений(РезультатЗапуска)

	Если РезультатЗапуска.Статистика.КоличествоИтераций >= 2 Тогда
		Возврат;
	КонецЕсли;

	ДобавитьДиагностическоеСобытие(
		РезультатЗапуска,
		КодыДиагностическихСобытийБенчмарков.НедостаточноИзмерений(),
		УровниДиагностическихСобытийБенчмарков.Предупреждение(),
		Новый Структура("КоличествоИзмерений, ТребуемоеКоличествоИзмерений", РезультатЗапуска.Статистика.КоличествоИтераций, 2)
	);

КонецПроцедуры

Процедура ДобавитьПредупреждениеОПогрешности(РезультатЗапуска)

	ОтносительнаяПогрешность = РезультатЗапуска.Статистика.ОтносительнаяПогрешность;
	Если ОтносительнаяПогрешность = Неопределено Тогда
		Если _Конфигурация.АдаптивныеИтерацииВключены()
			И РезультатЗапуска.Статистика.КоличествоИтераций >= _Конфигурация.МаксимальноеКоличествоАдаптивныхИтераций() Тогда
			ДобавитьДиагностическоеСобытие(
				РезультатЗапуска,
				КодыДиагностическихСобытийБенчмарков.НевозможноОценитьПогрешность(),
				УровниДиагностическихСобытийБенчмарков.Предупреждение(),
				Новый Структура("ЦелеваяОтносительнаяПогрешность, КоличествоИзмерений", _Конфигурация.ЦелеваяОтносительнаяПогрешность(), РезультатЗапуска.Статистика.КоличествоИтераций)
			);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Диагностика погрешности использует точность до сотых процента.
	ОтносительнаяПогрешность = Окр(ОтносительнаяПогрешность, 4);

	Если _Конфигурация.АдаптивныеИтерацииВключены() Тогда
		Если РезультатЗапуска.Статистика.КоличествоИтераций < _Конфигурация.МаксимальноеКоличествоАдаптивныхИтераций()
			Или ОтносительнаяПогрешность <= _Конфигурация.ЦелеваяОтносительнаяПогрешность() Тогда
			Возврат;
		КонецЕсли;

		ДобавитьДиагностическоеСобытие(
			РезультатЗапуска,
			КодыДиагностическихСобытийБенчмарков.ПогрешностьВышеЦели(),
			УровниДиагностическихСобытийБенчмарков.Предупреждение(),
			Новый Структура("ФактическаяОтносительнаяПогрешность, ЦелеваяОтносительнаяПогрешность, КоличествоИзмерений", ОтносительнаяПогрешность, _Конфигурация.ЦелеваяОтносительнаяПогрешность(), РезультатЗапуска.Статистика.КоличествоИтераций)
		);
		Возврат;
	КонецЕсли;

	Если ОтносительнаяПогрешность <= _Конфигурация.ЦелеваяОтносительнаяПогрешность() Тогда
		Возврат;
	КонецЕсли;

	ДобавитьДиагностическоеСобытие(
		РезультатЗапуска,
		КодыДиагностическихСобытийБенчмарков.ПогрешностьВышеОриентира(),
		УровниДиагностическихСобытийБенчмарков.Информация(),
		Новый Структура("ФактическаяОтносительнаяПогрешность, РекомендуемаяОтносительнаяПогрешность", ОтносительнаяПогрешность, _Конфигурация.ЦелеваяОтносительнаяПогрешность())
	);

КонецПроцедуры

Процедура ДобавитьПредупреждениеОКороткойИтерации(РезультатЗапуска)

	Если Не ИспользуетсяМинимальноеВремяИтерации() Тогда
		Возврат;
	КонецЕсли;

	МинимальноеВремяИтерации = ЕдиницыИзмеренийБенчмарков.Конвертировать(
		_Конфигурация.МинимальноеВремяИтерации(),
		ЕдиницыИзмеренийБенчмарков.Миллисекунда,
		ЕдиницыИзмеренийБенчмарков.Наносекунда
	);
	СреднееВремяИтерации = СреднееВремяИзмерительнойИтерации(РезультатЗапуска.Замеры);

	Если СреднееВремяИтерации = Неопределено Или СреднееВремяИтерации >= МинимальноеВремяИтерации Тогда
		Возврат;
	КонецЕсли;

	ДобавитьДиагностическоеСобытие(
		РезультатЗапуска,
		КодыДиагностическихСобытийБенчмарков.СлишкомКороткаяИтерация(),
		УровниДиагностическихСобытийБенчмарков.Предупреждение(),
		Новый Структура(
			"СредняяДлительностьИтерацииВМиллисекундах, ЦелеваяДлительностьИтерацииВМиллисекундах, КоличествоВызовов",
			СреднееВремяИтерации / 1000000,
			_Конфигурация.МинимальноеВремяИтерации(),
			КоличествоОперацийПоследнейИзмерительнойИтерации(РезультатЗапуска.Замеры)
		)
	);

КонецПроцедуры

Процедура ДобавитьПредупреждениеОВыбросах(РезультатЗапуска)

	Если РезультатЗапуска.Статистика.КоличествоВыбросов <= 0 Тогда
		Возврат;
	КонецЕсли;

	ДобавитьДиагностическоеСобытие(
		РезультатЗапуска,
		КодыДиагностическихСобытийБенчмарков.ОбнаруженыВыбросы(),
		УровниДиагностическихСобытийБенчмарков.Информация(),
		Новый Структура("КоличествоВыбросов, КоличествоИзмерений", РезультатЗапуска.Статистика.КоличествоВыбросов, РезультатЗапуска.Статистика.КоличествоИтераций)
	);

КонецПроцедуры

Процедура ДобавитьДиагностическоеСобытие(РезультатЗапуска, Код, Уровень, ЧисловыеПараметры)

	РезультатЗапуска.Предупреждения.Добавить(Новый ДиагностическоеСобытиеБенчмарка(Код, Уровень, ЧисловыеПараметры));

КонецПроцедуры

Функция СреднееВремяИзмерительнойИтерации(Замеры)

	СуммаВремени = 0;
	КоличествоИтераций = 0;
	Для Каждого Замер Из Замеры Цикл
		Если Замер.Этап = ЭтапыБенчмарка.Измерение Тогда
			СуммаВремени = СуммаВремени + Замер.Наносекунд;
			КоличествоИтераций = КоличествоИтераций + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоИтераций = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СуммаВремени / КоличествоИтераций;

КонецФункции

Функция КоличествоОперацийПоследнейИзмерительнойИтерации(Замеры)

	КоличествоОпераций = Неопределено;
	Для Каждого Замер Из Замеры Цикл
		Если Замер.Этап = ЭтапыБенчмарка.Измерение Тогда
			КоличествоОпераций = Замер.КоличествоОпераций;
		КонецЕсли;
	КонецЦикла;

	Возврат КоличествоОпераций;

КонецФункции

Функция ИспользуетсяМинимальноеВремяИтерации()

	Возврат _Конфигурация.Стратегия() = СтратегииЗапускаБенчмарка.ПропускнаяСпособность
		И _Конфигурация.КоличествоВызововЗаИтерацию() = 0
		И _Конфигурация.ОбработчикиСобытия(СобытияБенчмарков.ПередИтерацией).Количество() = 0
		И _Конфигурация.ОбработчикиСобытия(СобытияБенчмарков.ПослеИтерации).Количество() = 0;

КонецФункции

#КонецОбласти
