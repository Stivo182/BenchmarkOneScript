#Использовать fs
#Использовать tempfiles
#Использовать logos

Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов
Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Создает подготовитель файлов бенчмарка.
//
// Параметры:
//   МенеджерВременныхФайлов - МенеджерВременныхФайлов - Внешний менеджер временных файлов. 
//                           - Неопределено              Если не передан, создается новый.
//                          
Процедура ПриСозданииОбъекта(МенеджерВременныхФайлов = Неопределено)

	Если МенеджерВременныхФайлов = Неопределено Тогда
		_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	Иначе
		_МенеджерВременныхФайлов = МенеджерВременныхФайлов;
	КонецЕсли;

	_Лог = Логирование.ПолучитьЛог("oscript.lib.benchmark.ПодготовительФайлаБенчмарка");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Подготавливает файл для запуска через стандартный пайплайн бенчмарков.
//
// Если файл уже содержит хотя бы один бенчмарк, возвращается исходный путь.
// Если бенчмарков нет, создается отдельный временный каталог. В него записывается
// файл с кодом модуля, обернутым в процедуру с аннотацией &Бенчмарк. Если рядом
// с исходным файлом есть oscript.cfg, его настройки записываются в тот же каталог.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к исходному файлу сценария
//
// Возвращаемое значение:
//   Строка - Путь к исходному или временному файлу
Функция Подготовить(ПутьКФайлу) Экспорт

	АнализаторСценария = Новый АнализаторСценарияБенчмарка(ПутьКФайлу);
	Если АнализаторСценария.СодержитБенчмарки() Тогда
		Возврат ПутьКФайлу;
	КонецЕсли;

	ОписаниеАлгоритма = АнализаторСценария.ОписаниеАлгоритма();
	ПутьКВременномуФайлу = СоздатьВременныйФайлБенчмарка(ОписаниеАлгоритма, ПутьКФайлу);

	_Лог.Отладка("Создан временный файл <%1> для запуска алгоритма из <%2>", ПутьКВременномуФайлу, ПутьКФайлу);

	Возврат ПутьКВременномуФайлу;

КонецФункции

// Проверяет, содержит ли файл хотя бы один бенчмарк.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к исходному файлу сценария
//
// Возвращаемое значение:
//   Булево - Истина, если в файле найден хотя бы один бенчмарк
Функция СодержитБенчмарки(ПутьКФайлу) Экспорт

	АнализаторСценария = Новый АнализаторСценарияБенчмарка(ПутьКФайлу);
	Возврат АнализаторСценария.СодержитБенчмарки();

КонецФункции

// Удаляет все временные файлы и каталоги, созданные в процессе подготовки.
//
// Метод следует вызывать после завершения запуска или при ошибке, чтобы
// освободить накопленные временные ресурсы.
Процедура Очистить() Экспорт

	_МенеджерВременныхФайлов.Удалить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьФайл(ПутьКФайлу, СодержимоеФайла)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(СодержимоеФайла);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

Функция СоздатьВременныйФайлБенчмарка(ОписаниеАлгоритма, ПутьКИсходномуФайлу)

	Каталог = _МенеджерВременныхФайлов.СоздатьКаталог();

	ПутьКФайлуБенчмарка = СоздатьФайлБенчмарка(ОписаниеАлгоритма, Каталог);
	СоздатьФайлКонфигурацииOneScript(ПутьКИсходномуФайлу, Каталог);

	Возврат ПутьКФайлуБенчмарка;

КонецФункции

Функция СоздатьФайлБенчмарка(ОписаниеАлгоритма, Каталог)

	ПутьКФайлу = ОбъединитьПути(
		Каталог,
		ОписаниеАлгоритма.ИмяФайла + ".os"
	);
	ЗаписатьФайл(ПутьКФайлу, ТекстВременногоБенчмарка(ОписаниеАлгоритма));

	Возврат ПутьКФайлу;

КонецФункции

Процедура СоздатьФайлКонфигурацииOneScript(ПутьКИсходномуФайлу, Каталог)

	КаталогИсходногоФайла = Новый Файл(ПутьКИсходномуФайлу).Путь;
	ПутьКФайлуКонфигурацииOneScript = ОбъединитьПути(КаталогИсходногоФайла, "oscript.cfg");

	Если Не ФС.ФайлСуществует(ПутьКФайлуКонфигурацииOneScript) Тогда
		Возврат;
	КонецЕсли;

	МенеджерПараметров = Новый МенеджерПараметровКонфигурацииOneScript(ПутьКФайлуКонфигурацииOneScript);
	МенеджерПараметров.УчитыватьВсеПараметрыДополнительныхФайлов();
	МенеджерПараметров.ЗаписатьВКаталог(Каталог);

КонецПроцедуры

Функция ТекстВременногоБенчмарка(ОписаниеАлгоритма)

	ЧастиФайла = Новый Массив();
	Для Каждого СтрокаПреамбулы Из ОписаниеАлгоритма.Преамбула Цикл
		ЧастиФайла.Добавить(СтрокаПреамбулы);
	КонецЦикла;

	Если ОписаниеАлгоритма.Преамбула.Количество() > 0 Тогда
		ЧастиФайла.Добавить("");
	КонецЕсли;

	ЧастиФайла.Добавить(СтрШаблон("&Бенчмарк(Наименование = ""%1"")", ОписаниеАлгоритма.ИмяФайла));
	ЧастиФайла.Добавить("Процедура Бенчмарк() Экспорт");

	Для Каждого СтрокаАлгоритма Из ОписаниеАлгоритма.ТелоАлгоритма Цикл
		ЧастиФайла.Добавить(СтрокаАлгоритма);
	КонецЦикла;

	ЧастиФайла.Добавить("КонецПроцедуры");

	Возврат СтрСоединить(ЧастиФайла, Символы.ПС);

КонецФункции

#КонецОбласти
