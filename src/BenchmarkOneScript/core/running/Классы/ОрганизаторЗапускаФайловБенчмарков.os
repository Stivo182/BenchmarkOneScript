#Использовать fs
#Использовать logos

Перем _Лог;                           // Лог
Перем _МассивФайлов;                  // Массив из Строка
Перем _Рекурсивно;                    // Булево
Перем _Настройки;                     // НастройкиЗапускаБенчмарков, Неопределено
Перем _ПереопределенияКонфигурации;   // КонфигурацияБенчмарков, Неопределено
Перем _ПодготовительФайлаБенчмарка;   // ПодготовительФайлаБенчмарка
Перем _ПортОтладки;                   // Число
Перем _ДиспетчерСобытий;              // ДиспетчерСобытийВыполненияБенчмарков
Перем _ФильтрБенчмарков;              // ФильтрБенчмарков

#Область ОбработчикиСобытий

// Запускает бенчмарки из переданных файлов и каталогов.
//
// При явной передаче обычных *.os-файлов без аннотации &Бенчмарк
// такие алгоритмы подготавливаются и после изолированного запуска
// объединяются в один итоговый отчет.
//
// Параметры:
//   МассивФайлов                 - Массив из Строка               - Пути к файлам и каталогам
//   Рекурсивно                   - Булево                         - Рекурсивный поиск *.os в каталогах
//   Настройки                    - НастройкиЗапускаБенчмарков     - Настройки запуска, если заданы
Процедура ПриСозданииОбъекта(МассивФайлов, Рекурсивно = Ложь, Настройки = Неопределено)

	_МассивФайлов = ?(МассивФайлов = Неопределено, Новый Массив(), МассивФайлов);
	_Рекурсивно = Рекурсивно;
	_Настройки = Настройки;
	_ПереопределенияКонфигурации = Неопределено;
	_ПодготовительФайлаБенчмарка = Новый ПодготовительФайлаБенчмарка();
	_ПортОтладки = 0;
	_ФильтрБенчмарков = Новый ФильтрБенчмарков();
	_ДиспетчерСобытий = Новый ДиспетчерСобытийВыполненияБенчмарков();
	_ДиспетчерСобытий.ДобавитьНаблюдатель(Новый КонсольныйНаблюдательВыполненияБенчмарков());
	_Лог = Логирование.ПолучитьЛог("oscript.lib.benchmark.ОрганизаторЗапускаФайловБенчмарков");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Запускает бенчмарки из переданных файлов и каталогов.
Процедура Запустить() Экспорт

	Попытка
		ВыполнитьЗапуск();
	Исключение
		УдалитьВременныеФайлы();
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременныеФайлы();

КонецПроцедуры

// Устанавливает порт отладки для запускаемых бенчмарков.
//
// Параметры:
//   Порт - Число
Процедура УстановитьПортОтладки(Порт) Экспорт
	_ПортОтладки = Порт;
КонецПроцедуры

// Устанавливает конфигурацию с явно заданными переопределениями запуска.
// Переопределения применяются после конфигурации из аннотаций и настроек.
//
// Параметры:
//   Конфигурация - КонфигурацияБенчмарков, Неопределено
Процедура УстановитьПереопределенияКонфигурации(Конфигурация) Экспорт
	_ПереопределенияКонфигурации = Конфигурация;
КонецПроцедуры

// Устанавливает фильтр запускаемых бенчмарков.
//
// Параметры:
//   Фильтр - ФильтрБенчмарков
Процедура УстановитьФильтрБенчмарков(Фильтр) Экспорт
	_ФильтрБенчмарков = Фильтр;
КонецПроцедуры

// Устанавливает диспетчер событий выполнения бенчмарков.
//
// Параметры:
//   ДиспетчерСобытий - ДиспетчерСобытийВыполненияБенчмарков
Процедура УстановитьДиспетчерСобытий(ДиспетчерСобытий) Экспорт
	_ДиспетчерСобытий = ДиспетчерСобытий;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьЗапуск()

	ГруппыЗапуска = НайтиГруппыФайловБенчмарков();
	ЕстьЗапущенныеБенчмарки = Ложь;

	Для Каждого ГруппаФайловБенчмарков Из ГруппыЗапуска Цикл

		ПодключенныеТипы = ПодключитьБенчмаркиИзФайлов(ГруппаФайловБенчмарков.Файлы);
		Если ПодключенныеТипы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ГруппаФайловБенчмарков.ОбъединятьРезультаты Тогда
			ГруппаЗапущена = ЗапуститьБенчмаркиСОбъединениемРезультатов(ПодключенныеТипы);
			ЕстьЗапущенныеБенчмарки = ЕстьЗапущенныеБенчмарки Или ГруппаЗапущена;
		Иначе
			Для Каждого Тип Из ПодключенныеТипы Цикл
				РезультатЗапуска = ЗапуститьБенчмарк(Тип);
				ЕстьЗапущенныеБенчмарки = ЕстьЗапущенныеБенчмарки Или РезультатЗапуска <> Неопределено;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	Если Не ЕстьЗапущенныеБенчмарки Тогда
		Если _ФильтрБенчмарков.Установлен() Тогда
			ВызватьИсключение "Не найдено ни одного бенчмарка по заданным фильтрам";
		КонецЕсли;

		_Лог.Предупреждение("Не найдено ни одного файла с бенчмарками для запуска");
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьВременныеФайлы()
	_ПодготовительФайлаБенчмарка.Очистить();
КонецПроцедуры

Функция ПодключитьБенчмаркиИзФайлов(Файлы)

	ПодключенныеТипы = Новый Массив();

	Для Каждого ИмяФайла Из Файлы Цикл
		Тип = Бенчмаркинг.ПодключитьБенчмарк(ИмяФайла);
		Если Не Тип = Неопределено Тогда
			ПодключенныеТипы.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;

	Возврат ПодключенныеТипы;

КонецФункции

Функция НайтиГруппыФайловБенчмарков()

	ГруппыФайлов = Новый Массив();
	ГруппаОбычныхАлгоритмов = Неопределено;
	РазрешательВходныхФайлов = Новый РазрешательВходныхФайловБенчмарков();
	РазрешенныеВходы = РазрешательВходныхФайлов.Разрешить(_МассивФайлов, _Рекурсивно);

	Для Каждого РазрешенныйВход Из РазрешенныеВходы Цикл

		Если Не РазрешенныйВход.Разрешен Тогда
			ВызватьИсключение СтрШаблон("Файл <%1> не существует", РазрешенныйВход.ИсходныйПуть);
		КонецЕсли;

		Если РазрешенныйВход.ВходнойКаталог <> Неопределено Тогда
			Для Каждого ПолноеИмяФайла Из РазрешенныйВход.Файлы Цикл
				ГруппыФайлов.Добавить(НоваяГруппаФайловБенчмарков(МассивФайлов(ПолноеИмяФайла), Ложь));
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		Для Каждого ПолноеИмяФайла Из РазрешенныйВход.Файлы Цикл

			Если _ПодготовительФайлаБенчмарка.СодержитБенчмарки(ПолноеИмяФайла) Тогда
				ГруппыФайлов.Добавить(НоваяГруппаФайловБенчмарков(МассивФайлов(ПолноеИмяФайла), Ложь));
				Продолжить;
			КонецЕсли;

			Если ГруппаОбычныхАлгоритмов = Неопределено Тогда
				ГруппаОбычныхАлгоритмов = НоваяГруппаФайловБенчмарков(Новый Массив(), Истина);
				ГруппыФайлов.Добавить(ГруппаОбычныхАлгоритмов);
			КонецЕсли;

			ГруппаОбычныхАлгоритмов.Файлы.Добавить(_ПодготовительФайлаБенчмарка.Подготовить(ПолноеИмяФайла));

		КонецЦикла;

	КонецЦикла;

	Возврат ГруппыФайлов;

КонецФункции

Функция НоваяГруппаФайловБенчмарков(Файлы, ОбъединятьРезультаты)
	Возврат Новый Структура("Файлы, ОбъединятьРезультаты", Файлы, ОбъединятьРезультаты);
КонецФункции

Функция МассивФайлов(ИмяФайла)
	Файлы = Новый Массив();
	Файлы.Добавить(ИмяФайла);
	Возврат Файлы;
КонецФункции

Функция ЗапуститьБенчмарк(Тип)

	ПараметрыЗапуска = СоздатьПараметрыЗапуска(Тип);
	Если ПараметрыЗапуска = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Выполнение = СоздатьВыполнениеБенчмарков(
		ПараметрыЗапуска.ИсточникБенчмарков,
		ПараметрыЗапуска.Конфигурация
	);

	Возврат Выполнение.Запустить();

КонецФункции

Функция СоздатьПараметрыЗапуска(Тип)

	ОбъединеннаяКонфигурация = Новый КонфигурацияБенчмарков(Тип);

	Если _Настройки <> Неопределено И _Настройки.Конфигурация <> Неопределено Тогда
		ОбъединеннаяКонфигурация.Объединить(_Настройки.Конфигурация);
	КонецЕсли;

	Если _ПереопределенияКонфигурации <> Неопределено Тогда
		ОбъединеннаяКонфигурация.ПрименитьПереопределения(_ПереопределенияКонфигурации);
	КонецЕсли;

	Если Не _Настройки = Неопределено И _Настройки.ДескрипторыБенчмарков.Количество() > 0 Тогда
		ИсточникБенчмарков = _Настройки.ДескрипторыБенчмарков;
	Иначе
		ИсточникБенчмарков = Тип;
	КонецЕсли;

	ИсточникБенчмарков = _ФильтрБенчмарков.Отфильтровать(ИсточникБенчмарков);
	Если ТипЗнч(ИсточникБенчмарков) = Тип("КоллекцияДескрипторовБенчмарков")
		И ИсточникБенчмарков.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"ИсточникБенчмарков, Конфигурация",
		ИсточникБенчмарков,
		ОбъединеннаяКонфигурация
	);

КонецФункции

Функция СоздатьВыполнениеБенчмарков(ИсточникБенчмарков, Конфигурация)

	Выполнение = Новый ВыполнениеБенчмарков(ИсточникБенчмарков, Конфигурация);
	Выполнение.УстановитьДиспетчерСобытий(_ДиспетчерСобытий);

	Если _ПортОтладки > 0 Тогда
		Выполнение.УстановитьПортОтладки(_ПортОтладки);
	КонецЕсли;

	Возврат Выполнение;

КонецФункции

Функция ЗапуститьБенчмаркиСОбъединениемРезультатов(Типы)

	ВыполненияБенчмарков = Новый Массив();
	ДескрипторыБенчмарков = Новый КоллекцияДескрипторовБенчмарков();
	Конфигурация = Неопределено;

	Для Каждого Тип Из Типы Цикл

		ПараметрыЗапуска = СоздатьПараметрыЗапуска(Тип);
		Если ПараметрыЗапуска = Неопределено Тогда
			Продолжить;
		КонецЕсли;
	
		ВыполненияБенчмарков.Добавить(СоздатьВыполнениеБенчмарков(
			ПараметрыЗапуска.ИсточникБенчмарков,
			ПараметрыЗапуска.Конфигурация
		));

		Если Конфигурация = Неопределено Тогда
			Конфигурация = ПараметрыЗапуска.Конфигурация;
		КонецЕсли;

		АдаптерИсточникаБенчмарков = Новый АдаптерИсточникаБенчмарков(ПараметрыЗапуска.ИсточникБенчмарков);
		Для Каждого ДескрипторБенчмарка Из АдаптерИсточникаБенчмарков.ПолучитьКоллекциюДескрипторов().ВМассив() Цикл
			ДескрипторыБенчмарков.Добавить(ДескрипторБенчмарка);
		КонецЦикла;

	КонецЦикла;

	Если ВыполненияБенчмарков.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	_ДиспетчерСобытий.Опубликовать(
		ФабрикаСобытийВыполненияБенчмарков.СоздатьНачалоЗапуска(Конфигурация, ДескрипторыБенчмарков)
	);

	РезультатыЗапуска = Новый Массив();
	Для Каждого ВыполнениеБенчмарков Из ВыполненияБенчмарков Цикл
		РезультатыЗапуска.Добавить(ВыполнениеБенчмарков.ЗапуститьДляОбъединения());
	КонецЦикла;

	ОбъединенныйРезультат = ОбъединитьРезультатыЗапускаАлгоритмов(РезультатыЗапуска);

	_ДиспетчерСобытий.Опубликовать(
		ФабрикаСобытийВыполненияБенчмарков.СоздатьЗавершениеЗапуска(ОбъединенныйРезультат)
	);

	ЭкспортерРезультатов = Новый ЭкспортерРезультатовБенчмарков();
	Файлы = ЭкспортерРезультатов.Записать(ОбъединенныйРезультат);

	Если Файлы.Количество() > 0 Тогда
		_ДиспетчерСобытий.Опубликовать(ФабрикаСобытийВыполненияБенчмарков.СоздатьАртефакты(Файлы));
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ОбъединитьРезультатыЗапускаАлгоритмов(РезультатыЗапуска)

	ОбъединенныйРезультат = РезультатыЗапуска[0];

	Для ИндексРезультата = 1 По РезультатыЗапуска.ВГраница() Цикл

		РезультатЗапуска = РезультатыЗапуска[ИндексРезультата];
		ДобавитьДескрипторыБенчмарков(ОбъединенныйРезультат, РезультатЗапуска);
		ДобавитьЗапускиКейсов(ОбъединенныйРезультат, РезультатЗапуска);
		ОбъединитьСредыОкружения(ОбъединенныйРезультат, РезультатЗапуска);

	КонецЦикла;

	ОбъединенныйРезультат.Чекпоинт = Неопределено;
	ОбъединенныйРезультат.СформироватьОтчет();

	Возврат ОбъединенныйРезультат;

КонецФункции

Процедура ДобавитьДескрипторыБенчмарков(ОбъединенныйРезультат, РезультатЗапуска)

	Для Каждого ДескрипторБенчмарка Из РезультатЗапуска.ДескрипторыБенчмарков.ВМассив() Цикл
		ОбъединенныйРезультат.ДескрипторыБенчмарков.Добавить(ДескрипторБенчмарка);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗапускиКейсов(ОбъединенныйРезультат, РезультатЗапуска)

	Для Каждого РезультатЗапускаКейса Из РезультатЗапуска.Запуски Цикл
		ОбъединенныйРезультат.Запуски.Добавить(РезультатЗапускаКейса);
	КонецЦикла;

КонецПроцедуры

Процедура ОбъединитьСредыОкружения(ОбъединенныйРезультат, РезультатЗапуска)

	Если ОбъединенныйРезультат.СредаОкружения.ВерсияИсполняющейСреды
		<> РезультатЗапуска.СредаОкружения.ВерсияИсполняющейСреды Тогда
		ОбъединенныйРезультат.СредаОкружения.ВерсияИсполняющейСреды = "";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
