#Использовать asserts
#Использовать validate
#Использовать fluent

&Сериализуемое("Strategy")
&Тип("Строка")
&Геттер("Стратегия")
Перем _Стратегия; // см. СтратегииЗапускаБенчмарка

&Сериализуемое("IterationCount")
&Тип("Число")
&Геттер("КоличествоИтераций")
Перем _КоличествоИтераций; // Число

&Сериализуемое("AdaptiveIterations")
&Тип("Булево")
&Геттер("АдаптивныеИтерацииВключены")
Перем _АдаптивныеИтерацииВключены; // Булево

&Сериализуемое("MaxRelativeError")
&Тип("Число")
&Геттер("ЦелеваяОтносительнаяПогрешность")
Перем _МаксимальнаяОтносительнаяПогрешность; // Число

&Сериализуемое("MinAdaptiveIterationCount")
&Тип("Число")
&Геттер("МинимальноеКоличествоАдаптивныхИтераций")
Перем _МинимальноеКоличествоАдаптивныхИтераций; // Число

&Сериализуемое("MaxAdaptiveIterationCount")
&Тип("Число")
&Геттер("МаксимальноеКоличествоАдаптивныхИтераций")
Перем _МаксимальноеКоличествоАдаптивныхИтераций; // Число

&Сериализуемое("StatisticalComparison")
&Тип("Булево")
&Геттер("СтатистическоеСравнениеСЭталономВключено")
Перем _СтатистическоеСравнениеВключено; // Булево

&Сериализуемое("StatisticalComparisonRelativeThreshold")
&Тип("Число")
&Геттер("ОтносительныйПорогПрактическойЗначимости")
Перем _ОтносительныйПорогПрактическойЗначимости; // Число

&Сериализуемое("StatisticalComparisonSignificanceLevel")
&Тип("Число")
&Геттер("УровеньЗначимостиСтатистическогоСравнения")
Перем _УровеньЗначимостиСтатистическогоСравнения; // Число

&Сериализуемое("InvocationCount")
&Тип("Число")
&Геттер("КоличествоВызововЗаИтерацию")
Перем _КоличествоВызововЗаИтерацию; // Число

&Сериализуемое("WarmupCount")
&Тип("Число")
&Геттер("КоличествоПрогревочныхИтераций")
Перем _КоличествоПрогревочныхИтераций; // Число

&Сериализуемое("MinIterationTime")
&Тип("Число")
&Геттер("МинимальноеВремяИтерации")
Перем _МинимальноеВремяИтерации; // Число - мс

&Сериализуемое("MinInvocationCount")
&Тип("Число")
&Геттер("МинимальноеКоличествоВызововЗаИтерацию")
Перем _МинимальноеКоличествоВызововЗаИтерацию; // Число

&Сериализуемое("ReportSorting")
&Тип("Строка")
&Геттер("СортировкаОтчета")
Перем _СортировкаОтчета; // см. СортировкиОтчетаБенчмарков

&Сериализуемое("Memory")
&Тип("Булево")
&Геттер("ТребуетсяМониторингПамяти")
Перем _ТребуетсяМониторингПамяти; // Булево

&Сериализуемое("ArtifactsDirectory")
&Тип("Строка")
&Геттер("КаталогАртефактов")
Перем _КаталогАртефактов; // Строка

&Сериализуемое("Parameters")
&Тип("Массив") &ДляКаждого &Тип("ПараметрБенчмарка")
&Геттер("Параметры")
Перем _Параметры; // Массив из ПараметрБенчмарка

&Сериализуемое("ParameterSources")
&СериализуемыйКлюч("ИмяПоля", "FieldName")
&СериализуемыйКлюч("Источник", "Source")
&Тип("ТаблицаЗначений")
&Геттер("ИсточникиПараметров")
Перем _ИсточникиПараметров; // ТаблицаЗначений

&Сериализуемое("Handlers")
&Тип("Массив") &ДляКаждого &Тип("ОбработчикСобытияБенчмарка")
&Геттер("ОбработчикиСобытий")
Перем _Обработчики; // Массив из ОбработчикСобытияБенчмарка

&Сериализуемое("Columns")
&Тип("Массив")
&Геттер("Колонки")
Перем _Колонки; // Массив из Строка - см. КолонкиОтчетаБенчмарков

&Несериализуемое
&Геттер("Экспортеры")
Перем _Экспортеры; // Массив из Произвольный - см. ЭкспортерыРезультатовБенчмарков

&Сериализуемое("RuntimeVersions")
&Тип("Массив") &ДляКаждого &Тип("ИсполняющаяСредаБенчмарков")
&Геттер("ИсполняющиеСреды")
Перем _ИсполняющиеСреды; // Массив из ИсполняющаяСредаБенчмарков

&Несериализуемое
Перем _ЗначенияПолейПоУмолчанию; // Соответствие

&Несериализуемое
Перем _МодифицированныеПоля; // Соответствие

&Несериализуемое
Перем _ОписанияПолей; // ТаблицаЗначений, Неопределено

&Несериализуемое
Перем _Рефлектор; // Рефлектор

#Область ОбработчикиСобытий

// Конфигурация бенчмарков
//
// Параметры:
//   Тип - Тип - Тип класса бенчмарков
Процедура ПриСозданииОбъекта(Тип = Неопределено)

	СтратегияПоУмолчанию = СтратегииЗапускаБенчмарка.ПропускнаяСпособность;
	КоличествоИтерацийПоУмолчанию = 15;
	МаксимальнаяОтносительнаяПогрешностьПоУмолчанию = 0.1;
	МинимальноеКоличествоАдаптивныхИтерацийПоУмолчанию = 15;
	МаксимальноеКоличествоАдаптивныхИтерацийПоУмолчанию = 100;
	ОтносительныйПорогПрактическойЗначимостиПоУмолчанию = 0.15;
	УровеньЗначимостиСтатистическогоСравненияПоУмолчанию = 0.0005;
	КоличествоВызововЗаИтерациюПоУмолчанию = 0;
	КоличествоПрогревочныхИтерацийПоУмолчанию = 6;
	МинимальноеВремяИтерацииПоУмолчанию = 100;
	МинимальноеКоличествоВызововЗаИтерациюПоУмолчанию = 4;
	СортировкаОтчетаПоУмолчанию = СортировкиОтчетаБенчмарков.ПоУмолчанию;
	КаталогАртефактовПоУмолчанию = ".\BenchmarkArtifacts";
	
	_Параметры = Новый Массив();
	_ИсточникиПараметров = ПустаяТаблицаИсточникиПараметров();
	_Обработчики = Новый Массив();
	_Колонки = Новый Массив();
	_Экспортеры = Новый Массив();
	_ИсполняющиеСреды = Новый Массив();
	_МодифицированныеПоля = Новый Соответствие();
	_Рефлектор = Новый Рефлектор();

	УдалитьМониторингПамяти();
	УстановитьСтратегию(СтратегияПоУмолчанию);
	УстановитьКоличествоИтераций(КоличествоИтерацийПоУмолчанию);
	УстановитьКоличествоВызововЗаИтерацию(КоличествоВызововЗаИтерациюПоУмолчанию);
	УстановитьКоличествоПрогревочныхИтераций(КоличествоПрогревочныхИтерацийПоУмолчанию);
	УстановитьМинимальноеВремяИтерации(МинимальноеВремяИтерацииПоУмолчанию);
	УстановитьМинимальноеКоличествоВызововЗаИтерацию(МинимальноеКоличествоВызововЗаИтерациюПоУмолчанию);
	УстановитьСортировкуОтчета(СортировкаОтчетаПоУмолчанию);
	УстановитьКаталогАртефактов(КаталогАртефактовПоУмолчанию);
	УстановитьЦелевуюОтносительнуюПогрешность(МаксимальнаяОтносительнаяПогрешностьПоУмолчанию);
	УстановитьМаксимальноеКоличествоАдаптивныхИтераций(МаксимальноеКоличествоАдаптивныхИтерацийПоУмолчанию);
	УстановитьМинимальноеКоличествоАдаптивныхИтераций(МинимальноеКоличествоАдаптивныхИтерацийПоУмолчанию);
	УстановитьОтносительныйПорогПрактическойЗначимости(ОтносительныйПорогПрактическойЗначимостиПоУмолчанию);
	УстановитьУровеньЗначимостиСтатистическогоСравнения(УровеньЗначимостиСтатистическогоСравненияПоУмолчанию);
	ОтключитьАдаптивныеИтерации();
	ОтключитьСтатистическоеСравнениеСЭталоном();

	_МодифицированныеПоля.Очистить();
	ЗапомнитьЗначенияПолейПоУмолчанию();

	Если Не Тип = Неопределено Тогда
		Извлекатель = Новый ИзвлекательКонфигурацииБенчмарков(Тип);
		Извлекатель.Извлечь(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Значение, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

	Подстроки = Новый Массив();
	Подстроки.Добавить(СтрШаблон("Стратегия = ""%1""", Стратегия()));
	Подстроки.Добавить("Измерительных итераций = "  + КоличествоИтераций());

	Если Стратегия() = СтратегииЗапускаБенчмарка.ПропускнаяСпособность Тогда
			
		Подстроки.Добавить(Символы.ПС);
		Подстроки.Добавить("Прогревочных итераций = " + КоличествоПрогревочныхИтераций());	
		
		Если КоличествоВызововЗаИтерацию() = 0 Тогда
			Подстроки.Добавить(СтрШаблон("Мин. время итерации = %1 мс", МинимальноеВремяИтерации()));
			Подстроки.Добавить("Мин. вызовов за итерацию = " + МинимальноеКоличествоВызововЗаИтерацию());
		Иначе
			Подстроки.Добавить("Вызовов за итерацию = " + КоличествоВызововЗаИтерацию());
		КонецЕсли;

	КонецЕсли;

	Экспортеры = Экспортеры();
	Если Экспортеры.Количество() > 0 Тогда

		Расширения = Новый Массив();
		Для Каждого Экспортер Из Экспортеры Цикл
			Расширения.Добавить(Экспортер.Расширение());
		КонецЦикла;

		Подстроки.Добавить(Символы.ПС);
		Подстроки.Добавить("Форматы экспорта = " + СтрСоединить(Расширения, ", "));
		Подстроки.Добавить("Каталог артефактов = " + КаталогАртефактов());

	КонецЕсли;

	Значение = СтрЗаменить(СтрСоединить(Подстроки, ", "), ", " + Символы.ПС + ", ", Символы.ПС);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область СвойстваКонфигурации

// Устанавливает количество итераций для основных этапов (ЭтапыБенчмарка.Измерение, ЭтапыБенчмарка.Память)
//
// Используется для тонкой настройки баланса между точностью измерений и временем выполнения теста.
// Увеличение итераций повышает стабильность результатов, но увеличивает общее время прогона.
//
// Параметры:
//   КоличествоИтераций - Число
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьКоличествоИтераций(КоличествоИтераций) Экспорт

	Ожидаем.Что(КоличествоИтераций, "Количество итераций").ИмеетТип("Число");
	Ожидаем.Что(КоличествоИтераций, "Количество итераций не может быть меньше 1").Больше(0);

	_КоличествоИтераций = КоличествоИтераций;
	УстановитьМодифицированность(ИмяПоля_КоличествоИтераций());

	Возврат ЭтотОбъект;

КонецФункции

// Количество итераций для основных этапов (ЭтапыБенчмарка.Измерение, ЭтапыБенчмарка.Память)
//
// Возвращаемое значение:
//   Число
Функция КоличествоИтераций() Экспорт

	Возврат _КоличествоИтераций;
	
КонецФункции

// Устанавливает целевую относительную погрешность адаптивного завершения измерений.
//
// Параметры:
//   ЦелеваяОтносительнаяПогрешность - Число - Допустимая погрешность, например 0.1 для 10%.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьЦелевуюОтносительнуюПогрешность(ЦелеваяОтносительнаяПогрешность) Экспорт

	Ожидаем.Что(ЦелеваяОтносительнаяПогрешность, "Целевая относительная погрешность").ИмеетТип("Число");
	Ожидаем.Что(ЦелеваяОтносительнаяПогрешность, "Целевая относительная погрешность должна быть больше 0").Больше(0);

	_МаксимальнаяОтносительнаяПогрешность = ЦелеваяОтносительнаяПогрешность;

	УстановитьМодифицированность(ИмяПоля_МаксимальнаяОтносительнаяПогрешность());

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает минимальное число измерений для адаптивного завершения.
//
// Параметры:
//   МинимальноеКоличествоИтераций - Число - Не менее двух измерений.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьМинимальноеКоличествоАдаптивныхИтераций(МинимальноеКоличествоИтераций) Экспорт

	Ожидаем.Что(МинимальноеКоличествоИтераций, "Минимальное количество итераций").ИмеетТип("Число");
	Ожидаем.Что(МинимальноеКоличествоИтераций, "Минимальное количество итераций не может быть меньше 2").БольшеИлиРавно(2);
	Ожидаем.Что(МинимальноеКоличествоИтераций = Цел(МинимальноеКоличествоИтераций), "Минимальное количество итераций должно быть целым").ЭтоИстина();

	_МинимальноеКоличествоАдаптивныхИтераций = МинимальноеКоличествоИтераций;

	УстановитьМодифицированность(ИмяПоля_МинимальноеКоличествоАдаптивныхИтераций());

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает максимальное число измерений для адаптивного завершения.
//
// Параметры:
//   МаксимальноеКоличествоИтераций - Число - Жесткая граница длительности прогона.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьМаксимальноеКоличествоАдаптивныхИтераций(МаксимальноеКоличествоИтераций) Экспорт

	Ожидаем.Что(МаксимальноеКоличествоИтераций, "Максимальное количество итераций").ИмеетТип("Число");
	Ожидаем.Что(МаксимальноеКоличествоИтераций, "Максимальное количество итераций не может быть меньше 2").БольшеИлиРавно(2);
	Ожидаем.Что(МаксимальноеКоличествоИтераций = Цел(МаксимальноеКоличествоИтераций), "Максимальное количество итераций должно быть целым").ЭтоИстина();

	_МаксимальноеКоличествоАдаптивныхИтераций = МаксимальноеКоличествоИтераций;

	УстановитьМодифицированность(ИмяПоля_МаксимальноеКоличествоАдаптивныхИтераций());

	Возврат ЭтотОбъект;

КонецФункции

// Включает адаптивное завершение измерений.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция ВключитьАдаптивныеИтерации() Экспорт

	_АдаптивныеИтерацииВключены = Истина;
	УстановитьМодифицированность(ИмяПоля_АдаптивныеИтерацииВключены());

	Возврат ЭтотОбъект;

КонецФункции

// Отключает адаптивное завершение измерений.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция ОтключитьАдаптивныеИтерации() Экспорт

	_АдаптивныеИтерацииВключены = Ложь;
	УстановитьМодифицированность(ИмяПоля_АдаптивныеИтерацииВключены());

	Возврат ЭтотОбъект;

КонецФункции

// Признак включения адаптивного завершения измерений.
//
// Возвращаемое значение:
//   Булево
Функция АдаптивныеИтерацииВключены() Экспорт

	Возврат _АдаптивныеИтерацииВключены;

КонецФункции

// Целевая относительная погрешность адаптивного измерения.
//
// Возвращаемое значение:
//   Число
Функция ЦелеваяОтносительнаяПогрешность() Экспорт

	Возврат _МаксимальнаяОтносительнаяПогрешность;

КонецФункции

// Минимальное число измерений перед проверкой погрешности.
//
// Возвращаемое значение:
//   Число
Функция МинимальноеКоличествоАдаптивныхИтераций() Экспорт

	Возврат _МинимальноеКоличествоАдаптивныхИтераций;

КонецФункции

// Максимальное число измерений при адаптивном запуске.
//
// Возвращаемое значение:
//   Число
Функция МаксимальноеКоличествоАдаптивныхИтераций() Экспорт

	Возврат _МаксимальноеКоличествоАдаптивныхИтераций;

КонецФункции

// Устанавливает относительный порог практической значимости статистического сравнения с эталоном.
//
// Параметры:
//   ОтносительныйПорогПрактическойЗначимости - Число - Минимальное относительное различие средних.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьОтносительныйПорогПрактическойЗначимости(ОтносительныйПорогПрактическойЗначимости) Экспорт

	Ожидаем.Что(ОтносительныйПорогПрактическойЗначимости, "Относительный порог практической значимости").ИмеетТип("Число");
	Ожидаем.Что(ОтносительныйПорогПрактическойЗначимости, "Относительный порог практической значимости не может быть меньше 0").БольшеИлиРавно(0);
	Ожидаем.Что(ОтносительныйПорогПрактическойЗначимости, "Относительный порог практической значимости должен быть меньше 1").Меньше(1);

	_ОтносительныйПорогПрактическойЗначимости = ОтносительныйПорогПрактическойЗначимости;

	УстановитьМодифицированность(ИмяПоля_ОтносительныйПорогПрактическойЗначимости());

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает уровень значимости критерия Манна - Уитни.
//
// Параметры:
//   УровеньЗначимости - Число - Допустимая вероятность ошибки первого рода.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьУровеньЗначимостиСтатистическогоСравнения(УровеньЗначимости) Экспорт

	Ожидаем.Что(УровеньЗначимости, "Уровень значимости").ИмеетТип("Число");
	Ожидаем.Что(УровеньЗначимости, "Уровень значимости должен быть больше 0").Больше(0);
	Ожидаем.Что(УровеньЗначимости, "Уровень значимости должен быть меньше 1").Меньше(1);

	_УровеньЗначимостиСтатистическогоСравнения = УровеньЗначимости;

	УстановитьМодифицированность(ИмяПоля_УровеньЗначимостиСтатистическогоСравнения());

	Возврат ЭтотОбъект;

КонецФункции

