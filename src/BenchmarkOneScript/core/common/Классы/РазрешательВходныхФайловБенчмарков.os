#Использовать fs
#Использовать collectionos

#Область ПрограммныйИнтерфейс

// Разрешает входные пути к файлам и каталогам бенчмарков.
// Файлы каждого каталога возвращаются в порядке нормализованных полных путей.
// Один и тот же файл включается только для первого содержащего его входа.
//
// Параметры:
//   МассивВходныхПутей - Массив из Строка - Пути к файлам и каталогам бенчмарков
//   Рекурсивно         - Булево           - Искать *.os во вложенных каталогах
//
// Возвращаемое значение:
//   Массив из Структура - Результаты разрешения входов с полями:
//     ИсходныйПуть    - Строка            - Переданный входной путь
//     Разрешен        - Булево            - Признак существующего файла или каталога
//     ВходнойКаталог  - Строка, Неопределено - Нормализованный путь входного каталога
//     Файлы           - Массив из Строка  - Уникальные нормализованные полные пути к *.os
Функция Разрешить(МассивВходныхПутей, Рекурсивно = Ложь) Экспорт

	Результат = Новый Массив();
	ДобавленныеФайлы = Новый Соответствие();

	Для Каждого ВходнойПуть Из МассивВходныхПутей Цикл

		Если ФС.КаталогСуществует(ВходнойПуть) Тогда
			Результат.Добавить(РазрешитьКаталог(ВходнойПуть, Рекурсивно, ДобавленныеФайлы));
		Иначе
			Результат.Добавить(РазрешитьФайл(ВходнойПуть, ДобавленныеФайлы));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьКаталог(ВходнойПуть, Рекурсивно, ДобавленныеФайлы)

	ВходнойКаталог = ФС.НормализоватьПуть(ВходнойПуть);
	НайденныеФайлы = НайтиФайлы(ВходнойКаталог, "*.os", Рекурсивно);
	ПолныеИменаФайлов = ОтсортированныеПолныеИменаФайлов(НайденныеФайлы);
	Файлы = УникальныеФайлы(ПолныеИменаФайлов, ДобавленныеФайлы);

	Возврат НовыйРезультатРазрешения(ВходнойПуть, Истина, ВходнойКаталог, Файлы);

КонецФункции

Функция РазрешитьФайл(ВходнойПуть, ДобавленныеФайлы)

	ПолноеИмяФайла = РаботаСПутямиФайловойСистемы.НайтиПолноеИмяФайлаСценария(ВходнойПуть);
	Если ПолноеИмяФайла = Неопределено Тогда
		Возврат НовыйРезультатРазрешения(
			ВходнойПуть,
			Ложь,
			Неопределено,
			Новый Массив()
		);
	КонецЕсли;

	ПолныеИменаФайлов = Новый Массив();
	ПолныеИменаФайлов.Добавить(ПолноеИмяФайла);
	Файлы = УникальныеФайлы(ПолныеИменаФайлов, ДобавленныеФайлы);

	Возврат НовыйРезультатРазрешения(ВходнойПуть, Истина, Неопределено, Файлы);

КонецФункции

Функция ОтсортированныеПолныеИменаФайлов(НайденныеФайлы)

	ПолныеИменаФайлов = Новый Массив();
	Для Каждого Файл Из НайденныеФайлы Цикл
		ПолныеИменаФайлов.Добавить(ФС.НормализоватьПуть(Файл.ПолноеИмя));
	КонецЦикла;

	Массивы.Сортировать(ПолныеИменаФайлов, СравнениеЗначений.ПрямойПорядок());

	Возврат ПолныеИменаФайлов;

КонецФункции

Функция УникальныеФайлы(ПолныеИменаФайлов, ДобавленныеФайлы)

	Результат = Новый Массив();

	Для Каждого ПолноеИмяФайла Из ПолныеИменаФайлов Цикл

		КлючФайла = КлючДедупликацииФайла(ПолноеИмяФайла);
		Если ДобавленныеФайлы.Получить(КлючФайла) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДобавленныеФайлы.Вставить(КлючФайла, Истина);
		Результат.Добавить(ПолноеИмяФайла);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НовыйРезультатРазрешения(ИсходныйПуть, Разрешен, ВходнойКаталог, Файлы)

	Возврат Новый Структура(
		"ИсходныйПуть, Разрешен, ВходнойКаталог, Файлы",
		ИсходныйПуть,
		Разрешен,
		ВходнойКаталог,
		Файлы
	);

КонецФункции

Функция КлючДедупликацииФайла(ПутьКФайлу)

	Если ЭтоWindows() Тогда
		Возврат НРег(ПутьКФайлу);
	КонецЕсли;

	Возврат ПутьКФайлу;

КонецФункции

Функция ЭтоWindows()

	ТекущаяПлатформа = Новый СистемнаяИнформация().ТипПлатформы;

	Возврат ТекущаяПлатформа = ТипПлатформы.Windows_x86_64
		Или ТекущаяПлатформа = ТипПлатформы.Windows_x86;

КонецФункции

#КонецОбласти
