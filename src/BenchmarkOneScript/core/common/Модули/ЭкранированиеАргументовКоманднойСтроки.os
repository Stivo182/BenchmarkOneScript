#Область ПрограммныйИнтерфейс

// Оборачивает путь к исполняемому файлу в двойные кавычки.
//
// Параметры:
//   Строка - Строка - Путь к исполняемому файлу
//
// Возвращаемое значение:
//   Строка
Функция ОбернутьИсполняемыйФайлВКавычки(Строка) Экспорт

	Кавычка = """";
	Возврат Кавычка + Строка + Кавычка;

КонецФункции

// Экранирует аргумент командной строки и оборачивает его в кавычки текущей платформы.
//
// Параметры:
//   Строка - Строка - Аргумент командной строки
//
// Возвращаемое значение:
//   Строка
Функция ОбернутьАргументКоманднойСтрокиВКавычки(Строка) Экспорт

	Если ЭтоWindows() Тогда
		Возврат ОбернутьВКавычкиДляWindows(Строка);
	КонецЕсли;

	Возврат ОбернутьВКавычкиДляUnix(Строка);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбернутьВКавычкиДляWindows(Строка)

	Кавычка = """";
	Результат = Кавычка;
	КоличествоОбратныхКосыхЧерт = 0;

	Для Индекс = 1 По СтрДлина(Строка) Цикл

		ТекущийСимвол = Сред(Строка, Индекс, 1);
		Если ТекущийСимвол = "\" Тогда
			КоличествоОбратныхКосыхЧерт = КоличествоОбратныхКосыхЧерт + 1;
		ИначеЕсли ТекущийСимвол = Кавычка Тогда
			Результат = Результат
				+ ОбратныеКосыеЧерты(КоличествоОбратныхКосыхЧерт * 2 + 1)
				+ Кавычка;
			КоличествоОбратныхКосыхЧерт = 0;
		Иначе
			Результат = Результат
				+ ОбратныеКосыеЧерты(КоличествоОбратныхКосыхЧерт)
				+ ТекущийСимвол;
			КоличествоОбратныхКосыхЧерт = 0;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат
		+ ОбратныеКосыеЧерты(КоличествоОбратныхКосыхЧерт * 2)
		+ Кавычка;

КонецФункции

Функция ОбернутьВКавычкиДляUnix(Строка)

	ОдинарнаяКавычка = "'";
	ДвойнаяКавычка = """";
	ЭкранированнаяОдинарнаяКавычка = ОдинарнаяКавычка
		+ ДвойнаяКавычка
		+ ОдинарнаяКавычка
		+ ДвойнаяКавычка
		+ ОдинарнаяКавычка;

	Возврат ОдинарнаяКавычка
		+ СтрЗаменить(Строка, ОдинарнаяКавычка, ЭкранированнаяОдинарнаяКавычка)
		+ ОдинарнаяКавычка;

КонецФункции

Функция ОбратныеКосыеЧерты(Количество)

	Результат = "";
	Для Индекс = 1 По Количество Цикл
		Результат = Результат + "\";
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоWindows()

	ТекущаяПлатформа = Новый СистемнаяИнформация().ТипПлатформы;

	Возврат ТекущаяПлатформа = ТипПлатформы.Windows_x86_64
		Или ТекущаяПлатформа = ТипПлатформы.Windows_x86;

КонецФункции

#КонецОбласти
