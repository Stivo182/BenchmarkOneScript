КонецФункции

// Возвращает идентификатор метрики указанного процентиля.
//
// Параметры:
//   Значение - Число - Процентиль.
//
// Возвращаемое значение:
//   Строка
Функция Процентиль(Значение) Экспорт

	Возврат КолонкаОтчетаБенчмарковПроцентиль.ИмяКолонки(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет, является ли строка идентификатором поддерживаемой числовой метрики.
//
// Параметры:
//   Метрика - Строка - Проверяемый идентификатор.
//
// Возвращаемое значение:
//   Булево
Функция Поддерживается(Метрика) Экспорт

	Возврат Метрика = Минимум()
		Или Метрика = Среднее()
		Или Метрика = Медиана()
		Или Метрика = Максимум()
		Или Метрика = НижнийКвартиль()
		Или Метрика = ВерхнийКвартиль()
		Или Метрика = СтандартноеОтклонение()
		Или Метрика = СтандартнаяОшибка()
		Или Метрика = ОперацийВСекунду()
		Или Метрика = ВыделяемаяПамять()
		Или Метрика = КоэффициентПроизводительности()
		Или Метрика = RatioSD()
		Или ЭтоИдентификаторПроцентиля(Метрика);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоИдентификаторПроцентиля(Метрика)

	Префикс = "Процентиль_";

	Если Не СтрНачинаетсяС(Метрика, Префикс) Тогда
		Возврат Ложь;
	КонецЕсли;

	Значение = Сред(Метрика, СтрДлина(Префикс) + 1);
	Процентиль = КолонкаОтчетаБенчмарковПроцентиль.СтрокаВЧисло(Значение);

	Возврат Процентиль >= 0 И Процентиль <= 100
		И Метрика = КолонкаОтчетаБенчмарковПроцентиль.ИмяКолонки(Процентиль);

КонецФункции

#КонецОбласти
