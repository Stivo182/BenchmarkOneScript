Перем _ИмяМетрики; // Строка
Перем _ЕдиницаИзмерения; // Строка, ЕдиницаИзмеренияБенчмарка, Неопределено
Перем _Значения; // Массив из Структура:
                 //   * Значение - Число - Значение метрики.
                 //   * ПредставлениеКейса - Строка - Представление кейса.

#Область ОбработчикиСобытий

// Создает проверку набора значений метрики.
//
// Параметры:
//   ИмяМетрики - Строка - Имя метрики.
//   ЕдиницаИзмерения - Строка, ЕдиницаИзмеренияБенчмарка - Единица измерения
//   Значения - Массив из Структура:
//     * Значение - Число - Значение метрики.
//     * ПредставлениеКейса - Строка - Представление кейса.
Процедура ПриСозданииОбъекта(ИмяМетрики, ЕдиницаИзмерения, Значения)
	_ИмяМетрики = ИмяМетрики;
	_ЕдиницаИзмерения = ЕдиницаИзмерения;
	_Значения = Значения;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет равенство фактического значения ожидаемому.
//
// Параметры:
//   Значение - Число - ожидаемое значение.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Равно(Значение) Экспорт
	ПроверитьЧисло(Значение);
	Возврат Проверить(Значение, "Равно", "=", Значение);
КонецФункции

// Проверяет, что фактическое значение меньше ожидаемого.
//
// Параметры:
//   Значение - Число - верхняя граница.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Меньше(Значение) Экспорт
	ПроверитьЧисло(Значение);
	Возврат Проверить(Значение, "Меньше", "<", Значение);
КонецФункции

// Проверяет, что фактическое значение больше ожидаемого.
//
// Параметры:
//   Значение - Число - нижняя граница.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Больше(Значение) Экспорт
	ПроверитьЧисло(Значение);
	Возврат Проверить(Значение, "Больше", ">", Значение);
КонецФункции

// Проверяет попадание в закрытый диапазон.
//
// Параметры:
//   Минимум - Число - нижняя граница.
//   Максимум - Число - верхняя граница.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Между(Минимум, Максимум) Экспорт

	ПроверитьДваЧисла(Минимум, Максимум);

	Если Минимум > Максимум Тогда
		ВызватьИсключение "Минимум диапазона не может быть больше максимума";
	КонецЕсли;

	Возврат Проверить(СтрШаблон("[%1, %2]", Минимум, Максимум), "Между", "между", Минимум, Максимум);

КонецФункции

// Проверяет абсолютное отклонение от значения.
//
// Параметры:
//   Значение - Число - ожидаемое значение.
//   Допуск - Число - допустимое отклонение.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Около(Значение, Допуск) Экспорт

	ПроверитьДваЧисла(Значение, Допуск);

	Если Допуск < 0 Тогда
		ВызватьИсключение "Допуск не может быть отрицательным";
	КонецЕсли;

	Возврат Проверить(СтрШаблон("%1 ± %2", Значение, Допуск), "Около", "около", Значение, Допуск);

КонецФункции

// Проверяет верхнюю границу.
//
// Параметры:
//   Значение - Число - максимальное значение.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция МеньшеИлиРавно(Значение) Экспорт
	ПроверитьЧисло(Значение);
	Возврат Проверить(Значение, "Меньше или равно", "<=", Значение);
КонецФункции

// Проверяет нижнюю границу.
//
// Параметры:
//   Значение - Число - минимальное значение.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция БольшеИлиРавно(Значение) Экспорт
	ПроверитьЧисло(Значение);
	Возврат Проверить(Значение, "Больше или равно", ">=", Значение);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЧисло(Значение)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "Аргументы сравнения должны быть числами";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДваЧисла(Значение1, Значение2)
	Если ТипЗнч(Значение1) <> Тип("Число") ИЛИ ТипЗнч(Значение2) <> Тип("Число") Тогда
		ВызватьИсключение "Аргументы сравнения должны быть числами";
	КонецЕсли;
КонецПроцедуры

Функция Проверить(Ожидаемое, Название, Оператор, Параметр1 = Неопределено, Параметр2 = Неопределено)

	Нарушения = Новый Массив;

	Для Каждого Элемент Из _Значения Цикл

		Если ТипЗнч(Элемент.Значение) <> Тип("Число") Тогда
			ВызватьИсключение "Значения метрики должны быть числами";
		КонецЕсли;

		Факт = Элемент.Значение;
		Успешно = Ложь;

		Если Оператор = "=" Тогда
			Успешно = Факт = Параметр1;
		ИначеЕсли Оператор = "<" Тогда
			Успешно = Факт < Параметр1;
		ИначеЕсли Оператор = ">" Тогда
			Успешно = Факт > Параметр1;
		ИначеЕсли Оператор = "<=" Тогда
			Успешно = Факт <= Параметр1;
		ИначеЕсли Оператор = ">=" Тогда
			Успешно = Факт >= Параметр1;
		ИначеЕсли Оператор = "между" Тогда
			Успешно = Факт >= Параметр1 И Факт <= Параметр2;
		ИначеЕсли Оператор = "около" Тогда
			Успешно = МатематическиеФункцииБенчмарков.Abs(Факт - Параметр1) <= Параметр2;
		КонецЕсли;

		Если Не Успешно Тогда
			Нарушения.Добавить(Элемент);
		КонецЕсли;

	КонецЦикла;

	Если Нарушения.Количество() > 0 Тогда
		Текст = СтрШаблон("%1: ожидаемое условие %2 %3. Нарушений: %4 из %5 кейсов", _ИмяМетрики, Название, Ожидаемое, Нарушения.Количество(), _Значения.Количество());
		Для Каждого Нарушение Из Нарушения Цикл
			Текст = Текст + СтрШаблон("; %1: %2%3", Нарушение.ПредставлениеКейса, Нарушение.Значение, СуффиксЕдиницы());
		КонецЦикла;

		ВызватьИсключение Текст;
	КонецЕсли;

	Возврат ЭтотОбъект;

КонецФункции

Функция СуффиксЕдиницы()

	Если _ЕдиницаИзмерения = Неопределено ИЛИ _ЕдиницаИзмерения = "" Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(_ЕдиницаИзмерения) = Тип("Строка") Тогда
		Обозначение = _ЕдиницаИзмерения;
	Иначе
		Обозначение = _ЕдиницаИзмерения.Обозначение;
	КонецЕсли;

	Возврат " " + Обозначение;

КонецФункции

#КонецОбласти
