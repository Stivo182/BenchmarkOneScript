Перем _Запуски; // Массив из РезультатЗапускаКейса
Перем _Бенчмарки; // Массив из Строка
Перем _Категории; // Массив из Строка
Перем _Параметры; // Соответствие Из КлючИЗначение:
                  //   * Ключ - Строка - Имя параметра.
                  //   * Значение - Массив из Произвольный - Допустимые значения параметра.
Перем _ИдентификаторыКейсов; // Массив из Число
Перем _ВерсииСреды; // Массив из Строка
Перем _Эталонность; // Булево, Неопределено

#Область ОбработчикиСобытий

// Создаёт проверку результата запуска бенчмарков.
//
// Параметры:
//   Результат - РезультатЗапускаБенчмарков - Проверяемый результат запуска.
Процедура ПриСозданииОбъекта(Результат)

	_Бенчмарки = Новый Массив();
	_Категории = Новый Массив();
	_Параметры = Новый Соответствие();
	_ИдентификаторыКейсов = Новый Массив();
	_ВерсииСреды = Новый Массив();
	_Эталонность = Неопределено;

	_Запуски = Новый Массив();
	Для Каждого Запуск Из Результат.Запуски Цикл
		_Запуски.Добавить(Запуск);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
#Область ПрограммныйИнтерфейс

// Отбирает кейсы по имени метода бенчмарка.
//
// Параметры:
//   ИмяМетода - Строка - Имя метода бенчмарка.
//
// Возвращаемое значение:
//   ПроверкаРезультатаБенчмарков
Функция ОтборБенчмарка(ИмяМетода) Экспорт
	ДобавитьУникальное(_Бенчмарки, ИмяМетода);
	Возврат ЭтотОбъект;
КонецФункции

// Отбирает кейсы по категории бенчмарка.
//
// Параметры:
//   ИмяКатегории - Строка - Имя категории.
//
// Возвращаемое значение:
//   ПроверкаРезультатаБенчмарков
Функция ОтборКатегории(ИмяКатегории) Экспорт
	ДобавитьУникальное(_Категории, ИмяКатегории);
	Возврат ЭтотОбъект;
КонецФункции

// Отбирает кейсы по значению параметра.
//
// Параметры:
//   Имя      - Строка - Имя параметра.
//   Значение - Произвольный - Допустимое значение.
//
// Возвращаемое значение:
//   ПроверкаРезультатаБенчмарков
Функция ОтборПараметра(Имя, Значение) Экспорт

	Значения = _Параметры.Получить(Имя);
	Если Значения = Неопределено Тогда
		Значения = Новый Массив();
		_Параметры.Вставить(Имя, Значения);
	КонецЕсли;

	ДобавитьУникальное(Значения, Значение);

	Возврат ЭтотОбъект;

КонецФункции

// Отбирает кейсы по идентификатору.
//
// Параметры:
//   Идентификатор - Число - Идентификатор кейса.
//
// Возвращаемое значение:
//   ПроверкаРезультатаБенчмарков
Функция ОтборИдентификатораКейса(Идентификатор) Экспорт
	ДобавитьУникальное(_ИдентификаторыКейсов, Идентификатор);
	Возврат ЭтотОбъект;
КонецФункции

// Отбирает кейсы по версии исполняющей среды.
//
// Параметры:
//   Версия - Строка - Версия среды.
//
// Возвращаемое значение:
//   ПроверкаРезультатаБенчмарков
Функция ОтборВерсииСреды(Версия) Экспорт
	ДобавитьУникальное(_ВерсииСреды, Версия);
	Возврат ЭтотОбъект;
КонецФункции

// Отбирает кейсы по признаку эталона.
//
// Параметры:
//   Эталонные - Булево - Истина для эталонных кейсов, Ложь для неэталонных.
//
// Возвращаемое значение:
//   ПроверкаРезультатаБенчмарков
Функция ОтборЭталонных(Эталонные = Истина) Экспорт
	_Эталонность = Эталонные;
	Возврат ЭтотОбъект;
КонецФункции

// Извлекает метрику для выбранных кейсов.
//
// Параметры:
//   Метрика            - Строка - Идентификатор из МетрикиБенчмарков.
//   ЕдиницаИзмерения   - ЕдиницаИзмеренияБенчмарка, Неопределено - Целевая единица.
//
// Возвращаемое значение:
//   ПроверкаМетрикиБенчмарков
Функция Метрика(Метрика, ЕдиницаИзмерения = Неопределено) Экспорт

	Если ТипЗнч(Метрика) <> Тип("Строка") Тогда
		ВызватьИсключение "Метрика должна иметь тип Строка.";
	КонецЕсли;

	Если Не МетрикиБенчмарков.Поддерживается(Метрика) Тогда
		ВызватьИсключение СтрШаблон("Метрика <%1> не поддерживается.", Метрика);
	КонецЕсли;

	Выборка = ОтобратьЗапуски();
	Если Выборка.Количество() = 0 Тогда
		ВызватьИсключение "Проверка результата не выбрала ни одного кейса. Отборы: " + ПредставлениеОтборов();
	КонецЕсли;

	Колонка = КолонкиОтчетаБенчмарков.СоздатьПоИмени(Метрика);
	ПроверитьЕдиницуИзмерения(Колонка.ЕдиницаИзмерения, ЕдиницаИзмерения);
	Значения = Новый Массив();
	Недоступные = Новый Массив();

	Для Каждого Запуск Из Выборка Цикл
		Значение = Колонка.Значение(Запуск, Колонка);
		Причина = ПричинаНедоступностиМетрики(Метрика, Запуск, Значение);

		Если Причина <> Неопределено Тогда
			Недоступные.Добавить(Новый Структура("ПредставлениеКейса, Причина", ПредставлениеКейса(Запуск), Причина));
			Продолжить;
		КонецЕсли;

		Если ЕдиницаИзмерения <> Неопределено Тогда
			Значение = ЕдиницыИзмеренийБенчмарков.Конвертировать(Значение, Колонка.ЕдиницаИзмерения, ЕдиницаИзмерения);
		КонецЕсли;

		Значения.Добавить(Новый Структура("Значение, ПредставлениеКейса", Значение, ПредставлениеКейса(Запуск)));
	КонецЦикла;

	Если Недоступные.Количество() > 0 Тогда
		ВызватьИсключение ТекстОшибкиНедоступнойМетрики(Метрика, Выборка.Количество(), Недоступные);
	КонецЕсли;

	ФактическаяЕдиница = ?(ЕдиницаИзмерения = Неопределено, Колонка.ЕдиницаИзмерения, ЕдиницаИзмерения);

	Возврат Новый ПроверкаМетрикиБенчмарков(Метрика, ФактическаяЕдиница, Значения);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтобратьЗапуски()

	ПроверитьИменаПараметров();
	Результат = Новый Массив();

	Для Каждого Запуск Из _Запуски Цикл
		Если ЗапускСоответствуетФильтрам(Запуск) Тогда
			Результат.Добавить(Запуск);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗапускСоответствуетФильтрам(Запуск)

	Кейс = Запуск.Кейс;
	Дескриптор = Кейс.ДескрипторБенчмарка();

	Возврат СоответствуетГруппе(_Бенчмарки, Дескриптор.Метод())
		И СоответствуетГруппе(_Категории, Дескриптор.Категория())
		И СоответствуетГруппе(_ИдентификаторыКейсов, Кейс.Идентификатор())
		И СоответствуетГруппе(_ВерсииСреды, Кейс.ИсполняющаяСреда().Версия)
		И (_Эталонность = Неопределено Или Запуск.ЭтоЭталон = _Эталонность)
		И СоответствуетПараметрам(Кейс.Параметры());

КонецФункции

Функция СоответствуетГруппе(ДопустимыеЗначения, Значение)
	Возврат ДопустимыеЗначения.Количество() = 0 Или ДопустимыеЗначения.Найти(Значение) <> Неопределено;
КонецФункции

Функция СоответствуетПараметрам(ПараметрыКейса)

	Для Каждого Группа Из _Параметры Цикл
		Если Не СодержитПараметр(ПараметрыКейса, Группа.Ключ, Группа.Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СодержитПараметр(ПараметрыКейса, Имя, ДопустимыеЗначения)

	Для Каждого Параметр Из ПараметрыКейса Цикл
		Если Параметр.Имя() = Имя И ДопустимыеЗначения.Найти(Параметр.Значение()) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ПроверитьИменаПараметров()
	Для Каждого Группа Из _Параметры Цикл
		Если Не ИмяПараметраСуществует(Группа.Ключ) Тогда
			ВызватьИсключение СтрШаблон("Параметр <%1> не найден.", Группа.Ключ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИмяПараметраСуществует(Имя)

	Для Каждого Запуск Из _Запуски Цикл
		Для Каждого Параметр Из Запуск.Кейс.Параметры() Цикл
			Если Параметр.Имя() = Имя Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьУникальное(МассивЗначений, Значение)
	Если МассивЗначений.Найти(Значение) = Неопределено Тогда
		МассивЗначений.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЕдиницуИзмерения(ИсходнаяЕдиница, ЦелеваяЕдиница)

	Если ЦелеваяЕдиница = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ЦелеваяЕдиница) <> Тип("ЕдиницаИзмеренияБенчмарка") Тогда
		ВызватьИсключение "Единица измерения должна иметь тип ЕдиницаИзмеренияБенчмарка.";
	КонецЕсли;

	Если ИсходнаяЕдиница = Неопределено Тогда
		ВызватьИсключение "Для безразмерной метрики нельзя задать единицу измерения.";
	КонецЕсли;

	Если БазоваяЕдиница(ИсходнаяЕдиница) <> БазоваяЕдиница(ЦелеваяЕдиница) Тогда
		ВызватьИсключение СтрШаблон("Единица <%1> несовместима с единицей метрики <%2>.", ЦелеваяЕдиница.Обозначение, ИсходнаяЕдиница.Обозначение);
	КонецЕсли;

КонецПроцедуры

Функция БазоваяЕдиница(Единица)
	Возврат ?(Единица.Базовая = Неопределено, Единица, Единица.Базовая);
КонецФункции

Функция ПричинаНедоступностиМетрики(Метрика, Запуск, Значение)

	ОтносительнаяМетрика = Метрика = МетрикиБенчмарков.КоэффициентПроизводительности()
		Или Метрика = МетрикиБенчмарков.RatioSD();

	Если ОтносительнаяМетрика И Не Запуск.ЭтоЭталон И Запуск.Эталон = Неопределено Тогда
		Возврат "не найден эталон";
	КонецЕсли;

	Если Метрика = МетрикиБенчмарков.ВыделяемаяПамять() Тогда
		Если Запуск.Статистика.ЗамерыПамяти().Количество() = 0 Тогда
			Возврат "нет замеров памяти";
		КонецЕсли;
	ИначеЕсли Запуск.Статистика.ЗамерыВремени().Количество() = 0 Тогда
		Возврат "нет замеров времени";
	КонецЕсли;

	Если ОтносительнаяМетрика И Не Запуск.ЭтоЭталон
		И Запуск.Эталон.Статистика.ЗамерыВремени().Количество() = 0 Тогда
		Возврат "в эталоне нет замеров времени";
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат СтрШаблон("получено нечисловое значение <%1>", Значение);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПредставлениеКейса(Запуск)

	Кейс = Запуск.Кейс;

	Части = Новый Массив();
	Части.Добавить(Кейс.ДескрипторБенчмарка().Метод());

	Для Каждого Параметр Из Кейс.Параметры() Цикл
		Части.Добавить(СтрШаблон("%1=%2", Параметр.Имя(), Параметр.Представление()));
	КонецЦикла;

	Части.Добавить("среда=" + Кейс.ИсполняющаяСреда().Версия);

	Возврат СтрШаблон("Кейс #%1: %2", Кейс.Идентификатор(), СтрСоединить(Части, ", "));

КонецФункции

Функция ТекстОшибкиНедоступнойМетрики(Метрика, КоличествоКейсов, Недоступные)

	Строки = Новый Массив();
	Для Каждого Элемент Из Недоступные Цикл
		Строки.Добавить(СтрШаблон("- %1 - %2.", Элемент.ПредставлениеКейса, Элемент.Причина));
	КонецЦикла;

	Возврат СтрШаблон(
		"Невозможно проверить метрику <%1>.%2Метрика недоступна для %3 из %4 кейсов.%2%2%5",
		Метрика,
		Символы.ПС,
		Недоступные.Количество(),
		КоличествоКейсов,
		СтрСоединить(Строки, Символы.ПС)
	);

КонецФункции

Функция ПредставлениеОтборов()

	Части = Новый Массив();

	ДобавитьПредставлениеГруппы(Части, "Бенчмарк", _Бенчмарки);
	ДобавитьПредставлениеГруппы(Части, "Категория", _Категории);
	ДобавитьПредставлениеГруппы(Части, "Идентификатор кейса", _ИдентификаторыКейсов);
	ДобавитьПредставлениеГруппы(Части, "Версия среды", _ВерсииСреды);

	Если _Эталонность <> Неопределено Тогда
		Части.Добавить("Эталон=(" + Строка(_Эталонность) + ")");
	КонецЕсли;

	Для Каждого Группа Из _Параметры Цикл
		ДобавитьПредставлениеГруппы(Части, "Параметр " + Группа.Ключ, Группа.Значение);
	КонецЦикла;

	Возврат ?(Части.Количество() = 0, "не заданы", СтрСоединить(Части, "; "));

КонецФункции

Процедура ДобавитьПредставлениеГруппы(Части, Имя, Значения)

	Если Значения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Представления = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Представления.Добавить(Строка(Значение));
	КонецЦикла;

	Части.Добавить(СтрШаблон("%1=(%2)", Имя, СтрСоединить(Представления, ", ")));

КонецПроцедуры

#КонецОбласти
