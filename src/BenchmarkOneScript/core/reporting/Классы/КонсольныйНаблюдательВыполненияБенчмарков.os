#Использовать coloratos

Перем _ВыводитьПрогресс; // Булево

#Область ОбработчикиСобытий

// Создает наблюдатель консольного вывода.
//
// Параметры:
//   ВыводитьПрогресс - Булево - Выводить события хода выполнения; по умолчанию Истина.
Процедура ПриСозданииОбъекта(ВыводитьПрогресс = Истина)
	_ВыводитьПрогресс = ВыводитьПрогресс;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выводит событие выполнения бенчмарков в консоль.
//
// Параметры:
//   Событие - СобытиеВыполненияБенчмарков
Процедура ОбработатьСобытие(Событие) Экспорт

	Данные = Событие.Данные();

	Если Не _ВыводитьПрогресс
		И Событие.ТипСобытия() <> ТипыСобытийВыполненияБенчмарков.ЗапускБенчмарковЗавершен()
		И Событие.ТипСобытия() <> ТипыСобытийВыполненияБенчмарков.АртефактыСформированы() Тогда
		Возврат;
	КонецЕсли;

	Если Событие.ТипСобытия() = ТипыСобытийВыполненияБенчмарков.ИсполняющаяСредаБенчмарковНачата() Тогда
		ВывестиЗаголовок(Данные.ВерсияИсполняющейСреды);
		ВывестиКонфигурацию(Данные.Конфигурация);
	ИначеЕсли Событие.ТипСобытия() = ТипыСобытийВыполненияБенчмарков.ВыводПроцессаПолучен() Тогда
		Вывести(Данные);
	ИначеЕсли Событие.ТипСобытия() = ТипыСобытийВыполненияБенчмарков.КейсБенчмаркаНачат() Тогда
		ВывестиЗаголовокБенчмарка(Данные.ДескрипторБенчмарка());
		ВывестиПараметры(Данные.Параметры());
	ИначеЕсли Событие.ТипСобытия() = ТипыСобытийВыполненияБенчмарков.ИтерацияБенчмаркаЗавершена() Тогда
		Если Данные.НомерИтерации = 1 Тогда
			ВывестиСтроку(" ");
		КонецЕсли;
		ВывестиСтроку(Строка(Данные), "Серый");
	ИначеЕсли Событие.ТипСобытия() = ТипыСобытийВыполненияБенчмарков.СтатистикаКейсаРассчитана() Тогда
		ВывестиСтатистику(Данные.Статистика);
	ИначеЕсли Событие.ТипСобытия() = ТипыСобытийВыполненияБенчмарков.ЗапускБенчмарковЗавершен() Тогда
		ВывестиРезультатЗапуска(Данные);
	ИначеЕсли Событие.ТипСобытия() = ТипыСобытийВыполненияБенчмарков.АртефактыСформированы() Тогда
		ВывестиСтроку(" ");
		ВывестиСтроку("// Артефакты", "Малиновый");
		Для Каждого ПолноеИмяФайла Из Данные.Файлы Цикл
			ВывестиСтроку(ПолноеИмяФайла, "ТемноЖелтый");
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит результат запуска бенчмарков
//
// Параметры:
//   Результат - РезультатЗапускаБенчмарков
Процедура ВывестиРезультатЗапуска(Результат)

	// Среда окружения
	ТекстСреды = Строка(Результат.СредаОкружения);
	ТекстСреды = СтрЗаменить(ТекстСреды, Символы.ПС, " \" + Символы.ПС);

	Если _ВыводитьПрогресс Тогда
		ВывестиСтроку(" ");
	КонецЕсли;

	ВывестиСтроку("// Сводка", "Малиновый");
	ВывестиСтроку(ТекстСреды, "ТемноЖелтый");

	// Отчет в Markdown
	ВывестиСтроку(" ");
	ВывестиСтроку(Результат.Отчет.КакMarkdown(), "Бирюза");

	ВывестиПредупреждения(Результат.Запуски);

	// Легенда
	ВывестиСтроку(" ");
	ВывестиСтроку("// Легенда", "Малиновый");
	ВывестиСтроку(Результат.Отчет.Легенда(), "Синий");

КонецПроцедуры

Процедура ВывестиПредупреждения(Запуски)

	ДанныеДиагностики = ПодготовитьДанныеДиагностики(Запуски);
	Если ДанныеДиагностики.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВывестиСтроку(" ");
	ВывестиСтроку("// Диагностика измерений", "Малиновый");

	ВыводитьСреду = НесколькоИсполняющихСред(Запуски);

	Если ВыводитьСреду Тогда
		ДанныеДиагностики.Сортировать("ИмяБенчмарка, ПредставлениеСреды");
	КонецЕсли;

	ПредыдущееИмяБенчмарка = "";
	ПредставлениеПредыдущейСреды = "";

	Для Каждого ДанныеЗапуска Из ДанныеДиагностики Цикл
		РезультатЗапускаКейса = ДанныеЗапуска.РезультатЗапускаКейса;
		ИмяБенчмарка = ДанныеЗапуска.ИмяБенчмарка;
		ПредставлениеСреды = ДанныеЗапуска.ПредставлениеСреды;

		Если ИмяБенчмарка <> ПредыдущееИмяБенчмарка Тогда
			Если ЗначениеЗаполнено(ПредыдущееИмяБенчмарка) Тогда
				ВывестиСтроку(" ");
			КонецЕсли;

			ВывестиСтроку(ИмяБенчмарка, "Синий");
			ПредыдущееИмяБенчмарка = ИмяБенчмарка;
			ПредставлениеПредыдущейСреды = "";
		КонецЕсли;

		Если ВыводитьСреду И ПредставлениеСреды <> ПредставлениеПредыдущейСреды Тогда
			ВывестиСтроку("  Runtime = " + ПредставлениеСреды, "Серый");
			ПредставлениеПредыдущейСреды = ПредставлениеСреды;
		КонецЕсли;

		ВывестиПараметрыДиагностики(РезультатЗапускаКейса.Кейс.Параметры());

		ВывестиПредупрежденияДиагностики(РезультатЗапускаКейса.Предупреждения);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиПредупрежденияДиагностики(Предупреждения)

	ВывестиПредупрежденияДиагностикиУровня(Предупреждения, УровниДиагностическихСобытийБенчмарков.Предупреждение());
	ВывестиПредупрежденияДиагностикиУровня(Предупреждения, УровниДиагностическихСобытийБенчмарков.Информация());

КонецПроцедуры

Процедура ВывестиПредупрежденияДиагностикиУровня(Предупреждения, Уровень)

	Цвет = ?(Уровень = УровниДиагностическихСобытийБенчмарков.Информация(), "Серый", "ТемноЖелтый");

	Для Каждого Событие Из Предупреждения Цикл
		Если Событие.Уровень <> Уровень Тогда
			Продолжить;
		КонецЕсли;

		ВывестиСтроку("    " + ПредставлениеДиагностическогоСобытия(Событие), Цвет);
	КонецЦикла;

КонецПроцедуры

Функция ПредставлениеДиагностическогоСобытия(Событие)

	Параметры = Событие.ЧисловыеПараметры;
	Маркер = ?(Событие.Уровень = УровниДиагностическихСобытийБенчмарков.Информация(), "[i]", "[!]");

	Если Событие.Код = КодыДиагностическихСобытийБенчмарков.НедостаточноИзмерений() Тогда
		Текст = СтрШаблон("Недостаточно измерений: %1 (требуется: %2)", Параметры.КоличествоИзмерений, Параметры.ТребуемоеКоличествоИзмерений);
	ИначеЕсли Событие.Код = КодыДиагностическихСобытийБенчмарков.НевозможноОценитьПогрешность() Тогда
		Текст = СтрШаблон(
			"Погрешность не удалось оценить (цель: %1%%, измерений: %2)",
			ПредставлениеЧислаДиагностики(Параметры.ЦелеваяОтносительнаяПогрешность * 100),
			Параметры.КоличествоИзмерений
		);
	ИначеЕсли Событие.Код = КодыДиагностическихСобытийБенчмарков.ПогрешностьВышеЦели() Тогда
		Текст = СтрШаблон(
			"Погрешность: %1%% (цель: %2%%, измерений: %3)",
			ПредставлениеЧислаДиагностики(Параметры.ФактическаяОтносительнаяПогрешность * 100),
			ПредставлениеЧислаДиагностики(Параметры.ЦелеваяОтносительнаяПогрешность * 100),
			Параметры.КоличествоИзмерений
		);
	ИначеЕсли Событие.Код = КодыДиагностическихСобытийБенчмарков.ПогрешностьВышеОриентира() Тогда
		Текст = СтрШаблон(
			"Погрешность: %1%% (ориентир: %2%%)",
			ПредставлениеЧислаДиагностики(Параметры.ФактическаяОтносительнаяПогрешность * 100),
			ПредставлениеЧислаДиагностики(Параметры.РекомендуемаяОтносительнаяПогрешность * 100)
		);
	ИначеЕсли Событие.Код = КодыДиагностическихСобытийБенчмарков.СлишкомКороткаяИтерация() Тогда
		Текст = СтрШаблон(
			"Итерация: %1 мс (цель: %2 мс, %3 вызовов)",
			ПредставлениеЧислаДиагностики(Параметры.СредняяДлительностьИтерацииВМиллисекундах),
			ПредставлениеЧислаДиагностики(Параметры.ЦелеваяДлительностьИтерацииВМиллисекундах),
			ПредставленияПоказателейБенчмарков.Представление(Параметры.КоличествоВызовов, Неопределено, "ЧГ=; ЧРД=.; ЧДЦ=0", Ложь)
		);
	ИначеЕсли Событие.Код = КодыДиагностическихСобытийБенчмарков.ОбнаруженыВыбросы() Тогда
		Текст = СтрШаблон("Выбросы: %1 из %2", Параметры.КоличествоВыбросов, Параметры.КоличествоИзмерений);
	Иначе
		Текст = Событие.Код;
	КонецЕсли;

	Возврат Маркер + " " + Текст;

КонецФункции

Функция ПредставлениеЧислаДиагностики(Значение)

	Представление = ПредставленияПоказателейБенчмарков.ПредставлениеЧисла(Значение);
	Возврат СтрЗаменить(Представление, ",", "");

КонецФункции

Функция ПодготовитьДанныеДиагностики(Запуски)

	ДанныеДиагностики = Новый ТаблицаЗначений();
	ДанныеДиагностики.Колонки.Добавить("ИмяБенчмарка");
	ДанныеДиагностики.Колонки.Добавить("ПредставлениеСреды");
	ДанныеДиагностики.Колонки.Добавить("РезультатЗапускаКейса");

	Для Каждого РезультатЗапускаКейса Из Запуски Цикл
		Если РезультатЗапускаКейса.Предупреждения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Дескриптор = РезультатЗапускаКейса.Кейс.ДескрипторБенчмарка();
		ДанныеЗапуска = ДанныеДиагностики.Добавить();
		ДанныеЗапуска.ИмяБенчмарка = СтрШаблон("%1.%2", Дескриптор.ТипКласса(), Дескриптор.Метод());
		ДанныеЗапуска.ПредставлениеСреды = ПредставлениеИсполняющейСреды(РезультатЗапускаКейса.Кейс.ИсполняющаяСреда());
		ДанныеЗапуска.РезультатЗапускаКейса = РезультатЗапускаКейса;
	КонецЦикла;

	Возврат ДанныеДиагностики;

КонецФункции

Функция НесколькоИсполняющихСред(Запуски)

	ИсполняющиеСреды = Новый Соответствие();
	Для Каждого РезультатЗапускаКейса Из Запуски Цикл
		ПредставлениеСреды = ПредставлениеИсполняющейСреды(РезультатЗапускаКейса.Кейс.ИсполняющаяСреда());
		ИсполняющиеСреды.Вставить(ПредставлениеСреды, Истина);
	КонецЦикла;

	Возврат ИсполняющиеСреды.Количество() > 1;

КонецФункции

Функция ПредставлениеИсполняющейСреды(ИсполняющаяСреда)

	Если ЗначениеЗаполнено(ИсполняющаяСреда.Наименование) Тогда
		Возврат СтрШаблон("%1 (%2)", ИсполняющаяСреда.Наименование, ИсполняющаяСреда.Версия);
	ИначеЕсли ЗначениеЗаполнено(ИсполняющаяСреда.Версия) Тогда
		Возврат ИсполняющаяСреда.Версия;
	КонецЕсли;

	Возврат "current";

КонецФункции

Процедура ВывестиПараметрыДиагностики(Параметры)

	Для Каждого Параметр Из Параметры Цикл
		ВывестиСтроку("  " + Параметр.Имя() + " = " + Параметр.Представление());
	КонецЦикла;

КонецПроцедуры

// Выводит заголовок запуска бенчмарков
//
// Параметры:
//   Версия - Строка - Версия исполняющей среды OneScript.
//                     Если не указана, определяется автоматически.
Процедура ВывестиЗаголовок(Версия = "")
	
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Версия = Новый СистемнаяИнформация().Версия;
	КонецЕсли;
	
	ВывестиСтроку(" ");
	ВывестиСтроку(СтрШаблон("*** Запуск бенчмарков в исполняющей среде OneScript <%1> ***", Версия), "Синий");

КонецПроцедуры

// Выводит информацию о конфигурации запуска бенчмарков
//
// Параметры:
//   Конфигурация - КонфигурацияБенчмарков
Процедура ВывестиКонфигурацию(Конфигурация)

	ВывестиСтроку(" ");
	ВывестиСтроку("// Конфигурация", "Малиновый");
	ВывестиСтроку(Строка(Конфигурация), "ТемноЖелтый");

КонецПроцедуры

// Выводит агрегированную статистику запуска бенчмарков
//
// Параметры:
//   Статистика - СтатистикаБенчмарка
Процедура ВывестиСтатистику(Статистика)

	ВывестиСтроку(" ");
	ВывестиСтроку("// Статистика", "Малиновый");
	ВывестиСтроку(Строка(Статистика), "Бирюза");

КонецПроцедуры

// Выводит заголовок текущего бенчмарка
//
// Параметры:
//   ДескрипторБенчмарка - ДескрипторБенчмарка
Процедура ВывестиЗаголовокБенчмарка(ДескрипторБенчмарка)
	
	ПолноеИмяБенчмарка = СтрШаблон("%1.%2", ДескрипторБенчмарка.ТипКласса(), ДескрипторБенчмарка.Метод());
	
	Если ЗначениеЗаполнено(ДескрипторБенчмарка.Наименование()) Тогда
		Текст = СтрШаблон("// Бенчмарк: %1 (%2)", ДескрипторБенчмарка.Наименование(), ПолноеИмяБенчмарка);
	Иначе
		Текст = СтрШаблон("// Бенчмарк: %1", ПолноеИмяБенчмарка);
	КонецЕсли;
	
	ВывестиСтроку(" ");
	ВывестиСтроку(Текст, "Малиновый");

КонецПроцедуры

// Выводит список параметров
//
// Параметры:
//   Параметры - Массив из ПараметрБенчмарка - Коллекция параметров бенчмарка
Процедура ВывестиПараметры(Параметры)
		
	Цвет = "ТемноЖелтый";
	
	Если Параметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Вывести("Параметры: ", Цвет);

	ЭтоПервыйПараметр = Истина;
	Для Каждого Параметр Из Параметры Цикл	

		Если Не ЭтоПервыйПараметр Тогда
			Вывести(", ", Цвет);
		КонецЕсли;
		
		Вывести(СтрШаблон("%1 = %2", Параметр.Имя(), Строка(Параметр.Представление())), Цвет);
		
		ЭтоПервыйПараметр = Ложь;

	КонецЦикла;
	
	ВывестиСтроку("");	
	
КонецПроцедуры

// Выводит строку в консоль с переводом строки
//
// Параметры:
//   Текст - Строка - Выводимый текст
//   Цвет  - Строка - Имя цвета для оформления вывода
Процедура ВывестиСтроку(Текст, Цвет = Неопределено)

	Если Бенчмаркинг.ЭтоДочернийПроцесс() И Не Цвет = Неопределено Тогда
		ЦветнойВывод.ВывестиСтроку(ТекстСЦветом(Текст, Цвет));
	Иначе
		ЦветнойВывод.ВывестиСтроку(ПодготовитьТекст(Текст), Цвет);
	КонецЕсли;

КонецПроцедуры

// Выводит текст в консоль без добавления перевода строки
//
// Параметры:
//   Текст - Строка - Выводимый текст
//   Цвет  - Строка - Имя цвета для оформления вывода
Процедура Вывести(Текст, Цвет = Неопределено)

	Если Бенчмаркинг.ЭтоДочернийПроцесс() И Не Цвет = Неопределено Тогда
		ЦветнойВывод.Вывести(ТекстСЦветом(Текст, Цвет));
	Иначе
		ЦветнойВывод.Вывести(ПодготовитьТекст(Текст), Цвет);
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьТекст(Знач Текст)
	Возврат СтрЗаменить(Текст, "|!#color=", "|#color=");
КонецФункции

Функция ТекстСЦветом(Текст, Цвет)

	Шаблон = "(%1|!#color=%2)";
	МассивСтрок = СтрРазделить(Текст, Символы.ПС);

	Для Инд = 0 По МассивСтрок.ВГраница() Цикл
		МассивСтрок[Инд] = СтрШаблон(Шаблон, МассивСтрок[Инд], Цвет);
	КонецЦикла;

	Возврат СтрСоединить(МассивСтрок, Символы.ПС);

КонецФункции

#КонецОбласти
