
// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off

#Использовать fluent

&Сериализуемое("OriginalValues")
&Тип("Массив") &ДляКаждого &Тип("Число")
Перем _ЗамерыВремени; // Массив из Число

&Сериализуемое("N")
&Тип("Число")
Перем КоличествоИтераций Экспорт; // Число

&Сериализуемое("Min")
&Тип("Число")
Перем Мин Экспорт; // Число

&Сериализуемое("Q1")
&Тип("Число")
Перем НижнийКвартиль Экспорт; // Число

&Сериализуемое("Median")
&Тип("Число")
Перем Медиана Экспорт; // Число

&Сериализуемое("Mean")
&Тип("Число")
Перем Среднее Экспорт; // Число

&Сериализуемое("Q3")
&Тип("Число")
Перем ВерхнийКвартиль Экспорт; // Число

&Сериализуемое("Max")
&Тип("Число")
Перем Макс Экспорт; // Число

&Сериализуемое("StdDev")
&Тип("Число")
Перем СтандартноеОтклонение Экспорт; // Число

&Сериализуемое("StdErr")
&Тип("Число")
Перем СтандартнаяОшибкаСреднего Экспорт; // Число

&Сериализуемое("ConfidenceIntervalLower")
Перем НижняяГраницаДоверительногоИнтервала Экспорт; // Число, Неопределено

&Сериализуемое("ConfidenceIntervalUpper")
Перем ВерхняяГраницаДоверительногоИнтервала Экспорт; // Число, Неопределено

&Сериализуемое("Error")
Перем ПогрешностьСреднего Экспорт; // Число, Неопределено

&Сериализуемое("RelativeError")
Перем ОтносительнаяПогрешность Экспорт; // Число, Неопределено

&Сериализуемое("OutlierCount")
&Тип("Число")
Перем КоличествоВыбросов Экспорт; // Число

&Сериализуемое("Ops")
&Тип("Число")
Перем ОперацийВСекунду Экспорт; // Число

&Сериализуемое("BytesAllocatedPerOperation")
&Тип("Число")
Перем ВыделяемаяПамять Экспорт; // Число

&НеСериализуемое
Перем _КаноническоеСостояние; // ФиксированнаяСтруктура

&НеСериализуемое
Перем _ТекущаяЕдиницаВремени; // ЕдиницаИзмеренияБенчмарка

&НеСериализуемое
Перем _ВременныеПоказателиИнициализированы; // Булево

&НеСериализуемое
Перем Math; // МатематическиеФункцииБенчмарков

#Область ОбработчикиСобытий

// Статистика бенчмарка
//
// Параметры:
//   Замеры - Массив из РезультатИтерацииКейса
//          - Структура:
//              * ЗамерыВремени - Массив из Число
//              * ЗамерыПамяти - Массив из Число
Процедура ПриСозданииОбъекта(Замеры = Неопределено)

	Math = МатематическиеФункцииБенчмарков;
	_ТекущаяЕдиницаВремени = ЕдиницыИзмеренийБенчмарков.Наносекунда;

	Если Не Замеры = Неопределено Тогда
		Прочитать(Замеры);
	Иначе
		Рассчитать(Новый Массив(), Новый Массив());
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Значение, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

	Результат = Новый Массив();

	// Mean
	СреднееЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		Среднее,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("Mean = %1, ", СреднееЧитаемое));

	// StdDev 
	СтандартноеОтклонениеЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		СтандартноеОтклонение,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("StdDev = %1, ", СтандартноеОтклонениеЧитаемое));

	// StdErr
	СтандартнаяОшибкаСреднегоЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		СтандартнаяОшибкаСреднего,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("StdErr = %1, ", СтандартнаяОшибкаСреднегоЧитаемое));

	// N
	Результат.Добавить(СтрШаблон("N = %1, ", _КаноническоеСостояние.КоличествоИтераций));

	// Op/s
	Результат.Добавить(СтрШаблон("Op/s = %1", ПредставленияПоказателейБенчмарков.Представление(ОперацийВСекунду)));

	// Перенос
	Результат.Добавить(Символы.ПС);

	// Min 
	МинЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		Мин,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("Min = %1, ", МинЧитаемое));

	// Q1 
	НижнийКвартильЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		НижнийКвартиль,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("Q1 = %1, ", НижнийКвартильЧитаемое));

	// Median 
	МедианаЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		Медиана,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("Median = %1, ", МедианаЧитаемое));

	// Q3 
	ВерхнийКвартильЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		ВерхнийКвартиль,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("Q3 = %1, ", ВерхнийКвартильЧитаемое));

	// Max 
	МаксЧитаемое = ПредставленияПоказателейБенчмарков.Представление(
		Макс,
		_ТекущаяЕдиницаВремени);

	Результат.Добавить(СтрШаблон("Max = %1", МаксЧитаемое));

	// Allocated
	Если ЗначениеЗаполнено(ВыделяемаяПамять) Тогда
		ВыделяемаяПамятьЧитаемое = ПредставленияПоказателейБенчмарков.ПредставлениеЧитаемое(
			ВыделяемаяПамять,
			ЕдиницыИзмеренийБенчмарков.Байт);

		Результат.Добавить(Символы.ПС);
		Результат.Добавить(СтрШаблон("Allocated = %1", ВыделяемаяПамятьЧитаемое));
	КонецЕсли;

	Значение = СтрСоединить(Результат, "");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает квантиль в текущей единице времени
//
// Параметры:
//   Вероятность - Число
//
// Возвращаемое значение:
//   Число
Функция Квантиль(Вероятность) Экспорт

	Квантиль = Math.НольЕслиНеопределено(Math.Квантиль(
		_КаноническоеСостояние.УпорядоченныеЗамерыВремени,
		Вероятность
	));

	Квантиль = ЕдиницыИзмеренийБенчмарков.Конвертировать(
		Квантиль, 
		ЕдиницыИзмеренийБенчмарков.Наносекунда, 
		_ТекущаяЕдиницаВремени
	);

	Возврат Квантиль;

КонецФункции

// Читает замеры, копирует их и пересчитывает статистику.
// Сохраняет текущую единицу времени.
//
// Параметры:
//   Замеры - Массив из РезультатИтерацииКейса
//          - Структура:
//              * ЗамерыВремени - Массив из Число
//              * ЗамерыПамяти - Массив из Число
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Прочитать(Замеры) Экспорт

	Если ТипЗнч(Замеры) = Тип("Массив") Тогда
		ЗамерыВремени = ВыгрузитьЗамеры(Замеры, "НаносекундЗаОперацию", ЭтапыБенчмарка.Измерение);
		ЗамерыПамяти = ВыгрузитьЗамеры(Замеры, "ВыделяемаяПамятьЗаОперацию", ЭтапыБенчмарка.Память);
	ИначеЕсли ТипЗнч(Замеры) = Тип("Структура") Тогда
		ЗамерыВремени = Новый Массив(Новый ФиксированныйМассив(Замеры.ЗамерыВремени));
		ЗамерыПамяти = Новый Массив(Новый ФиксированныйМассив(Замеры.ЗамерыПамяти));
	Иначе
		ВызватьИсключение СтрШаблон("Замеры с типом %1 не поддерживаются", ТипЗнч(Замеры));
	КонецЕсли;

	Рассчитать(ЗамерыВремени, ЗамерыПамяти);

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает новую статистику в секундах, не изменяя текущую
//
// Возвращаемое значение:
//   СтатистикаБенчмарка
Функция ВСекунды() Экспорт
	Возврат КопияВЕдиницеВремени(ЕдиницыИзмеренийБенчмарков.Секунда);
КонецФункции

// Возвращает новую статистику в миллисекундах, не изменяя текущую
//
// Возвращаемое значение:
//   СтатистикаБенчмарка
Функция ВМиллисекунды() Экспорт
	Возврат КопияВЕдиницеВремени(ЕдиницыИзмеренийБенчмарков.Миллисекунда);
КонецФункции

// Возвращает новую статистику в микросекундах, не изменяя текущую
//
// Возвращаемое значение:
//   СтатистикаБенчмарка
Функция ВМикросекунды() Экспорт
	Возврат КопияВЕдиницеВремени(ЕдиницыИзмеренийБенчмарков.Микросекунда);
КонецФункции

// Возвращает новую статистику в наносекундах, не изменяя текущую
//
// Возвращаемое значение:
//   СтатистикаБенчмарка
Функция ВНаносекунды() Экспорт
	Возврат КопияВЕдиницеВремени(ЕдиницыИзмеренийБенчмарков.Наносекунда);
КонецФункции

// Меняет единицу времени текущей статистики, не изменяя замеры и показатели памяти.
// При некорректной единице выбрасывает исключение, сохраняя состояние статистики.
//
// Параметры:
//   Единица - ЕдиницаИзмеренияБенчмарка - Наносекунда или единица с базовой Наносекунда
//       и положительным числовым отношением к базовой.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьЕдиницуВремени(Единица) Экспорт
	КонвертироватьВремя(Единица);
	Возврат ЭтотОбъект;
КонецФункции

// Вычисляет отношение соответствующих элементов замеров времени и памяти текущей статистики 
// к элементам переданной статистики и возвращает новый объект СтатистикаБенчмарка с результатами.
//
// Параметры:
//   Статистика - СтатистикаБенчмарка
//
// Возвращаемое значение:
//   СтатистикаБенчмарка
Функция Разделить(Статистика) Экспорт

	ЗамерыВремени = Math.Разделить(_КаноническоеСостояние.ЗамерыВремени, Статистика.ЗамерыВремени());
	ЗамерыПамяти = Math.Разделить(_КаноническоеСостояние.ЗамерыПамяти, Статистика.ЗамерыПамяти());

	Замеры = Новый Структура("ЗамерыВремени, ЗамерыПамяти", ЗамерыВремени, ЗамерыПамяти);

	Возврат Новый СтатистикаБенчмарка(Замеры);

КонецФункции

// Возвращает копию исходных замеров времени выполнения в наносекундах
//
// Возвращаемое значение:
//   Массив из Число
Функция ЗамерыВремени() Экспорт
	Возврат Новый Массив(Новый ФиксированныйМассив(_КаноническоеСостояние.ЗамерыВремени));
КонецФункции

// Возвращает копию исходных замеров памяти выполнения
//
// Возвращаемое значение:
//   Массив из Число
Функция ЗамерыПамяти() Экспорт
	Возврат Новый Массив(Новый ФиксированныйМассив(_КаноническоеСостояние.ЗамерыПамяти));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Сериализация

// Возвращает стандартный набор процентилей в текущей единице времени.
//
// Возвращаемое значение:
//   Структура - P0, P25, P50, P67, P80, P85, P90, P95, P100 - Число
&Сериализуемое("Percentiles")
Функция ПолучитьПроцентили() Экспорт

	Процентили = Новый Структура("P0, P25, P50, P67, P80, P85, P90, P95, P100");

	Для Каждого Строка Из Процентили Цикл
		Процент = Число(Сред(Строка.Ключ, 2));
		Процентили[Строка.Ключ] = Квантиль(Процент / 100);
	КонецЦикла;

	Возврат Процентили;
	
КонецФункции

#КонецОбласти

Процедура Рассчитать(ЗамерыВремени, ЗамерыПамяти)

	Состояние = Новый Структура();
	Состояние.Вставить("ЗамерыВремени", ЗамерыВремени);
	Состояние.Вставить("ЗамерыПамяти", ЗамерыПамяти);
	Состояние.Вставить("УпорядоченныеЗамерыВремени", УпорядочитьЗамерыВремени(ЗамерыВремени));
	Состояние.Вставить("КоличествоИтераций", ЗамерыВремени.Количество());

	НаносекундВСекунде = ЕдиницыИзмеренийБенчмарков.Секунда.ОтношениеКБазовой;

	ПоказателиВремени = Новый Структура();
	ПоказателиВремени.Вставить("Среднее", Math.Среднее(ЗамерыВремени));
	ПоказателиВремени.Вставить("СтандартноеОтклонение",
		Math.НольЕслиНеопределено(Math.СтандартноеОтклонение(ЗамерыВремени))
	);
	ПоказателиВремени.Вставить("СтандартнаяОшибкаСреднего", Math.СтандартнаяОшибкаСреднего(
		ПоказателиВремени.СтандартноеОтклонение,
		Состояние.КоличествоИтераций
	));

	Если Состояние.КоличествоИтераций < 2 Тогда
		ПоказателиВремени.Вставить("ПогрешностьСреднего", Неопределено);
		ПоказателиВремени.Вставить("НижняяГраницаДоверительногоИнтервала", Неопределено);
		ПоказателиВремени.Вставить("ВерхняяГраницаДоверительногоИнтервала", Неопределено);
		ОтносительнаяПогрешность = Неопределено;
	Иначе
		ПогрешностьСреднего = Math.КритическоеЗначениеСтьюдента999(Состояние.КоличествоИтераций - 1)
			* ПоказателиВремени.СтандартнаяОшибкаСреднего;
		ПоказателиВремени.Вставить("ПогрешностьСреднего", ПогрешностьСреднего);
		ПоказателиВремени.Вставить("НижняяГраницаДоверительногоИнтервала",
			ПоказателиВремени.Среднее - ПогрешностьСреднего);
		ПоказателиВремени.Вставить("ВерхняяГраницаДоверительногоИнтервала",
			ПоказателиВремени.Среднее + ПогрешностьСреднего);
		ОтносительнаяПогрешность = ?(
			ПоказателиВремени.Среднее > 0,
			ПогрешностьСреднего / ПоказателиВремени.Среднее,
			Неопределено
		);
	КонецЕсли;

	Квартили = Math.Квартили(Состояние.УпорядоченныеЗамерыВремени);

	ПоказателиВремени.Вставить("Мин", Math.НольЕслиНеопределено(Квартили.Q0));
	ПоказателиВремени.Вставить("НижнийКвартиль", Math.НольЕслиНеопределено(Квартили.Q1));
	ПоказателиВремени.Вставить("Медиана", Math.НольЕслиНеопределено(Квартили.Q2));
	ПоказателиВремени.Вставить("ВерхнийКвартиль", Math.НольЕслиНеопределено(Квартили.Q3));
	ПоказателиВремени.Вставить("Макс", Math.НольЕслиНеопределено(Квартили.Q4));

	Состояние.Вставить("ПоказателиВремени", Новый ФиксированнаяСтруктура(ПоказателиВремени));
	Состояние.Вставить("ОперацийВСекунду",
		?(ПоказателиВремени.Среднее = 0, 0, НаносекундВСекунде / ПоказателиВремени.Среднее));
	Состояние.Вставить("ВыделяемаяПамять", Math.Среднее(ЗамерыПамяти));
	Состояние.Вставить("ОтносительнаяПогрешность", ОтносительнаяПогрешность);
	Состояние.Вставить("КоличествоВыбросов", КоличествоВыбросовТьюки(
		ЗамерыВремени,
		ПоказателиВремени.НижнийКвартиль,
		ПоказателиВремени.ВерхнийКвартиль
	));

	ПрименитьКаноническоеСостояние(Новый ФиксированнаяСтруктура(Состояние));
	КонвертироватьВремя(_ТекущаяЕдиницаВремени);

КонецПроцедуры

Процедура ПрименитьКаноническоеСостояние(Состояние)

	_КаноническоеСостояние = Состояние;
	_ЗамерыВремени = Состояние.ЗамерыВремени;
	_ВременныеПоказателиИнициализированы = Ложь;

	КоличествоИтераций = Состояние.КоличествоИтераций;
	ОперацийВСекунду = Состояние.ОперацийВСекунду;
	ВыделяемаяПамять = Состояние.ВыделяемаяПамять;
	ОтносительнаяПогрешность = Состояние.ОтносительнаяПогрешность;
	КоличествоВыбросов = Состояние.КоличествоВыбросов;

КонецПроцедуры

Функция КопияВЕдиницеВремени(Единица)

	Замеры = Новый Структура(
		"ЗамерыВремени,ЗамерыПамяти",
		_КаноническоеСостояние.ЗамерыВремени,
		_КаноническоеСостояние.ЗамерыПамяти
	);

	Копия = Новый СтатистикаБенчмарка(Замеры);
	Возврат Копия.УстановитьЕдиницуВремени(Единица);

КонецФункции

Процедура КонвертироватьВремя(Единица)

	Если Не ТипЗнч(Единица) = Тип("ЕдиницаИзмеренияБенчмарка") Тогда
		ВызватьИсключение "Ожидается единица измерения времени";
	КонецЕсли;

	Если Не Единица = ЕдиницыИзмеренийБенчмарков.Наносекунда
		И Не Единица.Базовая = ЕдиницыИзмеренийБенчмарков.Наносекунда Тогда
		ВызватьИсключение "Базовой единицей времени должна быть наносекунда";
	КонецЕсли;

	Если Не ТипЗнч(Единица.ОтношениеКБазовой) = Тип("Число") Тогда
		ВызватьИсключение "Отношение единицы времени к базовой должно быть положительным числом";
	КонецЕсли;

	Если Единица.ОтношениеКБазовой <= 0 Тогда
		ВызватьИсключение "Отношение единицы времени к базовой должно быть положительным числом";
	КонецЕсли;

	Если _ТекущаяЕдиницаВремени = Единица
		И _ВременныеПоказателиИнициализированы Тогда
		Возврат;
	КонецЕсли;

	ПоказателиВремени = Новый Структура();
	Для Каждого Имя Из ИменаПолейВремени() Цикл
		Если _КаноническоеСостояние.ПоказателиВремени[Имя] = Неопределено Тогда
			ПоказателиВремени.Вставить(Имя, Неопределено);
		Иначе
			ПоказателиВремени.Вставить(Имя, ЕдиницыИзмеренийБенчмарков.Конвертировать(
				_КаноническоеСостояние.ПоказателиВремени[Имя],
				ЕдиницыИзмеренийБенчмарков.Наносекунда,
				Единица
			));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Показатель Из ПоказателиВремени Цикл
		ЭтотОбъект[Показатель.Ключ] = Показатель.Значение;
	КонецЦикла;

	_ТекущаяЕдиницаВремени = Единица;
	_ВременныеПоказателиИнициализированы = Истина;

КонецПроцедуры

Функция ИменаПолейВремени()
	
	Результат = Новый Массив();
	Результат.Добавить("Среднее");
	Результат.Добавить("СтандартноеОтклонение");
	Результат.Добавить("СтандартнаяОшибкаСреднего");
	Результат.Добавить("НижняяГраницаДоверительногоИнтервала");
	Результат.Добавить("ВерхняяГраницаДоверительногоИнтервала");
	Результат.Добавить("ПогрешностьСреднего");
	Результат.Добавить("Медиана");
	Результат.Добавить("НижнийКвартиль");
	Результат.Добавить("ВерхнийКвартиль");
	Результат.Добавить("Мин");
	Результат.Добавить("Макс");

	Возврат Результат;

КонецФункции

Функция КоличествоВыбросовТьюки(ЗамерыВремени, НижнийКвартиль, ВерхнийКвартиль)

	Границы = Math.ГраницыВыбросовТьюки(НижнийКвартиль, ВерхнийКвартиль);
	Результат = 0;

	Для Каждого ЗамерВремени Из ЗамерыВремени Цикл
		Если Math.ЭтоВыбросТьюки(ЗамерВремени, Границы.НижняяГраница, Границы.ВерхняяГраница) Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВыгрузитьЗамеры(Замеры, Колонка, Этап)

	Результат = Новый Массив();

	Для Каждого Замер Из Замеры Цикл
		Если Замер.Этап = Этап Тогда
			Результат.Добавить(Замер[Колонка]);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УпорядочитьЗамерыВремени(ЗамерыВремени)

	СписокЗначений = Новый СписокЗначений();
	СписокЗначений.ЗагрузитьЗначения(ЗамерыВремени);
	СписокЗначений.СортироватьПоЗначению();

	Возврат СписокЗначений.ВыгрузитьЗначения();

КонецФункции

#КонецОбласти
