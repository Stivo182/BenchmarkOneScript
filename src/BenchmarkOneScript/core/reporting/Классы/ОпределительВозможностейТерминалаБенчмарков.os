#Область ПрограммныйИнтерфейс

// Определяет профиль символов для текущего консольного вывода.
//
// Возвращаемое значение:
//   Структура - Маркеры предупреждения и информации.
Функция Определить() Экспорт

	Возврат ОпределитьДляКодировки(Консоль.КодировкаВыходногоПотока);

КонецФункции

// Определяет профиль символов для указанной кодировки.
//
// Параметры:
//   Кодировка - КодировкаТекста - Кодировка консольного вывода.
//
// Возвращаемое значение:
//   Структура - Маркеры предупреждения и информации.
Функция ОпределитьДляКодировки(Кодировка) Экспорт

	ЭтоЮникод = Кодировка = КодировкаТекста.UTF8
		Или Кодировка = КодировкаТекста.UTF8NoBOM
		Или Кодировка = КодировкаТекста.UTF16;

	Если ЭтоЮникод Тогда
		Возврат Новый Структура("Предупреждение, Информация", "⚠ ", "💡︎");
	КонецЕсли;

	Возврат Новый Структура("Предупреждение, Информация", "[!]", "[i]");

КонецФункции

#КонецОбласти
