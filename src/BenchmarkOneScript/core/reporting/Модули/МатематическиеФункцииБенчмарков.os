#Область ПрограммныйИнтерфейс

Функция Сумма(Значения) Экспорт
	
	Результат = 0;
	Для Каждого Значение Из Значения Цикл
		Результат = Результат + Значение;	
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Функция Среднее(Значения) Экспорт
	
	Количество = Значения.Количество();
	
	Если Количество = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Сумма(Значения) / Количество;
	
КонецФункции

Функция Дисперсия(Значения) Экспорт
	
	Количество = Значения.Количество();
	
	Если Количество = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Количество = 1 Тогда
		Возврат 0;
	КонецЕсли;

	Среднее = Среднее(Значения);
	
	Результат = 0;
	Для Инд = 0 По Количество - 1 Цикл	
		Результат = Результат + Pow(Значения[Инд] - Среднее, 2);	
	КонецЦикла;	

	Результат = Результат / (Количество - 1);
	
	Возврат Результат;
	
КонецФункции

Функция СтандартноеОтклонение(Значения) Экспорт
	
	Дисперсия = Дисперсия(Значения);
	
	Если Дисперсия = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Возврат Sqrt(Дисперсия);
	
КонецФункции

Функция СтандартнаяОшибкаСреднего(СтандартноеОтклонение, Количество) Экспорт

	Если Количество = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат СтандартноеОтклонение / Sqrt(Количество);

КонецФункции

// Возвращает критическое значение распределения Стьюдента для двустороннего
// доверительного интервала уровня 99,9%.
//
// Параметры:
//   СтепениСвободы - Число - Число степеней свободы выборки.
//
// Возвращаемое значение:
//   Число - Критическое значение распределения Стьюдента.
Функция КритическоеЗначениеСтьюдента999(СтепениСвободы) Экспорт

	Если СтепениСвободы < 1 Тогда
		Возврат Неопределено;
	ИначеЕсли СтепениСвободы = 1 Тогда
		Возврат 636.619;
	ИначеЕсли СтепениСвободы = 2 Тогда
		Возврат 31.599;
	ИначеЕсли СтепениСвободы = 3 Тогда
		Возврат 12.924;
	ИначеЕсли СтепениСвободы = 4 Тогда
		Возврат 8.610;
	ИначеЕсли СтепениСвободы = 5 Тогда
		Возврат 6.869;
	ИначеЕсли СтепениСвободы = 6 Тогда
		Возврат 5.959;
	ИначеЕсли СтепениСвободы = 7 Тогда
		Возврат 5.408;
	ИначеЕсли СтепениСвободы = 8 Тогда
		Возврат 5.041;
	ИначеЕсли СтепениСвободы = 9 Тогда
		Возврат 4.781;
	ИначеЕсли СтепениСвободы = 10 Тогда
		Возврат 4.587;
	ИначеЕсли СтепениСвободы = 11 Тогда
		Возврат 4.437;
	ИначеЕсли СтепениСвободы = 12 Тогда
		Возврат 4.318;
	ИначеЕсли СтепениСвободы = 13 Тогда
		Возврат 4.221;
	ИначеЕсли СтепениСвободы = 14 Тогда
		Возврат 4.140;
	КонецЕсли;

	КвантильНормальногоРаспределения = 3.290526731;
	СтепениВКвадрате = Pow(СтепениСвободы, 2);
	СтепениВКубе = Pow(СтепениСвободы, 3);

	Возврат КвантильНормальногоРаспределения
		+ (Pow(КвантильНормальногоРаспределения, 3) + КвантильНормальногоРаспределения) / (4 * СтепениСвободы)
		+ (5 * Pow(КвантильНормальногоРаспределения, 5) + 16 * Pow(КвантильНормальногоРаспределения, 3) + 3 * КвантильНормальногоРаспределения) / (96 * СтепениВКвадрате)
		+ (3 * Pow(КвантильНормальногоРаспределения, 7) + 19 * Pow(КвантильНормальногоРаспределения, 5) + 17 * Pow(КвантильНормальногоРаспределения, 3) - 15 * КвантильНормальногоРаспределения) / (384 * СтепениВКубе);

КонецФункции

Функция ГраницыВыбросовТьюки(НижнийКвартиль, ВерхнийКвартиль) Экспорт

	МежквартильныйРазмах = ВерхнийКвартиль - НижнийКвартиль;
	Возврат Новый Структура(
		"НижняяГраница,ВерхняяГраница",
		НижнийКвартиль - 1.5 * МежквартильныйРазмах,
		ВерхнийКвартиль + 1.5 * МежквартильныйРазмах
	);

КонецФункции

Функция ЭтоВыбросТьюки(Значение, НижняяГраница, ВерхняяГраница) Экспорт
	Возврат Значение < НижняяГраница Или Значение > ВерхняяГраница;
КонецФункции

Функция Квартили(УпорядоченныеЗначения) Экспорт
	
	Квартили = Новый Структура();
	// BSLLS:MagicNumber-off
	Квартили.Вставить("Q0", Квантиль(УпорядоченныеЗначения, 0));
	Квартили.Вставить("Q1", Квантиль(УпорядоченныеЗначения, 0.25));
	Квартили.Вставить("Q2", Квантиль(УпорядоченныеЗначения, 0.5));
	Квартили.Вставить("Q3", Квантиль(УпорядоченныеЗначения, 0.75));
	Квартили.Вставить("Q4", Квантиль(УпорядоченныеЗначения, 1));
	// BSLLS:MagicNumber-on

	Возврат Квартили;

КонецФункции

Функция Квантиль(УпорядоченныеЗначения, Вероятность) Экспорт

	Количество = УпорядоченныеЗначения.Количество();

	Если Количество = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Позиция = Вероятность * (Количество - 1);

	ИндексПозиции = Цел(Позиция);
	ДробнаяЧасть = Позиция - ИндексПозиции;

	Если ИндексПозиции < 0 Тогда 
		Возврат УпорядоченныеЗначения[0];
	ИначеЕсли ИндексПозиции >= Количество - 1 Тогда
		Возврат УпорядоченныеЗначения[Количество - 1];
	Иначе
		НижнееЗначение = УпорядоченныеЗначения[ИндексПозиции];
		ВерхнееЗначение = УпорядоченныеЗначения[ИндексПозиции + 1];
		Возврат НижнееЗначение + ДробнаяЧасть * (ВерхнееЗначение - НижнееЗначение);
	КонецЕсли;

КонецФункции

Функция ТолькоЧисла(Значения) Экспорт

	ТипЧисло = Тип("Число");

	Для Каждого Значение Из Значения Цикл
		Если Не ТипЗнч(Значение) = ТипЧисло Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция Разделить(ЗначенияЧислителя, ЗначенияЗнаменателя) Экспорт

	Результат = Новый Массив();

	Для Каждого ЗначениеЧислитель Из ЗначенияЧислителя Цикл
		Для Каждого ЗначениеЗнаменатель Из ЗначенияЗнаменателя Цикл
			Если Не ЗначениеЗнаменатель = 0 Тогда
				Результат.Добавить(ЗначениеЧислитель / ЗначениеЗнаменатель);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Abs(Значение) Экспорт
	Возврат ?(Значение < 0, -Значение, Значение);
КонецФункции

Функция НольЕслиНеопределено(Значение) Экспорт
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

// Оценивает различие независимых выборок времени выполнения критерием Манна - Уитни
// и проверяет их практическую эквивалентность двусторонним TOST.
//
// Параметры:
//   ТекущиеЗамеры                 - Массив - Измерения сравниваемого кейса.
//   ЭталонныеЗамеры               - Массив - Измерения эталонного кейса.
//   ПорогПрактическойЗначимости   - Число - Допустимое относительное различие замеров.
//   УровеньЗначимости             - Число - Уровень значимости критерия Манна - Уитни.
//
// Возвращаемое значение:
//   Строка - см. РезультатыСравненияБенчмарков.
Функция ОценитьРазличиеПоКритериюМаннаУитни(ТекущиеЗамеры, ЭталонныеЗамеры, ПорогПрактическойЗначимости, УровеньЗначимости) Экспорт

	МинимальноеКоличествоЗамеровДляСравнения = 15;
	Если ТекущиеЗамеры.Количество() < МинимальноеКоличествоЗамеровДляСравнения
		Или ЭталонныеЗамеры.Количество() < МинимальноеКоличествоЗамеровДляСравнения Тогда
		Возврат РезультатыСравненияБенчмарков.НедостаточноДанных();
	КонецЕсли;

	Если Среднее(ТекущиеЗамеры) <= 0 Или Среднее(ЭталонныеЗамеры) <= 0 Тогда
		Возврат РезультатыСравненияБенчмарков.НедостаточноДанных();
	КонецЕсли;

	МножительВерхнейГраницы = 1 + ПорогПрактическойЗначимости;
	МножительНижнейГраницы = 1 - ПорогПрактическойЗначимости;

	Если ВероятностьОдностороннегоПревышения(
		ТекущиеЗамеры,
		УмножитьЗамеры(ЭталонныеЗамеры, МножительВерхнейГраницы)
	) < УровеньЗначимости Тогда
		Возврат РезультатыСравненияБенчмарков.Медленнее();
	КонецЕсли;

	Если ВероятностьОдностороннегоПревышения(
		УмножитьЗамеры(ЭталонныеЗамеры, МножительНижнейГраницы),
		ТекущиеЗамеры
	) < УровеньЗначимости Тогда
		Возврат РезультатыСравненияБенчмарков.Быстрее();
	КонецЕсли;

	ГраницаЭквивалентностиСнизуДостигнута = ВероятностьОдностороннегоПревышения(
		ТекущиеЗамеры,
		УмножитьЗамеры(ЭталонныеЗамеры, МножительНижнейГраницы)
	) < УровеньЗначимости;

	ГраницаЭквивалентностиСверхуДостигнута = ВероятностьОдностороннегоПревышения(
		УмножитьЗамеры(ЭталонныеЗамеры, МножительВерхнейГраницы),
		ТекущиеЗамеры
	) < УровеньЗначимости;

	Если ГраницаЭквивалентностиСнизуДостигнута И ГраницаЭквивалентностиСверхуДостигнута Тогда
		Возврат РезультатыСравненияБенчмарков.ПрактическиОдинаково();
	КонецЕсли;

	Возврат РезультатыСравненияБенчмарков.РазличиеНеОбнаружено();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВероятностьОдностороннегоПревышения(ПервыеЗамеры, ВторыеЗамеры)

	ПобедыПервыхЗамеров = 0;
	Для Каждого ПервыйЗамер Из ПервыеЗамеры Цикл
		Для Каждого ВторойЗамер Из ВторыеЗамеры Цикл
			Если ПервыйЗамер > ВторойЗамер Тогда
				ПобедыПервыхЗамеров = ПобедыПервыхЗамеров + 1;
			ИначеЕсли ПервыйЗамер = ВторойЗамер Тогда
				ПобедыПервыхЗамеров = ПобедыПервыхЗамеров + 0.5;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	КоличествоПервыхЗамеров = ПервыеЗамеры.Количество();
	КоличествоВторыхЗамеров = ВторыеЗамеры.Количество();
	ОжидаемоеЗначение = КоличествоПервыхЗамеров * КоличествоВторыхЗамеров / 2;
	КоличествоВсехЗамеров = КоличествоПервыхЗамеров + КоличествоВторыхЗамеров;
	КорректировкаСвязанныхРангов = ПоправкаНаСвязанныеРанги(ПервыеЗамеры, ВторыеЗамеры);
	Дисперсия = КоличествоПервыхЗамеров * КоличествоВторыхЗамеров / 12
		* (
			КоличествоВсехЗамеров + 1
			- КорректировкаСвязанныхРангов / (КоличествоВсехЗамеров * (КоличествоВсехЗамеров - 1))
		);

	Если Дисперсия <= 0 Тогда
		Возврат 1;
	КонецЕсли;

	Z = (ПобедыПервыхЗамеров - ОжидаемоеЗначение - 0.5) / Sqrt(Дисперсия);
	Возврат 1 - ВероятностьСтандартногоНормальногоРаспределения(Z);

КонецФункции

Функция УмножитьЗамеры(Замеры, Множитель)

	Результат = Новый Массив();
	Для Каждого Замер Из Замеры Цикл
		Результат.Добавить(Замер * Множитель);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПоправкаНаСвязанныеРанги(ТекущиеЗамеры, ЭталонныеЗамеры)

	ВсеЗамеры = Новый Массив();
	Для Каждого Замер Из ТекущиеЗамеры Цикл
		ВсеЗамеры.Добавить(Замер);
	КонецЦикла;

	Для Каждого Замер Из ЭталонныеЗамеры Цикл
		ВсеЗамеры.Добавить(Замер);
	КонецЦикла;

	Поправка = 0;
	Для Индекс = 0 По ВсеЗамеры.Количество() - 1 Цикл
		Значение = ВсеЗамеры[Индекс];
		УжеУчтено = Ложь;

		Для ПредыдущийИндекс = 0 По Индекс - 1 Цикл
			Если ВсеЗамеры[ПредыдущийИндекс] = Значение Тогда
				УжеУчтено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если УжеУчтено Тогда
			Продолжить;
		КонецЕсли;

		КоличествоСвязанныхРангов = 0;
		Для Каждого СравниваемоеЗначение Из ВсеЗамеры Цикл
			Если СравниваемоеЗначение = Значение Тогда
				КоличествоСвязанныхРангов = КоличествоСвязанныхРангов + 1;
			КонецЕсли;
		КонецЦикла;

		Поправка = Поправка + Pow(КоличествоСвязанныхРангов, 3) - КоличествоСвязанныхРангов;
	КонецЦикла;

	Возврат Поправка;

КонецФункции

Функция ВероятностьСтандартногоНормальногоРаспределения(Значение)

	Если Значение < 0 Тогда
		Возврат 1 - ВероятностьСтандартногоНормальногоРаспределения(-Значение);
	КонецЕсли;

	Коэффициент = 1 / (1 + 0.2316419 * Значение);
	Плотность = 0.3989422804 * Exp(-Значение * Значение / 2);

	Возврат 1 - Плотность * Коэффициент * (
		0.319381530
		+ Коэффициент * (-0.356563782
		+ Коэффициент * (1.781477937
		+ Коэффициент * (-1.821255978
		+ Коэффициент * 1.330274429)))
	);

КонецФункции

#КонецОбласти
