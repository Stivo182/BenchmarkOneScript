Перем _ПутьКТочкеВходаПриложения; // Строка, Неопределено

#Область ОбработчикиСобытий

// Инициализирует перезапускатель приложения с окружением OneScript.
// Точка входа определяется по расположению сценария класса при подготовке повторного запуска.
Процедура ПриСозданииОбъекта()

	_ПутьКТочкеВходаПриложения = Неопределено;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Перезапускает приложение с указанными файлами конфигурации и директивами OneScript.
//
// Параметры:
//   ФайлыКонфигурацииOneScript - Массив из Строка - Пути к файлам oscript.cfg
//     в порядке убывания приоритета
//   ДирективыИспользованияБенчмарков - Массив из Массив из Строка, Неопределено - Директивы
//     использования, сгруппированные по файлам бенчмарков
//
// Возвращаемое значение:
//   Число, Неопределено - Код возврата дочернего процесса или Неопределено,
//                         если повторный запуск не требуется
Функция ПерезапуститьСОкружениемOneScript(
	ФайлыКонфигурацииOneScript,
	ДирективыИспользованияБенчмарков = Неопределено
) Экспорт

	Если ПолучитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED") = "1" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ТребуетсяПерезапуск(ФайлыКонфигурацииOneScript, ДирективыИспользованияБенчмарков) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗапуститьСОкружением(ФайлыКонфигурацииOneScript, ДирективыИспользованияБенчмарков);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТребуетсяПерезапуск(ФайлыКонфигурацииOneScript, ДирективыИспользованияБенчмарков)

	Если ФайлыКонфигурацииOneScript.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если ДирективыИспользованияБенчмарков <> Неопределено
		И ДирективыИспользованияБенчмарков.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ТекущаяКонфигурация = Новый Файл(ОбъединитьПути(ТекущийКаталог(), "oscript.cfg"));
	Возврат ТекущаяКонфигурация.Существует() И ТекущаяКонфигурация.ЭтоФайл();

КонецФункции

Функция ЗапуститьСОкружением(ФайлыКонфигурацииOneScript, ДирективыИспользованияБенчмарков)

	ПутьКТочкеВхода = ПодготовитьТочкуВхода(ДирективыИспользованияБенчмарков);

	Попытка
		МенеджерПараметров = Новый МенеджерПараметровКонфигурацииOneScript(ФайлыКонфигурацииOneScript);
		ПараметрыКонфигурацииOneScript = ПараметрыКонфигурацииДляПеременнойСреды(МенеджерПараметров.Прочитать());

		Если ЭтоВременнаяТочкаВхода(ПутьКТочкеВхода) Тогда
			МенеджерПараметров.ЗаписатьВКаталог(Новый Файл(ПутьКТочкеВхода).Путь);
		КонецЕсли;

		Процесс = СоздатьИЗапуститьПроцесс(
			ПутьКТочкеВхода,
			ТекущийКаталог(),
			ПараметрыКонфигурацииOneScript
		);

		ОжидатьЗавершениеПроцесса(Процесс);
	Исключение
		УдалитьВременнуюТочкуВхода(ПутьКТочкеВхода);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременнуюТочкуВхода(ПутьКТочкеВхода);

	Возврат Процесс.КодВозврата;

КонецФункции

Функция ПодготовитьТочкуВхода(ДирективыИспользованияБенчмарков)

	ПутьКОсновнойТочкеВхода = ПутьКТочкеВходаПриложения();
	Если ДирективыИспользованияБенчмарков = Неопределено
		Или ДирективыИспользованияБенчмарков.Количество() = 0 Тогда
		Возврат ПутьКОсновнойТочкеВхода;
	КонецЕсли;

	СтрокиСценария = Новый Массив();
	КаталогВременнойТочкиВхода = ПолучитьИмяВременногоФайла("benchos-точка-входа");
	СоздатьКаталог(КаталогВременнойТочкиВхода);
	ПутьКВременнойТочкеВхода = ОбъединитьПути(КаталогВременнойТочкиВхода, "ТочкаВхода.os");

	Попытка
		НомерНабора = 0;
		Для Каждого ДирективыФайла Из ДирективыИспользованияБенчмарков Цикл
			НомерНабора = НомерНабора + 1;
			ПутьКСценариюЗависимостей = ОбъединитьПути(
				КаталогВременнойТочкиВхода,
				"Зависимости" + Строка(НомерНабора) + ".os"
			);
			ЗаписатьСценарий(ПутьКСценариюЗависимостей, ДирективыФайла);

			СтрокиСценария.Добавить(СтрШаблон(
				"Попытка
				|    ЗагрузитьСценарий(""%1"");
				|Исключение
				|КонецПопытки;",
				ЭкранироватьКавычки(ПутьКСценариюЗависимостей)
			));
		КонецЦикла;

		СтрокиСценария.Добавить(
			"ЗагрузитьСценарий(""" + ЭкранироватьКавычки(ПутьКОсновнойТочкеВхода) + """);");
		ЗаписатьСценарий(ПутьКВременнойТочкеВхода, СтрокиСценария);
	Исключение
		УдалитьФайлы(КаталогВременнойТочкиВхода);
		ВызватьИсключение;
	КонецПопытки;

	Возврат ПутьКВременнойТочкеВхода;

КонецФункции

Процедура ЗаписатьСценарий(ПутьКФайлу, СтрокиСценария)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(СтрСоединить(СтрокиСценария, Символы.ПС));
	ЗаписьТекста.Закрыть();

КонецПроцедуры

Процедура УдалитьВременнуюТочкуВхода(ПутьКТочкеВхода)

	Если ЭтоВременнаяТочкаВхода(ПутьКТочкеВхода) Тогда
		УдалитьФайлы(Новый Файл(ПутьКТочкеВхода).Путь);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоВременнаяТочкаВхода(ПутьКТочкеВхода)

	Возврат ПутьКТочкеВхода <> ПутьКТочкеВходаПриложения();

КонецФункции

Функция ЭкранироватьКавычки(Значение)

	Кавычка = """";
	Возврат СтрЗаменить(Значение, Кавычка, Кавычка + Кавычка);

КонецФункции

Функция ПутьКТочкеВходаПриложения()

	Если _ПутьКТочкеВходаПриложения <> Неопределено Тогда
		Возврат _ПутьКТочкеВходаПриложения;
	КонецЕсли;

	_ПутьКТочкеВходаПриложения = Новый Файл(
		ОбъединитьПути(ТекущийСценарий().Каталог, "..", "main.os")
	).ПолноеИмя;

	Возврат _ПутьКТочкеВходаПриложения;

КонецФункции

Функция ПараметрыКонфигурацииДляПеременнойСреды(Параметры)

	ЧастиКонфигурации = Новый Массив();
	Для Каждого Параметр Из Параметры Цикл
		ЧастиКонфигурации.Добавить(СтрШаблон(
			"%1=%2",
			Параметр.Ключ,
			ЗначениеКонфигурацииДляПеременнойСреды(Параметр.Значение)
		));
	КонецЦикла;

	Возврат СтрСоединить(ЧастиКонфигурации, ";");

КонецФункции

Функция ЗначениеКонфигурацииДляПеременнойСреды(Значение)

	Кавычка = """";
	ЭкранированноеЗначение = СтрЗаменить(Строка(Значение), Кавычка, Кавычка + Кавычка);

	Возврат Кавычка + ЭкранированноеЗначение + Кавычка;

КонецФункции

Функция СоздатьИЗапуститьПроцесс(ПутьКТочкеВхода, РабочийКаталог, ПараметрыКонфигурацииOneScript)

	ЛокаторИсполняющейСреды = Новый ЛокаторИсполняющейСреды();
	ПутьИсполняемогоФайла = ЛокаторИсполняющейСреды.НайтиИсполняемыйФайлВКаталоге(КаталогПрограммы());

	ЧастиКоманды = Новый Массив();
	// OneScript извлекает executable до разбора аргументов и снимает только двойные кавычки.
	ЧастиКоманды.Добавить(
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки(
			ПутьИсполняемогоФайла
		)
	);
	ЧастиКоманды.Добавить(
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
			ПутьКТочкеВхода
		)
	);

	Для Каждого Аргумент Из АргументыКоманднойСтроки Цикл
		ЧастиКоманды.Добавить(
			ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
				Аргумент
			)
		);
	КонецЦикла;

	ПеременныеСредыПроцесса = ПеременныеСреды();
	ПеременныеСредыПроцесса.Вставить("BENCHOS_OSCRIPT_CONFIG_APPLIED", "1");
	ПеременныеСредыПроцесса.Вставить("OSCRIPT_CONFIG", ПараметрыКонфигурацииOneScript);

	Процесс = СоздатьПроцесс(
		СтрСоединить(ЧастиКоманды, " "),
		РабочийКаталог,
		Ложь,
		Ложь,
		,
		ПеременныеСредыПроцесса
	);

	Процесс.Запустить();

	Возврат Процесс;

КонецФункции

Процедура ОжидатьЗавершениеПроцесса(Процесс)

	Пока Не Процесс.Завершен Цикл
		Приостановить(100);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
