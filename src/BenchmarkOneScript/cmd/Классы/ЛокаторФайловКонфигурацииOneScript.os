#Использовать fs

#Область ПрограммныйИнтерфейс

// Находит файлы конфигурации OneScript для переданных файлов и каталогов бенчмарков.
// Каждый файл возвращается один раз в порядке первого появления. Порядок определяется
// порядком элементов МассивФайлов и нормализованными полными путями файлов внутри каталога.
//
// Параметры:
//   МассивФайлов - Массив из Строка - Пути к файлам и каталогам бенчмарков
//   Рекурсивно   - Булево            - Искать файлы бенчмарков во вложенных каталогах
//
// Возвращаемое значение:
//   Массив из Строка - Уникальные нормализованные полные пути к файлам oscript.cfg
//     в порядке первого появления
Функция НайтиФайлыКонфигурации(МассивФайлов, Рекурсивно = Ложь) Экспорт

	ФайлыКонфигурации = Новый Массив();
	ДобавленныеФайлы = Новый Соответствие();
	РазрешательВходныхФайлов = Новый РазрешательВходныхФайловБенчмарков();
	РазрешенныеВходы = РазрешательВходныхФайлов.Разрешить(МассивФайлов, Рекурсивно);

	Для Каждого РазрешенныйВход Из РазрешенныеВходы Цикл

		Если Не РазрешенныйВход.Разрешен Тогда
			Продолжить;
		КонецЕсли;

		Если РазрешенныйВход.ВходнойКаталог <> Неопределено Тогда
			ДобавитьФайлКонфигурации(
				РазрешенныйВход.ВходнойКаталог,
				ФайлыКонфигурации,
				ДобавленныеФайлы
			);
		КонецЕсли;

		Для Каждого ПолноеИмяФайла Из РазрешенныйВход.Файлы Цикл
			ДобавитьФайлКонфигурации(
				Новый Файл(ПолноеИмяФайла).Путь,
				ФайлыКонфигурации,
				ДобавленныеФайлы
			);
		КонецЦикла;

	КонецЦикла;

	Возврат ФайлыКонфигурации;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьФайлКонфигурации(Каталог, ФайлыКонфигурации, ДобавленныеФайлы)

	ПутьККонфигурации = ФС.НормализоватьПуть(ОбъединитьПути(Каталог, "oscript.cfg"));
	Если Не ФС.ФайлСуществует(ПутьККонфигурации) Тогда
		Возврат;
	КонецЕсли;

	КлючФайла = КлючДедупликацииФайла(ПутьККонфигурации);
	Если ДобавленныеФайлы.Получить(КлючФайла) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавленныеФайлы.Вставить(КлючФайла, Истина);
	ФайлыКонфигурации.Добавить(ПутьККонфигурации);

КонецПроцедуры

Функция КлючДедупликацииФайла(ПутьКФайлу)

	Если ЭтоWindows() Тогда
		Возврат НРег(ПутьКФайлу);
	КонецЕсли;

	Возврат ПутьКФайлу;

КонецФункции

Функция ЭтоWindows()

	ТекущаяПлатформа = Новый СистемнаяИнформация().ТипПлатформы;

	Возврат ТекущаяПлатформа = ТипПлатформы.Windows_x86_64
		Или ТекущаяПлатформа = ТипПлатформы.Windows_x86;

КонецФункции

#КонецОбласти
