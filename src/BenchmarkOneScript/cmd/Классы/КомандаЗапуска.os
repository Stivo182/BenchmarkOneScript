
// BSLLS:MissingVariablesDescription-off

&Опция(Имя = "r recursive", Описание = "Рекурсивный поиск в поддиректориях")
&Флаг
&ПоУмолчанию(Ложь)
Перем _Рекурсивно; // Булево

&Опция(Имя = "q quiet", Описание = "Отключить обычный консольный вывод")
&Флаг
&ПоУмолчанию(Ложь)
Перем _ТихийРежим; // Булево

&Опция(Имя = "no-progress", Описание = "Отключить вывод прогресса бенчмарков")
&Флаг
&ПоУмолчанию(Ложь)
Перем _НеВыводитьПрогресс; // Булево

&Опция(Имя = "m memory", Описание = "Включить мониторинг использования памяти")
&Флаг
Перем _МониторингПамяти; // Булево

&Опция(Имя = "iterationCount", Описание = "Количество измерительных итераций")
&ТЧисло
Перем _КоличествоИтераций; // Число

&Опция(Имя = "maxRelativeError", Описание = "Целевая относительная погрешность для адаптивных итераций")
&ТЧисло
Перем _МаксимальнаяОтносительнаяПогрешность; // Число

&Опция(Имя = "minAdaptiveIterationCount", Описание = "Минимальное количество адаптивных измерительных итераций")
&ТЧисло
Перем _МинимальноеКоличествоАдаптивныхИтераций; // Число

&Опция(Имя = "maxAdaptiveIterationCount", Описание = "Максимальное количество адаптивных измерительных итераций")
&ТЧисло
Перем _МаксимальноеКоличествоАдаптивныхИтераций; // Число

&Опция(Имя = "practicalSignificanceThreshold", Описание = "Относительный порог практической значимости")
&ТЧисло
Перем _ОтносительныйПорогПрактическойЗначимости; // Число

&Опция(Имя = "significanceLevel", Описание = "Уровень значимости статистического сравнения")
&ТЧисло
Перем _УровеньЗначимостиСтатистическогоСравнения; // Число

&Опция(Имя = "iterationTime", Описание = "Минимальное время выполнения одной итерации в миллисекундах")
&ТЧисло
Перем _МинимальноеВремяИтерации; // Число

&Опция(Имя = "warmupCount", Описание = "Количество прогревочных итераций")
&ТЧисло
Перем _КоличествоПрогревочныхИтераций; // Число

&Опция(Имя = "invocationCount", Описание = "Количество вызовов метода за итерацию")
&ТЧисло
Перем _КоличествоВызововЗаИтерацию; // Число

&Опция(Имя = "e exporters", Описание = "Форматы экспорта результатов через запятую (md, json, html)")
&ТСтрока
Перем _Экспортеры; // Строка

&Опция(Имя = "a artifacts", Описание = "Каталог для сохранения результатов")
&ТСтрока
Перем _КаталогАртефактов; // Строка

&Опция(Имя = "coldstart", Описание = "Стратегия 'Холодный запуск'")
&Флаг
Перем _ХолодныйЗапуск; // Булево, Неопределено

&Опция(Имя = "throughput", Описание = "Стратегия 'Пропускная способность'")
&Флаг
Перем _ПропускнаяСпособность; // Булево, Неопределено

&Опция(Имя = "p param", Описание = "Общий параметр бенчмарков в формате <Поле>=<Значение>")
&ТМассивСтрок
Перем _ПараметрыБенчмарков; // Массив из Строка

&Опция(Имя = "method", Описание = "Имена методов бенчмарков через запятую")
&ТМассивСтрок
Перем _МетодыБенчмарков; // Массив из Строка

&Опция(Имя = "category", Описание = "Категории бенчмарков через запятую")
&ТМассивСтрок
Перем _КатегорииБенчмарков; // Массив из Строка

&Опция(Имя = "settings", Описание = "Файл настроек запуска бенчмарков в формате JSON")
&ТСтрока
Перем _ФайлНастроекЗапуска; // Строка

&Опция(Имя = "runtime", Описание = "Версии OneScript через запятую (current, stable, dev, x.x.x)")
&ТСтрока
Перем _ИсполняющаяСреда; // Строка, Неопределено

&Опция(Имя = "debug", Описание = "Порт отладки")
&ТЧисло
&ПоУмолчанию(0)
Перем _ПортОтладки; // Число

&Аргумент(Имя = "FILE", Описание = "Каталог, полный путь к файлу или имя файла в текущей директории")
&ТМассивСтрок
Перем _МассивФайлов; // Массив из Строка

Перем _ПарсерПараметровБенчмарковCLI; // ПарсерПараметровБенчмарковCLI

// Инициализирует команду запуска бенчмарков.
&КомандаПриложения(Имя = "run", Описание = "Запуск бенчмарков")
Процедура ПриСозданииОбъекта()
	_ПарсерПараметровБенчмарковCLI = Новый ПарсерПараметровБенчмарковCLI();
КонецПроцедуры

// Запускает бенчмарки с учетом их локальных конфигураций OneScript.
&ВыполнениеКоманды 
Процедура Запустить() Экспорт

	Если ПолучитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED") <> "1" Тогда
		Перезапускатель = Новый ПерезапускательПриложенияOneScript();
		ПодготовительОкружения = Новый ПодготовительОкруженияЗапускаБенчмарков(_МассивФайлов, _Рекурсивно);
		ОкружениеЗапуска = ПодготовительОкружения.Подготовить();

		КодВозврата = Перезапускатель.ПерезапуститьСОкружениемOneScript(
			ОкружениеЗапуска.ФайлыКонфигурацииOneScript,
			ОкружениеЗапуска.ДирективыИспользованияБенчмарков
		);

		Если КодВозврата <> Неопределено Тогда
			ЗавершитьРаботу(КодВозврата);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Настройки = ПрочитатьНастройки();
	ПереопределенияКонфигурации = СформироватьПереопределенияКонфигурации();

	ФильтрБенчмарков = Новый ФильтрБенчмарков();
	ФильтрБенчмарков.УстановитьМетоды(
		_ПарсерПараметровБенчмарковCLI.РазобратьСписокЗначений(_МетодыБенчмарков, "--method")
	);
	ФильтрБенчмарков.УстановитьКатегории(
		_ПарсерПараметровБенчмарковCLI.РазобратьСписокЗначений(_КатегорииБенчмарков, "--category")
	);

	ДиспетчерСобытий = Новый ДиспетчерСобытийВыполненияБенчмарков();
	Если Не _ТихийРежим Тогда
		ДиспетчерСобытий.ДобавитьНаблюдатель(Новый КонсольныйНаблюдательВыполненияБенчмарков(Не _НеВыводитьПрогресс));
	КонецЕсли;

	ОрганизаторЗапускаФайловБенчмарков = Новый ОрганизаторЗапускаФайловБенчмарков(_МассивФайлов, _Рекурсивно, Настройки);
	ОрганизаторЗапускаФайловБенчмарков.УстановитьПереопределенияКонфигурации(ПереопределенияКонфигурации);
	ОрганизаторЗапускаФайловБенчмарков.УстановитьФильтрБенчмарков(ФильтрБенчмарков);
	ОрганизаторЗапускаФайловБенчмарков.УстановитьДиспетчерСобытий(ДиспетчерСобытий);
	
	Если _ПортОтладки > 0 Тогда
		ОрганизаторЗапускаФайловБенчмарков.УстановитьПортОтладки(_ПортОтладки);
	КонецЕсли;

	ОрганизаторЗапускаФайловБенчмарков.Запустить();

КонецПроцедуры

Функция ПрочитатьНастройки()

	Если Не ЗначениеЗаполнено(_ФайлНастроекЗапуска) Тогда
		Настройки = Новый НастройкиЗапускаБенчмарков();
	Иначе
		Сериализатор = Новый СериализаторНастроекЗапускаБенчмарков();
		Настройки = Сериализатор.ПрочитатьИзJson(_ФайлНастроекЗапуска);
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция СформироватьПереопределенияКонфигурации()

	Конфигурация = Новый КонфигурацияБенчмарков();
	ЗаполнитьКонфигурацию(Конфигурация);

	Возврат Конфигурация;

КонецФункции

Процедура ЗаполнитьКонфигурацию(Конфигурация)

	Если _МониторингПамяти = Истина Тогда
		Конфигурация.ДобавитьМониторингПамяти();
	КонецЕсли;

	Если ЭтоЧисло(_КоличествоИтераций) Тогда
		Конфигурация.УстановитьКоличествоИтераций(_КоличествоИтераций);
	КонецЕсли;

	Если ЭтоЧисло(_МаксимальнаяОтносительнаяПогрешность) Тогда
		Конфигурация.УстановитьЦелевуюОтносительнуюПогрешность(_МаксимальнаяОтносительнаяПогрешность);
	КонецЕсли;

	Если ЭтоЧисло(_МаксимальноеКоличествоАдаптивныхИтераций) Тогда
		Конфигурация.УстановитьМаксимальноеКоличествоАдаптивныхИтераций(_МаксимальноеКоличествоАдаптивныхИтераций);
	КонецЕсли;

	Если ЭтоЧисло(_МинимальноеКоличествоАдаптивныхИтераций) Тогда
		Конфигурация.УстановитьМинимальноеКоличествоАдаптивныхИтераций(_МинимальноеКоличествоАдаптивныхИтераций);
	КонецЕсли;

	Если ЭтоЧисло(_ОтносительныйПорогПрактическойЗначимости)
		Или ЭтоЧисло(_УровеньЗначимостиСтатистическогоСравнения) Тогда
		Конфигурация.ВключитьСтатистическоеСравнениеСЭталоном();
	КонецЕсли;

	Если ЭтоЧисло(_ОтносительныйПорогПрактическойЗначимости) Тогда
		Конфигурация.УстановитьОтносительныйПорогПрактическойЗначимости(_ОтносительныйПорогПрактическойЗначимости);
	КонецЕсли;

	Если ЭтоЧисло(_УровеньЗначимостиСтатистическогоСравнения) Тогда
		Конфигурация.УстановитьУровеньЗначимостиСтатистическогоСравнения(_УровеньЗначимостиСтатистическогоСравнения);
	КонецЕсли;

	Если ЭтоЧисло(_МинимальноеВремяИтерации) Тогда
		Конфигурация.УстановитьМинимальноеВремяИтерации(_МинимальноеВремяИтерации);
	КонецЕсли;

	Если ЭтоЧисло(_КоличествоПрогревочныхИтераций) Тогда
		Конфигурация.УстановитьКоличествоПрогревочныхИтераций(_КоличествоПрогревочныхИтераций);
	КонецЕсли;

	Если ЭтоЧисло(_КоличествоВызововЗаИтерацию) Тогда
		Конфигурация.УстановитьКоличествоВызововЗаИтерацию(_КоличествоВызововЗаИтерацию);
	КонецЕсли;

	Если ЗначениеЗаполнено(_КаталогАртефактов) Тогда
		Конфигурация.УстановитьКаталогАртефактов(_КаталогАртефактов);
	КонецЕсли;

	Если _ХолодныйЗапуск = Истина Тогда
		Конфигурация.УстановитьСтратегию(СтратегииЗапускаБенчмарка.ХолодныйЗапуск());
	КонецЕсли;

	Если _ПропускнаяСпособность = Истина Тогда
		Конфигурация.УстановитьСтратегию(СтратегииЗапускаБенчмарка.ПропускнаяСпособность());
	КонецЕсли;

	_ПарсерПараметровБенчмарковCLI.Применить(_ПараметрыБенчмарков, Конфигурация);
	ПрочитатьЭкспортеры(Конфигурация);
	ПрочитатьИсполняющуюСреду(Конфигурация);

КонецПроцедуры

Процедура ПрочитатьЭкспортеры(Конфигурация)

	Если Не ЗначениеЗаполнено(_Экспортеры) Тогда
		Возврат;
	КонецЕсли;

	ДопустимыеЗначения = Новый Соответствие();
	ДопустимыеЗначения.Вставить("md", "Markdown");
	ДопустимыеЗначения.Вставить("markdown", "Markdown");
	ДопустимыеЗначения.Вставить("json", "Json");
	ДопустимыеЗначения.Вставить("html", "Html");

	Для Каждого Экспортер Из СтрРазделить(_Экспортеры, ", ", Ложь) Цикл

		Имя = ДопустимыеЗначения[НРег(Экспортер)];

		ТекстОшибки = СтрШаблон("Неизвестный экспортер %1. Допустимые значения: md, json, html", Экспортер);
		Ожидаем.Что(Имя, ТекстОшибки).Заполнено();

		Конфигурация.ДобавитьЭкспортер(ЭкспортерыРезультатовБенчмарков[Имя]);

	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьИсполняющуюСреду(Конфигурация)
	
	Если Не ЗначениеЗаполнено(_ИсполняющаяСреда) Тогда
		Возврат;
	КонецЕсли;

	Конфигурация.ОчиститьИсполняющиеСреды();

	Если НРег(_ИсполняющаяСреда) = "current" Тогда
		Возврат;
	КонецЕсли;

	ИсполняющиеСреды = СтрРазделить(_ИсполняющаяСреда, ",", Ложь);
	Для Каждого Версия Из ИсполняющиеСреды Цикл
		Конфигурация.ДобавитьИсполняющуюСреду(СокрЛП(Версия));
	КонецЦикла;

КонецПроцедуры

Функция ЭтоЧисло(Значение)
	Возврат ТипЗнч(Значение) = Тип("Число");
КонецФункции
