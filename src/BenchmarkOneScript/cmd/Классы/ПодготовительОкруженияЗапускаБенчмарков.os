Перем _ВходныеПути; // Массив из Строка
Перем _Рекурсивно; // Булево

#Область ОбработчикиСобытий

// Инициализирует подготовитель окружения запуска бенчмарков.
//
// Параметры:
//   ВходныеПути - Массив из Строка - Пути к бенчмаркам и каталогам бенчмарков
//   Рекурсивно   - Булево           - Искать бенчмарки во вложенных каталогах
Процедура ПриСозданииОбъекта(ВходныеПути, Рекурсивно = Ложь)

	_ВходныеПути = ВходныеПути;
	_Рекурсивно = Рекурсивно;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Подготавливает настройки окружения OneScript для запуска бенчмарков.
//
// Возвращаемое значение:
//   Структура - Свойства:
//     * ФайлыКонфигурацииOneScript - Массив из Строка - Пути к файлам oscript.cfg
//     * ДирективыИспользованияБенчмарков - Массив из Массив из Строка - Директивы по файлам бенчмарков
Функция Подготовить() Экспорт

	РазрешенныеВходы = РазрешитьВходныеФайлыБенчмарков();
	ЛокаторФайловКонфигурации = Новый ЛокаторФайловКонфигурацииOneScript();

	Возврат Новый Структура(
		"ФайлыКонфигурацииOneScript, ДирективыИспользованияБенчмарков",
		ЛокаторФайловКонфигурации.НайтиФайлыКонфигурации(РазрешенныеВходы),
		ДирективыИспользованияБенчмарков(РазрешенныеВходы)
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьВходныеФайлыБенчмарков()

	РазрешательВходныхФайлов = Новый РазрешательВходныхФайловБенчмарков();
	Возврат РазрешательВходныхФайлов.Разрешить(_ВходныеПути, _Рекурсивно);

КонецФункции

Функция ДирективыИспользованияБенчмарков(РазрешенныеВходы)

	НаборыДиректив = Новый Массив();
	Для Каждого РазрешенныйВход Из РазрешенныеВходы Цикл
		Если Не РазрешенныйВход.Разрешен Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ПутьКФайлу Из РазрешенныйВход.Файлы Цикл
			АнализаторСценария = Новый АнализаторСценарияБенчмарка(ПутьКФайлу);
			Если РазрешенныйВход.ВходнойКаталог <> Неопределено
				И Не АнализаторСценария.СодержитБенчмарки() Тогда
				Продолжить;
			КонецЕсли;

			ДирективыФайла = АнализаторСценария.ДирективыИспользования();
			Если ДирективыФайла.Количество() > 0 Тогда
				НаборыДиректив.Добавить(ДирективыФайла);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат НаборыДиректив;

КонецФункции

#КонецОбласти
