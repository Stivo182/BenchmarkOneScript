	Ожидаем.Что(Результат).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОдинРазПерезапуститьRunСКонфигурациямиOneScript() Экспорт

	// Подготовка
	КаталогЗапуска = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	КаталогКоманд = ОбъединитьПути(КаталогПроекта, "src", "BenchmarkOneScript", "cmd");
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(ОбъединитьПути(КаталогКоманд, "main.os"));
	КаталогПервогоБенчмарка = ОбъединитьПути(КаталогЗапуска, "first benchmarks");
	КаталогЗависимостейПервогоБенчмарка = ОбъединитьПути(КаталогЗапуска, "first dependencies");
	ИмяКаталогаВторогоБенчмарка = "second benchmarks";
	КаталогВторогоБенчмарка = ОбъединитьПути(КаталогЗапуска, ИмяКаталогаВторогоБенчмарка);
	КаталогЗависимостейВторогоБенчмарка = ОбъединитьПути(КаталогЗапуска, "second dependencies");
	УстановитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED", "");

	ЗаписатьТекст(
		ОбъединитьПути(КаталогЗапуска, "oscript.cfg"),
		СтрШаблон(
			"lib.system=%1",
			ФС.НормализоватьПуть(ОбъединитьПути(КаталогПроекта, "oscript_modules"))
		)
	);
	СоздатьБенчмаркСЛокальнойЗависимостью(
		КаталогПервогоБенчмарка,
		"shareddependency",
		"ОбщаяЗависимость",
		"ПервыйБенчмарк",
		1,
		КаталогПервогоБенчмарка,
		КаталогЗависимостейПервогоБенчмарка
	);
	СоздатьБенчмаркСЛокальнойЗависимостью(
		КаталогВторогоБенчмарка,
		"shareddependency",
		"ОбщаяЗависимость",
		"ВторойБенчмарк",
		2,
		КаталогВторогоБенчмарка,
		КаталогЗависимостейВторогоБенчмарка
	);
	АргументВторогоБенчмарка =
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
			ИмяКаталогаВторогоБенчмарка + ПолучитьРазделительПути()
		);

	СтрокаКоманды = СтрШаблон(
		"%1 %2 run --iterationCount 1 --warmupCount 0 --invocationCount 1 --iterationTime 1 %3 %4",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
			ПутьКСтартовомуСценарию
		),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
			"first benchmarks"
		),
		АргументВторогоБенчмарка
	);
	УстановитьПеременнуюСреды("OSLIB_LOADER_TRACE", "1");

	// Действие
	Результат = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогЗапуска);

	// Проверка
	Ожидаем.Что(Результат.КодВозврата, Результат.Вывод).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("ПервыйБенчмарк");
	Ожидаем.Что(Результат.Вывод).Содержит("ВторойБенчмарк");
	Ожидаем.Что(Результат.Вывод).Не_().Содержит("Не удалось подключить файл бенчмарка");
	Ожидаем.Что(
		КоличествоЗагрузокБиблиотеки(Результат.Вывод, "cmd"),
		Результат.Вывод
	).Равно(2);
	Ожидаем.Что(ПолучитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED")).Не_().Заполнено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПереопределитьПараметрыИзНастроекПараметрамиCLI() Экспорт

	// Подготовка
	КаталогАртефактов = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКФайлуНастроек = _МенеджерВременныхФайлов.НовоеИмяФайла();

	Конфигурация = Новый КонфигурацияБенчмарков()
		.ДобавитьЭкспортер(ЭкспортерыРезультатовБенчмарков.Json)
		.УстановитьКаталогАртефактов(КаталогАртефактов);

	Настройки = Новый НастройкиЗапускаБенчмарков();
	Настройки.Конфигурация = Конфигурация;

	СериализаторНастроек = Новый СериализаторНастроекЗапускаБенчмарков();
	СериализаторНастроек.ЗаписатьВJson(Настройки, ПутьКФайлуНастроек);

	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(
		ОбъединитьПути(
			ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "BenchmarkOneScript"),
			"cmd/main.os"
		)
	);
	ПутьКФикстуре = ФС.НормализоватьПуть(
		ОбъединитьПути(
			ОбъединитьПути(КаталогПроекта, "tests"),
			"fixtures/benchmarks/Классы/БенчмаркСПереопределяемымиПараметрами.os"
		)
	);
	СтрокаКоманды = СтрШаблон(
		"%1 %2 run --settings %3 --param ПереопределяемыйПараметр=331 --param ПереопределяемыйПараметр=332 --iterationCount 1 --warmupCount 0 --invocationCount 1 --iterationTime 1 %4",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКСтартовомуСценарию),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКФайлуНастроек),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКФикстуре)
	);

	// Действие
	РезультатКоманды = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогПроекта);

	// Проверка
	Ожидаем.Что(РезультатКоманды.КодВозврата, РезультатКоманды.Вывод).Равно(0);

	ПутьКФайлуОтчета = ОбъединитьПути(КаталогАртефактов, "БенчмаркСПереопределяемымиПараметрами-report.json");
	Бенчмаркинг.ПодключитьБенчмарк(ПутьКФикстуре);
	СериализаторРезультатов = Новый СериализаторРезультатовБенчмарков();
	РезультатЗапуска = СериализаторРезультатов.ПрочитатьИзJson(ПутьКФайлуОтчета);

	Ожидаем.Что(РезультатЗапуска.Запуски).ИмеетДлину(4);
	ПарыЗначенийПараметров = Новый Массив();

	Для Каждого Запуск Из РезультатЗапуска.Запуски Цикл
		Параметры = Запуск.Кейс.Параметры();
		Ожидаем.Что(Параметры).ИмеетДлину(2);
		ПарыЗначенийПараметров.Добавить(
			СтрШаблон("%1=%2", Параметры[0].Значение(), Параметры[1].Значение())
		);
	КонецЦикла;

	Ожидаем.Что(ПарыЗначенийПараметров).Содержит("331=А");
	Ожидаем.Что(ПарыЗначенийПараметров).Содержит("331=Б");
	Ожидаем.Что(ПарыЗначенийПараметров).Содержит("332=А");
	Ожидаем.Что(ПарыЗначенийПараметров).Содержит("332=Б");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаменитьЭкспортерыИзНастроекЭкспортерамиCLI() Экспорт

	// Подготовка
	КаталогАртефактов = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКФайлуНастроек = _МенеджерВременныхФайлов.НовоеИмяФайла();

	Конфигурация = Новый КонфигурацияБенчмарков()
		.ДобавитьЭкспортер(ЭкспортерыРезультатовБенчмарков.Json)
		.УстановитьКаталогАртефактов(КаталогАртефактов);

	Настройки = Новый НастройкиЗапускаБенчмарков();
	Настройки.Конфигурация = Конфигурация;

	СериализаторНастроек = Новый СериализаторНастроекЗапускаБенчмарков();
	СериализаторНастроек.ЗаписатьВJson(Настройки, ПутьКФайлуНастроек);

	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(
		ОбъединитьПути(
			ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "BenchmarkOneScript"),
			"cmd/main.os"
		)
	);
	ПутьКФикстуре = ФС.НормализоватьПуть(
		ОбъединитьПути(
			ОбъединитьПути(КаталогПроекта, "tests"),
			"fixtures/benchmarks/Классы/БенчмаркСПереопределяемымиПараметрами.os"
		)
	);
	СтрокаКоманды = СтрШаблон(
		"%1 %2 run --settings %3 -e html --iterationCount 1 --warmupCount 0 --invocationCount 1 --iterationTime 1 %4",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКСтартовомуСценарию),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКФайлуНастроек),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКФикстуре)
	);

	// Действие
	РезультатКоманды = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогПроекта);

	// Проверка
	Ожидаем.Что(РезультатКоманды.КодВозврата, РезультатКоманды.Вывод).Равно(0);

	БазовоеИмяОтчета = ОбъединитьПути(
		КаталогАртефактов,
		"БенчмаркСПереопределяемымиПараметрами-report"
	);
	Ожидаем.Что(Новый Файл(БазовоеИмяОтчета + ".html").Существует()).ЭтоИстина();
	Ожидаем.Что(Новый Файл(БазовоеИмяОтчета + ".json").Существует()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыводитьПрогрессИВывестиОтчет() Экспорт

	// Подготовка
	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
