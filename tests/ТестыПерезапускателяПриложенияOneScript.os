&Тест
Процедура ТестДолжен_ПрименитьНастройкиДостоверностиСтатистикиИзCLI() Экспорт

	// Подготовка
	КаталогАртефактов = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(ОбъединитьПути(КаталогПроекта, "src/BenchmarkOneScript/cmd/main.os"));
	ПутьКФикстуре = ФС.НормализоватьПуть(ОбъединитьПути(КаталогПроекта, "tests/fixtures/benchmarks/Классы/ПустойБенчмарк.os"));
	СтрокаКоманды = СтрШаблон(
		"%1 %2 run --quiet -e json -a %3 --maxRelativeError 0.02 --minAdaptiveIterationCount 15 --maxAdaptiveIterationCount 15 --practicalSignificanceThreshold 0.2 --significanceLevel 0.01 --warmupCount 0 --invocationCount 1 --iterationTime 1 %4",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКСтартовомуСценарию),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(КаталогАртефактов),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКФикстуре)
	);

	// Действие
	РезультатКоманды = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогПроекта);

	// Проверка
	Ожидаем.Что(РезультатКоманды.КодВозврата, РезультатКоманды.Вывод).Равно(0);

	Бенчмаркинг.ПодключитьБенчмарк(ПутьКФикстуре);
	РезультатЗапуска = Новый СериализаторРезультатовБенчмарков().ПрочитатьИзJson(
		ОбъединитьПути(КаталогАртефактов, "ПустойБенчмарк-report.json")
	);
	Конфигурация = РезультатЗапуска.Конфигурация;

	Ожидаем.Что(Конфигурация.АдаптивныеИтерацииВключены()).ЭтоИстина();
	Ожидаем.Что(Конфигурация.ЦелеваяОтносительнаяПогрешность()).Равно(0.02);
	Ожидаем.Что(Конфигурация.МинимальноеКоличествоАдаптивныхИтераций()).Равно(15);
	Ожидаем.Что(Конфигурация.МаксимальноеКоличествоАдаптивныхИтераций()).Равно(15);
	Ожидаем.Что(Конфигурация.СтатистическоеСравнениеСЭталономВключено()).ЭтоИстина();
	Ожидаем.Что(Конфигурация.ОтносительныйПорогПрактическойЗначимости()).Равно(0.2);
	Ожидаем.Что(Конфигурация.УровеньЗначимостиСтатистическогоСравнения()).Равно(0.01);

КонецПроцедуры

