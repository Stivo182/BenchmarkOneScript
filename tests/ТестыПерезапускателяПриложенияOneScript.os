// BSLLS:LineLength-off

#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать "helpers"
#Использовать "../src/BenchmarkOneScript/cmd"

Перем _ИсходныйТекущийКаталог; // Строка
Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов
Перем _ИсходнаяТрассировкаЗагрузкиБиблиотек; // Строка
Перем _ИсходныйМаркерПримененияКонфигурацииOneScript; // Строка

#Область ОбработчикиСобытий

&Инициализация
Процедура ПередВсеми() Экспорт

	_ИсходныйТекущийКаталог = ТекущийКаталог();
	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_ИсходнаяТрассировкаЗагрузкиБиблиотек = ПолучитьПеременнуюСреды("OSLIB_LOADER_TRACE");
	_ИсходныйМаркерПримененияКонфигурацииOneScript = ПолучитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED");

	УстановитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED", "");

КонецПроцедуры

&После
Процедура ПослеЗапускаТеста() Экспорт

	КаталогАртефактов = ".\BenchmarkArtifacts";

	ФС.УдалитьФайлы(КаталогАртефактов);
	УстановитьТекущийКаталог(_ИсходныйТекущийКаталог);

КонецПроцедуры

&Завершение
Процедура ПослеВсех() Экспорт

	_МенеджерВременныхФайлов.Удалить();

	УстановитьПеременнуюСреды("OSLIB_LOADER_TRACE", _ИсходнаяТрассировкаЗагрузкиБиблиотек);
	УстановитьПеременнуюСреды(
		"BENCHOS_OSCRIPT_CONFIG_APPLIED",
		_ИсходныйМаркерПримененияКонфигурацииOneScript
	);

	УстановитьТекущийКаталог(_ИсходныйТекущийКаталог);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПрименитьПовторяемыеФильтрыCLI() Экспорт

	// Подготовка
	КаталогАртефактов = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(
		ОбъединитьПути(КаталогПроекта, "src/BenchmarkOneScript/cmd/main.os")
	);
	ПутьКФикстуре = ФС.НормализоватьПуть(
		ОбъединитьПути(КаталогПроекта, "tests/fixtures/benchmarks/Классы/БенчмаркиПоКатегориям.os")
	);
	СтрокаКоманды = СтрШаблон(
		"%1 %2 run --method БенчмаркА1,БенчмаркБ1 --method БенчмаркА2 --category Нет,А --category Б -e json -a %3 --iterationCount 1 --warmupCount 0 --invocationCount 1 --iterationTime 1 %4",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКСтартовомуСценарию),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(КаталогАртефактов),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКФикстуре)
	);

	// Действие
	РезультатКоманды = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогПроекта);

	// Проверка
	Ожидаем.Что(РезультатКоманды.КодВозврата, РезультатКоманды.Вывод).Равно(0);

	Бенчмаркинг.ПодключитьБенчмарк(ПутьКФикстуре);
	СериализаторРезультатов = Новый СериализаторРезультатовБенчмарков();
	РезультатЗапуска = СериализаторРезультатов.ПрочитатьИзJson(
		ОбъединитьПути(КаталогАртефактов, "БенчмаркиПоКатегориям-report.json")
	);

	Ожидаем.Что(РезультатЗапуска.ДескрипторыБенчмарков.Количество()).Равно(3);
	Ожидаем.Что(РезультатЗапуска.ДескрипторыБенчмарков.НайтиПоИмени("БенчмаркА1")).Не_().Равно(Неопределено);
	Ожидаем.Что(РезультатЗапуска.ДескрипторыБенчмарков.НайтиПоИмени("БенчмаркА2")).Не_().Равно(Неопределено);
	Ожидаем.Что(РезультатЗапуска.ДескрипторыБенчмарков.НайтиПоИмени("БенчмаркБ1")).Не_().Равно(Неопределено);
	Ожидаем.Что(РезультатЗапуска.ДескрипторыБенчмарков.НайтиПоИмени("БенчмаркБ2")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПерезапускатьПриложениеПриУстановленномМаркере() Экспорт

	// Подготовка
	КаталогКонфигурации = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКФайлуКонфигурации = ОбъединитьПути(КаталогКонфигурации, "oscript.cfg");
	ЗаписатьТекст(ПутьКФайлуКонфигурации, "lib.system=.");
	ФайлыКонфигурацииOneScript = Новый Массив();
	ФайлыКонфигурацииOneScript.Добавить(ПутьКФайлуКонфигурации);
	КаталогКоманд = ОбъединитьПути(
		ТекущийКаталог(),
		"src",
		"BenchmarkOneScript",
		"cmd"
	);
	УстановитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED", "1");
	Перезапускатель = Новый ПерезапускательПриложенияOneScript();

	// Действие
	Результат = Перезапускатель.ПерезапуститьСКонфигурацией(ФайлыКонфигурацииOneScript);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПерезапускатьПриложениеБезКонфигурацийOneScript() Экспорт

	// Подготовка
	КаталогЗапуска = _МенеджерВременныхФайлов.СоздатьКаталог();
