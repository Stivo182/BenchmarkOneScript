&Тест
Процедура ТестДолжен_НеДобавлятьПереводСтрокиКВыводуДочернегоПроцесса() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКФикстуре = ОбъединитьПути(КаталогБенчмарка, "БенчмаркСМаркером.os");
	ЗаписатьТекст(
		ПутьКФикстуре,
		"
		|&Бенчмарк
		|Процедура Бенчмарк() Экспорт
		|    Приостановить(300);
		|КонецПроцедуры"
	);
	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(ОбъединитьПути(КаталогПроекта, "src/BenchmarkOneScript/cmd/main.os"));
	СтрокаКоманды = СтрШаблон(
		"%1 %2 run --iterationCount 3 --warmupCount 0 --invocationCount 1 --iterationTime 1 %3",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКСтартовомуСценарию),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(ПутьКФикстуре)
	);

	// Действие
	Результат = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогПроекта);

	// Проверка
	Ожидаем.Что(Результат.КодВозврата, Результат.Вывод).Равно(0);
	ПозицияВторогоИзмерения = СтрНайти(Результат.Вывод, "Измерение  2");
	ПозицияТретьегоИзмерения = СтрНайти(Результат.Вывод, "Измерение  3");
	Ожидаем.Что(ПозицияВторогоИзмерения).Больше(0);
	Ожидаем.Что(ПозицияТретьегоИзмерения).Больше(ПозицияВторогоИзмерения);
	ВыводМеждуИзмерениями = Сред(
		Результат.Вывод,
		ПозицияВторогоИзмерения,
		ПозицияТретьегоИзмерения - ПозицияВторогоИзмерения
	);
	ВыводМеждуИзмерениями = СтрЗаменить(
		ВыводМеждуИзмерениями,
		Символы.ВК + Символы.ПС,
		Символы.ПС
	);
	Ожидаем.Что(СтрНайти(ВыводМеждуИзмерениями, Символы.ПС + Символы.ПС)).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьБенчмаркСЛокальнойЗависимостью(
	КаталогБенчмарка,
	ИмяПакета,
	ИмяМодуля,
	ИмяМетода,
	ОжидаемоеЗначение,
	КаталогКонфигурацииOneScript = Неопределено,
	КаталогЛокальныхБиблиотек = Неопределено
)

	Если КаталогКонфигурацииOneScript = Неопределено Тогда
		КаталогКонфигурацииOneScript = КаталогБенчмарка;
	КонецЕсли;

	Если КаталогЛокальныхБиблиотек = Неопределено Тогда
		КаталогЛокальныхБиблиотек = ОбъединитьПути(КаталогКонфигурацииOneScript, "oscript_modules");
	КонецЕсли;

	КаталогМодулейПакета = ОбъединитьПути(КаталогЛокальныхБиблиотек, ИмяПакета, "src", "Модули");
	ФС.ОбеспечитьКаталог(КаталогБенчмарка);
	ФС.ОбеспечитьКаталог(КаталогМодулейПакета);
	КопироватьФайл(
		ОбъединитьПути(ТекущийКаталог(), "oscript_modules", "package-loader.os"),
		ОбъединитьПути(КаталогЛокальныхБиблиотек, "package-loader.os")
	);

	ЗаписатьТекст(
		ОбъединитьПути(КаталогКонфигурацииOneScript, "oscript.cfg"),
		"lib.system=" + ФС.НормализоватьПуть(КаталогЛокальныхБиблиотек)
	);
	ЗаписатьТекст(
		ОбъединитьПути(КаталогМодулейПакета, ИмяМодуля + ".os"),
		СтрШаблон(
			"Функция ПолучитьЗначение() Экспорт
			|    Возврат %1;
			|КонецФункции",
			ОжидаемоеЗначение
		)
	);
	ЗаписатьТекст(
		ОбъединитьПути(КаталогБенчмарка, ИмяМетода + ".os"),
		СтрШаблон(
			"#Использовать %1
			|
			|&Бенчмарк
			|Процедура %2() Экспорт
			|    Если %3.ПолучитьЗначение() <> %4 Тогда
			|        ВызватьИсключение ""Локальная зависимость вернула неожиданное значение"";
			|    КонецЕсли;
			|КонецПроцедуры",
			ИмяПакета,
			ИмяМетода,
			ИмяМодуля,
			ОжидаемоеЗначение
		)
	);

КонецПроцедуры

Функция КоличествоЗагрузокБиблиотеки(Вывод, ИмяБиблиотеки)

	Шаблон = СтрШаблон(
		"(?im)ПриЗагрузкеБиблиотеки[ \t]+[^\r\n]*[/\\]%1\r?$",
		ИмяБиблиотеки
	);
	РегулярноеВыражение = Новый РегулярноеВыражение(Шаблон);

	Возврат РегулярноеВыражение.НайтиСовпадения(Вывод).Количество();

КонецФункции

Функция КоличествоВхождений(Текст, Подстрока)

	РегулярноеВыражение = Новый РегулярноеВыражение(Подстрока);
	Возврат РегулярноеВыражение.НайтиСовпадения(Текст).Количество();

КонецФункции

Процедура ЗаписатьТекст(ПутьКФайлу, Текст)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

#КонецОбласти
