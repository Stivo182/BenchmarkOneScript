#Использовать ".."

#Область Тесты

&Тест
Процедура ТестДолжен_ЗаполнитьВремяТекущейДатойUTC() Экспорт

	// Подготовка
	Начало = ТекущаяУниверсальнаяДата();

	// Действие
	Событие = Новый СобытиеВыполненияБенчмарков("Начат", Новый Структура());

	// Проверка
	Ожидаем.Что(Событие.Время()).Заполнено();
	Ожидаем.Что(Событие.Время() >= Начало).Равно(Истина);
	Ожидаем.Что(Событие.Время() <= ТекущаяУниверсальнаяДата()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЯвноПереданноеВремя() Экспорт

	// Подготовка
	Время = '20261016123456';

	// Действие
	Событие = Новый СобытиеВыполненияБенчмарков("Начат", Новый Структура(), Время);

	// Проверка
	Ожидаем.Что(Событие.Время()).Равно(Время);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСобытиеЗавершенияЗапуска() Экспорт

	// Подготовка
	РезультатЗапуска = Новый Структура("Значение", 42);

	// Действие
	Событие = ФабрикаСобытийВыполненияБенчмарков.СоздатьЗавершениеЗапуска(РезультатЗапуска);

	// Проверка
	Ожидаем.Что(Событие.ТипСобытия()).Равно(ТипыСобытийВыполненияБенчмарков.ЗапускБенчмарковЗавершен());
	Ожидаем.Что(Событие.Данные()).Равно(РезультатЗапуска);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОстальныеСобытияЧерезФабрику() Экспорт

	// Подготовка
	Конфигурация = Новый Структура("Значение", 1);
	ДескрипторыБенчмарков = Новый Массив();
	Данные = Новый Структура("Значение", 42);
	Файлы = Новый Массив();

	// Действие и Проверка
	Событие = ФабрикаСобытийВыполненияБенчмарков.СоздатьНачалоЗапуска(Конфигурация, ДескрипторыБенчмарков);
	ПроверитьТипСобытия(Событие, ТипыСобытийВыполненияБенчмарков.ЗапускБенчмарковНачат());
	Ожидаем.Что(Событие.Данные().Конфигурация).Равно(Конфигурация);
	Ожидаем.Что(Событие.Данные().ДескрипторыБенчмарков).Равно(ДескрипторыБенчмарков);
	Событие = ФабрикаСобытийВыполненияБенчмарков.СоздатьНачалоИсполняющейСреды("1.0", Конфигурация);
	ПроверитьТипСобытия(Событие, ТипыСобытийВыполненияБенчмарков.ИсполняющаяСредаБенчмарковНачата());
	Ожидаем.Что(Событие.Данные().ВерсияИсполняющейСреды).Равно("1.0");
	Ожидаем.Что(Событие.Данные().Конфигурация).Равно(Конфигурация);
	ПроверитьСобытие(ФабрикаСобытийВыполненияБенчмарков.СоздатьВыводПроцесса("текст"), ТипыСобытийВыполненияБенчмарков.ВыводПроцессаПолучен(), "текст");
	ПроверитьСобытие(ФабрикаСобытийВыполненияБенчмарков.СоздатьНачалоКейса(Данные), ТипыСобытийВыполненияБенчмарков.КейсБенчмаркаНачат(), Данные);
	ПроверитьСобытие(ФабрикаСобытийВыполненияБенчмарков.СоздатьЗавершениеИтерации(Данные), ТипыСобытийВыполненияБенчмарков.ИтерацияБенчмаркаЗавершена(), Данные);
	ПроверитьСобытие(ФабрикаСобытийВыполненияБенчмарков.СоздатьРасчетСтатистикиКейса(Данные), ТипыСобытийВыполненияБенчмарков.СтатистикаКейсаРассчитана(), Данные);
	ПроверитьСобытие(ФабрикаСобытийВыполненияБенчмарков.СоздатьЗавершениеКейса(Данные), ТипыСобытийВыполненияБенчмарков.КейсБенчмаркаЗавершен(), Данные);
	Событие = ФабрикаСобытийВыполненияБенчмарков.СоздатьАртефакты(Файлы);
	ПроверитьТипСобытия(Событие, ТипыСобытийВыполненияБенчмарков.АртефактыСформированы());
	Ожидаем.Что(Событие.Данные().Файлы).Равно(Файлы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСобытие(Событие, ОжидаемыйТипСобытия, ОжидаемыеДанные)

	ПроверитьТипСобытия(Событие, ОжидаемыйТипСобытия);
	Ожидаем.Что(Событие.Данные()).Равно(ОжидаемыеДанные);

КонецПроцедуры

Процедура ПроверитьТипСобытия(Событие, ОжидаемыйТипСобытия)

	Ожидаем.Что(Событие.ТипСобытия()).Равно(ОжидаемыйТипСобытия);

КонецПроцедуры

#КонецОбласти
