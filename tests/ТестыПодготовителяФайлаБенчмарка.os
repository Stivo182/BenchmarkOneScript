// BSLLS:LineLength-off

#Использовать asserts
#Использовать fs
#Использовать strings
#Использовать tempfiles
#Использовать "helpers"

Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов
Перем _ПодготовительФайлаБенчмарка; // ПодготовительФайлаБенчмарка

#Область ОбработчикиСобытий

&Инициализация
Процедура ПередВсеми() Экспорт
	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_ПодготовительФайлаБенчмарка = Новый ПодготовительФайлаБенчмарка(_МенеджерВременныхФайлов);
КонецПроцедуры

&Завершение
Процедура ПослеВсех() Экспорт

	_МенеджерВременныхФайлов.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьИсходныйФайлЕслиАннотацияБенчмаркУжеЕсть() Экспорт

	// Подготовка
	ПутьКФайлу = "./tests/fixtures/benchmarks/Классы/ПустойБенчмарк.os";

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКФайлу);

	// Проверка
	Ожидаем.Что(ПодготовленныйФайл).Равно(ПутьКФайлу);
	Ожидаем.Что(_МенеджерВременныхФайлов.Файлы()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьИЗапуститьВременныйФайлДляАлгоритмаБезАннотации() Экспорт

	// Подготовка
	ПутьКФайлу = "./tests/fixtures/АлгоритмБезАннотации.os";

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКФайлу);

	// Проверка
	ТекстВременногоФайла = СтроковыеФункции.ПрочитатьФайл(ПодготовленныйФайл);
	Тип = Бенчмаркинг.ПодключитьБенчмарк(ПодготовленныйФайл);
	ДескрипторыБенчмарков = Новый КоллекцияДескрипторовБенчмарков(Тип);

	Ожидаем.Что(ФС.ФайлСуществует(ПодготовленныйФайл)).Равно(Истина);
	Ожидаем.Что(_МенеджерВременныхФайлов.Файлы()).ИмеетДлину(1);
	Ожидаем.Что(ТекстВременногоФайла).Содержит("#Использовать fs");
	Ожидаем.Что(ТекстВременногоФайла).Содержит("&Бенчмарк");
	Ожидаем.Что(ТекстВременногоФайла).Содержит("Процедура Бенчмарк() Экспорт");
	Ожидаем.Что(ДескрипторыБенчмарков.Количество()).Равно(1);
	Ожидаем.Что(ДескрипторыБенчмарков.ПолучитьПервый().Метод()).Равно("Бенчмарк");
	Ожидаем.Что(ДескрипторыБенчмарков.ПолучитьПервый().Наименование()).Равно("АлгоритмБезАннотации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьДирективуИспользованияВСмешанномРегистреВПреамбулеАлгоритма() Экспорт

	// Подготовка
	КаталогИсходногоФайла = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКИсходномуФайлу = ОбъединитьПути(КаталогИсходногоФайла, "АлгоритмСДирективойИспользования.os");
	ЗаписатьТекст(
		ПутьКИсходномуФайлу,
		"#uSe fs
		|ФС.НормализоватьПуть(""."");"
	);

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКИсходномуФайлу);
	ПодключенныйТип = Бенчмаркинг.ПодключитьБенчмарк(ПодготовленныйФайл);

	// Проверка
	ТекстВременногоФайла = СтроковыеФункции.ПрочитатьФайл(ПодготовленныйФайл);
	Ожидаем.Что(Лев(ТекстВременногоФайла, СтрДлина("#uSe fs"))).Равно("#uSe fs");
	Ожидаем.Что(ПодключенныйТип).Не_().ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьОтносительнуюДирективуИспользованияОтИсходногоАлгоритма() Экспорт

	// Подготовка
	КаталогАлгоритма = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКАлгоритму = ОбъединитьПути(КаталогАлгоритма, "Алгоритм.os");
	ЗаписатьТекст(ПутьКАлгоритму, "#Use ""./dependency""
		|А = 1;");

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКАлгоритму);
	ТекстВременногоФайла = СтроковыеФункции.ПрочитатьФайл(ПодготовленныйФайл);

	// Проверка
	Ожидаем.Что(ТекстВременногоФайла).Содержит(
		"#Использовать """ + ФС.НормализоватьПуть(ОбъединитьПути(КаталогАлгоритма, "dependency")) + """"
	);

КонецПроцедуры

&Тест
&Параметры("#native")
&Параметры("#stack")
Процедура ТестДолжен_СохранитьРежимКомпиляцииВПреамбулеАлгоритма(РежимКомпиляции) Экспорт

	// Подготовка
	КаталогАлгоритма = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКАлгоритму = ОбъединитьПути(КаталогАлгоритма, "Алгоритм.os");
	ЗаписатьТекст(ПутьКАлгоритму, РежимКомпиляции + Символы.ПС + "#Use fs" + Символы.ПС + "А = 1;");

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКАлгоритму);
	ТекстВременногоФайла = СтроковыеФункции.ПрочитатьФайл(ПодготовленныйФайл);

	// Проверка
	Ожидаем.Что(ТекстВременногоФайла).Содержит(РежимКомпиляции + Символы.ПС + "#Use fs");
	Ожидаем.Что(СтрНайти(ТекстВременногоФайла, РежимКомпиляции)).Меньше(
		СтрНайти(ТекстВременногоФайла, "&Бенчмарк")
	);

	Если Не ТестированиеБенчмарков.ЭтоOneScript1() Тогда
		ТипБенчмарка = Бенчмаркинг.ПодключитьБенчмарк(ПодготовленныйФайл);
		Ожидаем.Что(ТипБенчмарка).Не_().ЭтоНеопределено();
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьУсловныйКодИИспользованиеВОбернутомАлгоритме() Экспорт

	// Подготовка
	КаталогАлгоритма = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКАлгоритму = ОбъединитьПути(КаталогАлгоритма, "УсловныйАлгоритм.os");
	ЗаписатьТекст(ПутьКАлгоритму, "#Если Windows Тогда
		|#Use fs
		|А = 1;
		|#Иначе
		|#Use fs
		|А = 2;
		|#КонецЕсли");

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКАлгоритму);
	ПодключенныйТип = Бенчмаркинг.ПодключитьБенчмарк(ПодготовленныйФайл);

	// Проверка
	Ожидаем.Что(ПодключенныйТип).Не_().ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьОбластьВПреамбулеОбычногоАлгоритма() Экспорт

	// Подготовка
	КаталогИсходногоФайла = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКИсходномуФайлу = ОбъединитьПути(КаталогИсходногоФайла, "АлгоритмСОбластью.os");
	ЗаписатьТекст(
		ПутьКИсходномуФайлу,
		"#Область Подготовка
		|#КонецОбласти
		|ФС.НормализоватьПуть(""."");"
	);

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКИсходномуФайлу);
	ТекстВременногоФайла = СтроковыеФункции.ПрочитатьФайл(ПодготовленныйФайл);

	// Проверка
	ПозицияАннотацииБенчмарка = СтрНайти(ТекстВременногоФайла, "&Бенчмарк");
	Ожидаем.Что(СтрНайти(ТекстВременногоФайла, "#Область Подготовка")).Меньше(ПозицияАннотацииБенчмарка);
	Ожидаем.Что(СтрНайти(ТекстВременногоФайла, "#КонецОбласти")).Меньше(ПозицияАннотацииБенчмарка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьВременныйКаталогПриОчистке() Экспорт

	// Подготовка
	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	Подготовитель = Новый ПодготовительФайлаБенчмарка(МенеджерВременныхФайлов);
	ПодготовленныйФайл = Подготовитель.Подготовить("./tests/fixtures/АлгоритмБезАннотации.os");
	ВременныйКаталог = Новый Файл(ПодготовленныйФайл).Путь;

	// Действие
	Подготовитель.Очистить();

	// Проверка
	Ожидаем.Что(ФС.КаталогСуществует(ВременныйКаталог)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКонфигурациюРядомСВременнымФайломИзИсходногоКаталога() Экспорт

	// Подготовка
	КаталогИсходногоФайла = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКИсходномуФайлу = ОбъединитьПути(КаталогИсходногоФайла, "АлгоритмСКонфигурацией.os");
	КаталогЛокальныхБиблиотек = ОбъединитьПути(КаталогИсходногоФайла, "oscript_modules");
	ФС.ОбеспечитьКаталог(КаталогЛокальныхБиблиотек);
	ЗаписатьТекст(
		ОбъединитьПути(КаталогИсходногоФайла, "oscript.cfg"),
		"lib.system=./oscript_modules
		|custom.option=benchmark"
	);
	ЗаписатьТекст(ПутьКИсходномуФайлу, "А = 1;");

	// Действие
	ПодготовленныйФайл = _ПодготовительФайлаБенчмарка.Подготовить(ПутьКИсходномуФайлу);

	// Проверка
	ПутьКПодготовленнойКонфигурации = ОбъединитьПути(
		Новый Файл(ПодготовленныйФайл).Путь,
		"oscript.cfg"
	);
	Ожидаем.Что(ФС.ФайлСуществует(ПутьКПодготовленнойКонфигурации)).Равно(Истина);

	ТекстКонфигурации = СтроковыеФункции.ПрочитатьФайл(ПутьКПодготовленнойКонфигурации);
	Ожидаем.Что(ТекстКонфигурации).Содержит(ФС.НормализоватьПуть(КаталогЛокальныхБиблиотек));
	Ожидаем.Что(ТекстКонфигурации).Содержит("custom.option=benchmark");

КонецПроцедуры

&Тест
&Параметры("./tests/fixtures/benchmarks/Классы/ПустойБенчмарк.os", Истина)
&Параметры("./tests/fixtures/АлгоритмБезАннотации.os", Ложь)
Процедура ТестДолжен_ОпределитьНаличиеБенчмарковВФайле(ПутьКФайлу, Ожидание) Экспорт

	// Действие
	СодержитБенчмарки = _ПодготовительФайлаБенчмарка.СодержитБенчмарки(ПутьКФайлу);

	// Проверка
	Ожидаем.Что(СодержитБенчмарки).Равно(Ожидание);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьТекст(ПутьКФайлу, Текст)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

#КонецОбласти
