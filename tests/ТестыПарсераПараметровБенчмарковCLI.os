#Использовать asserts
#Использовать "helpers"

Перем _ПарсерПараметровБенчмарковCLI; // ПарсерПараметровБенчмарковCLI

#Область ОбработчикиСобытий

&Инициализация
Процедура ПередВсеми() Экспорт

	_ПарсерПараметровБенчмарковCLI = Новый ПарсерПараметровБенчмарковCLI();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_РазобратьПовторяемыеСписочныеОпции() Экспорт

	// Подготовка
	Значения = Новый Массив();
	Значения.Добавить("Первый, Второй");
	Значения.Добавить("Третий");

	// Действие
	Результат = _ПарсерПараметровБенчмарковCLI.РазобратьСписокЗначений(Значения, "--method");

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(3);
	Ожидаем.Что(Результат[0]).Равно("Первый");
	Ожидаем.Что(Результат[1]).Равно("Второй");
	Ожидаем.Что(Результат[2]).Равно("Третий");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассивЕслиСписочнаяОпцияНеЗадана() Экспорт

	// Действие
	Результат = _ПарсерПараметровБенчмарковCLI.РазобратьСписокЗначений(Неопределено, "--category");

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(0);

КонецПроцедуры

&Тест
&Параметры("")
&Параметры("   ")
Процедура ТестДолжен_ИгнорироватьПустоеЗначениеСписочнойОпции(ПустоеЗначение) Экспорт

	// Подготовка
	Значения = Новый Массив();
	Значения.Добавить(ПустоеЗначение);
	Значения.Добавить("Первый, Второй");

	// Действие
	Результат = _ПарсерПараметровБенчмарковCLI.РазобратьСписокЗначений(Значения, "--method");

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(Результат[0]).Равно("Первый");
	Ожидаем.Что(Результат[1]).Равно("Второй");

КонецПроцедуры

&Тест
&Параметры("Первый,", "--method")
&Параметры("Первый, ,Второй", "--category")
Процедура ТестДолжен_ОтклонитьПустойЭлементСписочнойОпции(Значение, ИмяОпции) Экспорт

	// Подготовка
	Значения = Новый Массив();
	Значения.Добавить(Значение);

	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить(Значения);
	ПараметрыМетода.Добавить(ИмяОпции);

	// Действие и Проверка
	Ожидаем
		.Что(_ПарсерПараметровБенчмарковCLI)
		.Метод("РазобратьСписокЗначений", ПараметрыМетода)
		.ВыбрасываетИсключение(
			СтрШаблон("В значении опции %1 <%2> содержится пустой элемент", ИмяОпции, Значение)
		);

КонецПроцедуры

&Тест
&Параметры("field=1", 1)
&Параметры("field=test", "test")
&Параметры("field=true", Истина)
&Параметры("field=Истина", Истина)
&Параметры("field=test value", "test value")
&Параметры("field=1.5", 1.5)
&Параметры("field=1,5", 1.5)
&Параметры("field=", "")
&Параметры("field", Неопределено)
&Параметры("field=false", Ложь)
&Параметры("field=ложь", Ложь)
&Параметры("field=-5", -5)
&Параметры("field=a=b", "a=b")
Процедура ТестДолжен_РазобратьПараметрCLIВПараметрБенчмарка(ПараметрCLI, ОжидаемоеЗначение) Экспорт

	// Действие
	Параметр = _ПарсерПараметровБенчмарковCLI.РазобратьПараметр(ПараметрCLI);

	// Проверка
	Ожидаем.Что(Параметр.ИмяПоля).Равно("field");
	Ожидаем.Что(Параметр.Значение).Равно(ОжидаемоеЗначение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИсключениеЕслиНеУказаноИмяПоля() Экспорт

	// Подготовка
	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить("=1");

	// Действие и Проверка
	Ожидаем
		.Что(_ПарсерПараметровБенчмарковCLI)
		.Метод("РазобратьПараметр", ПараметрыМетода)
		.ВыбрасываетИсключение("В значении опции -p, --param <=1> не указано имя поля");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьВсеПараметрыCLIВКоллекциюПараметровБенчмарка() Экспорт

	// Подготовка
	ПараметрыCLI = Новый Массив();
	ПараметрыCLI.Добавить("field=1");
	ПараметрыCLI.Добавить("field=2");
	ПараметрыCLI.Добавить("other=test");

	// Действие
	Параметры = _ПарсерПараметровБенчмарковCLI.РазобратьПараметры(ПараметрыCLI);

	// Проверка
	Ожидаем.Что(Параметры).ИмеетДлину(3);
	Ожидаем.Что(Параметры[0].Имя()).Равно("field");
	Ожидаем.Что(Параметры[0].Значение()).Равно(1);
	Ожидаем.Что(Параметры[1].Имя()).Равно("field");
	Ожидаем.Что(Параметры[1].Значение()).Равно(2);
	Ожидаем.Что(Параметры[2].Имя()).Равно("other");
	Ожидаем.Что(Параметры[2].Значение()).Равно("test");

КонецПроцедуры

#КонецОбласти
