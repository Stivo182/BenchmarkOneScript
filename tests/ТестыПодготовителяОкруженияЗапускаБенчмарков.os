КонецПроцедуры

&Тест
&Параметры("#native")
&Параметры("#stack")
Процедура ТестДолжен_НайтиДирективуИспользованияПослеРежимаКомпиляции(РежимКомпиляции) Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКБенчмарку = ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os");
	ЗаписатьТекст(ПутьКБенчмарку, РежимКомпиляции + Символы.ПС + "#Use fs" + Символы.ПС + "&Бенчмарк");
	Анализатор = Новый АнализаторСценарияБенчмарка(ПутьКБенчмарку);

	// Действие
	Директивы = Анализатор.ДирективыИспользования();

	// Проверка
	Ожидаем.Что(Директивы).ИмеетДлину(1);
	Ожидаем.Что(Директивы[0]).Равно("#Use fs");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьДирективыВспомогательногоФайлаПриЗапускеКаталога() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	ЗаписатьТекст(ОбъединитьПути(КаталогБенчмарка, "Вспомогательный.os"), "#Use absentdependency");
	ЗаписатьТекст(ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os"),
		"#Use fs
		|&Бенчмарк
		|Процедура Замер() Экспорт
		|КонецПроцедуры");
	Подготовитель = Новый ПодготовительОкруженияЗапускаБенчмарков(МассивИзОдногоЗначения(КаталогБенчмарка));

	// Действие
	Окружение = Подготовитель.Подготовить();

	// Проверка
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков).ИмеетДлину(1);
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков[0][0]).Равно("#Use fs");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьДирективыЯвноУказанногоАлгоритма() Экспорт

	// Подготовка
	КаталогАлгоритма = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКАлгоритму = ОбъединитьПути(КаталогАлгоритма, "Алгоритм.os");
	ЗаписатьТекст(ПутьКАлгоритму, "#Use fs
		|А = 1;");
	Подготовитель = Новый ПодготовительОкруженияЗапускаБенчмарков(МассивИзОдногоЗначения(ПутьКАлгоритму));

	// Действие
	Окружение = Подготовитель.Подготовить();

	// Проверка
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков).ИмеетДлину(1);
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков[0][0]).Равно("#Use fs");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьТекст(ПутьКФайлу, Текст)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

Функция МассивИзОдногоЗначения(Значение)

	Результат = Новый Массив();
	Результат.Добавить(Значение);

	Возврат Результат;

КонецФункции

Процедура ПроверитьЕдинственнуюДирективуИспользования(ТекстБенчмарка)

	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогБиблиотеки = ОбъединитьПути(КаталогБенчмарка, "oscript_modules", "localdependency");
	ПутьКФайлуБенчмарка = ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os");
	СоздатьКаталог(КаталогБиблиотеки);
	ЗаписатьТекст(ПутьКФайлуБенчмарка, ТекстБенчмарка);

	АнализаторСценария = Новый АнализаторСценарияБенчмарка(ПутьКФайлуБенчмарка);
	ДирективыИспользования = АнализаторСценария.ДирективыИспользования();

	Ожидаем.Что(ДирективыИспользования).ИмеетДлину(1);
	Ожидаем.Что(ДирективыИспользования[0]).Равно(
		"#Использовать """ + ФС.НормализоватьПуть(КаталогБиблиотеки) + """"
	);

КонецПроцедуры

#КонецОбласти
