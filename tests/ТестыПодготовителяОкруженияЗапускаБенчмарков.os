#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать "helpers"
#Использовать "../src/BenchmarkOneScript/cmd"

Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов

#Область ОбработчикиСобытий

&Инициализация
Процедура ПередВсеми() Экспорт

	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();

КонецПроцедуры

&Завершение
Процедура ПослеВсех() Экспорт

	_МенеджерВременныхФайлов.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПодготовитьКонфигурациюИДирективыБенчмаркаВИсходномПорядке() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогБиблиотеки = ОбъединитьПути(КаталогБенчмарка, "oscript_modules", "localdependency");
	СоздатьКаталог(КаталогБиблиотеки);
	ЗаписатьТекст(ОбъединитьПути(КаталогБенчмарка, "oscript.cfg"), "");
	ЗаписатьТекст(
		ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os"),
		"#Use configdependency
		|#Use ""./oscript_modules/localdependency""
		|&Бенчмарк
		|Процедура Замер() Экспорт
		|КонецПроцедуры"
	);
	Подготовитель = Новый ПодготовительОкруженияЗапускаБенчмарков(
		МассивИзОдногоЗначения(КаталогБенчмарка)
	);

	// Действие
	Окружение = Подготовитель.Подготовить();

	// Проверка
	Ожидаем.Что(Окружение.ФайлыКонфигурацииOneScript).ИмеетДлину(1);
	Ожидаем.Что(Окружение.ФайлыКонфигурацииOneScript[0]).Равно(
		ФС.НормализоватьПуть(ОбъединитьПути(КаталогБенчмарка, "oscript.cfg"))
	);
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков).ИмеетДлину(1);
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков[0]).ИмеетДлину(2);
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков[0][0]).Равно("#Use configdependency");
	Ожидаем.Что(Окружение.ДирективыИспользованияБенчмарков[0][1]).Равно(
		"#Использовать """ + ФС.НормализоватьПуть(КаталогБиблиотеки) + """"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспознатьПутевуюДирективуВСмешанномРегистре() Экспорт

	// Действие и Проверка
	ПроверитьЕдинственнуюДирективуИспользования("#uSe ""./oscript_modules/localdependency""");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспознатьПутевуюДирективуБезКавычек() Экспорт

	// Действие и Проверка
	ПроверитьЕдинственнуюДирективуИспользования("#Use ./oscript_modules/localdependency");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПродолжитьРазборПослеОбластиВПреамбуле() Экспорт

	// Действие и Проверка
	ПроверитьЕдинственнуюДирективуИспользования(
		"#Область ПодключениеЗависимостей
		|#КонецОбласти
		|#Use ""./oscript_modules/localdependency"""
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИмяПакетаПриОдноименномКаталоге() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	СоздатьКаталог(ОбъединитьПути(КаталогБенчмарка, "fs"));
	ПутьКБенчмарку = ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os");
	ЗаписатьТекст(ПутьКБенчмарку, "#Use fs");
	Анализатор = Новый АнализаторСценарияБенчмарка(ПутьКБенчмарку);

	// Действие
	Директивы = Анализатор.ДирективыИспользования();

	// Проверка
	Ожидаем.Что(Директивы).ИмеетДлину(1);
	Ожидаем.Что(Директивы[0]).Равно("#Use fs");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьПутьВКавычкахБезРазделителя() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКЛокальнойБиблиотеке = ОбъединитьПути(КаталогБенчмарка, "helpers");
	СоздатьКаталог(ПутьКЛокальнойБиблиотеке);
	ПутьКБенчмарку = ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os");
	ЗаписатьТекст(ПутьКБенчмарку, "#Use ""helpers""");
	Анализатор = Новый АнализаторСценарияБенчмарка(ПутьКБенчмарку);

	// Действие
	Директивы = Анализатор.ДирективыИспользования();

	// Проверка
	Ожидаем.Что(Директивы).ИмеетДлину(1);
	Ожидаем.Что(Директивы[0]).Равно(
		"#Использовать """ + ФС.НормализоватьПуть(ПутьКЛокальнойБиблиотеке) + """"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьУсловиеДляДирективыИспользования() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКБенчмарку = ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os");
	ЗаписатьТекст(ПутьКБенчмарку, "#Если Windows Тогда
		|#Use ""./dependency""
		|#КонецЕсли
		|&Бенчмарк");
	Анализатор = Новый АнализаторСценарияБенчмарка(ПутьКБенчмарку);

	// Действие
	Директивы = Анализатор.ДирективыИспользования();

	// Проверка
	Ожидаем.Что(Директивы).ИмеетДлину(3);
	Ожидаем.Что(Директивы[0]).Равно("#Если Windows Тогда");
	Ожидаем.Что(Директивы[1]).Равно(
		"#Использовать """ + ФС.НормализоватьПуть(ОбъединитьПути(КаталогБенчмарка, "dependency")) + """"
	);
	Ожидаем.Что(Директивы[2]).Равно("#КонецЕсли");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакрытьУсловиеОхватывающееБенчмарк() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКБенчмарку = ОбъединитьПути(КаталогБенчмарка, "Бенчмарк.os");
	ЗаписатьТекст(ПутьКБенчмарку, "#Если Windows Тогда
		|#Use fs
		|&Бенчмарк
		|Процедура Замер() Экспорт
		|КонецПроцедуры
		|#КонецЕсли");
	Анализатор = Новый АнализаторСценарияБенчмарка(ПутьКБенчмарку);

	// Действие
	Директивы = Анализатор.ДирективыИспользования();

	// Проверка
	Ожидаем.Что(Директивы).ИмеетДлину(3);
	Ожидаем.Что(Директивы[0]).Равно("#Если Windows Тогда");
	Ожидаем.Что(Директивы[1]).Равно("#Use fs");
	Ожидаем.Что(Директивы[2]).Равно("#КонецЕсли");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьУсловиеБезДирективИспользования() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
