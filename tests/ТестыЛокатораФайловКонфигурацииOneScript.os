#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать "helpers"
#Использовать "../src/BenchmarkOneScript/cmd"

Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов
Перем _ИсходныйТекущийКаталог; // Строка
Перем _Локатор; // ЛокаторФайловКонфигурацииOneScript

#Область ОбработчикиСобытий

&Инициализация
Процедура ПередВсеми() Экспорт

	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_ИсходныйТекущийКаталог = ТекущийКаталог();
	_Локатор = Новый ЛокаторФайловКонфигурацииOneScript();

КонецПроцедуры

&После
Процедура ПослеЗапускаТеста() Экспорт

	УстановитьТекущийКаталог(_ИсходныйТекущийКаталог);

КонецПроцедуры

&Завершение
Процедура ПослеВсех() Экспорт

	УстановитьТекущийКаталог(_ИсходныйТекущийКаталог);
	_МенеджерВременныхФайлов.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьПриоритетФайловИУдалитьПовторы() Экспорт

	// Подготовка
	ПервыйКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ВторойКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	СоздатьБенчмаркСКонфигурацией(ПервыйКаталог, "ПервыйБенчмарк.os");
	СоздатьБенчмаркСКонфигурацией(ВторойКаталог, "ВторойБенчмарк.os");

	МассивФайлов = Новый Массив();
	МассивФайлов.Добавить(ПервыйКаталог);
	МассивФайлов.Добавить(ВторойКаталог);
	МассивФайлов.Добавить(ПервыйКаталог);

	// Действие
	ФайлыКонфигурации = _Локатор.НайтиФайлыКонфигурации(МассивФайлов);

	// Проверка
	Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(2);
	Ожидаем.Что(ФайлыКонфигурации[0]).Равно(ПутьККонфигурации(ПервыйКаталог));
	Ожидаем.Что(ФайлыКонфигурации[1]).Равно(ПутьККонфигурации(ВторойКаталог));

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиКонфигурациюКаталогаБезПоискаСценариев() Экспорт

	// Подготовка
	Каталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ЗаписатьТекст(ПутьККонфигурации(Каталог), "");

	// Действие
	ФайлыКонфигурации = _Локатор.НайтиФайлыКонфигурации(
		МассивИзОдногоЗначения(Каталог)
	);

	// Проверка
	Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(1);
	Ожидаем.Что(ФайлыКонфигурации[0]).Равно(ПутьККонфигурации(Каталог));

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьРегистрКаталоговСогласноПравиламПлатформы() Экспорт

	// Подготовка
	КорневойКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогВНижнемРегистре = ОбъединитьПути(КорневойКаталог, "case-config");
	КаталогВВерхнемРегистре = ОбъединитьПути(КорневойКаталог, "CASE-CONFIG");
	СоздатьКаталог(КаталогВНижнемРегистре);
	СоздатьБенчмаркСКонфигурацией(КаталогВНижнемРегистре, "Бенчмарк.os");

	Если Не ЭтоWindows() Тогда
		СоздатьКаталог(КаталогВВерхнемРегистре);
		СоздатьБенчмаркСКонфигурацией(КаталогВВерхнемРегистре, "Бенчмарк.os");
	КонецЕсли;

	МассивФайлов = Новый Массив();
	МассивФайлов.Добавить(КаталогВНижнемРегистре);
	МассивФайлов.Добавить(КаталогВВерхнемРегистре);

	// Действие
	ФайлыКонфигурации = _Локатор.НайтиФайлыКонфигурации(МассивФайлов);

	// Проверка
	Если ЭтоWindows() Тогда
		Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(1);
		Ожидаем.Что(ФайлыКонфигурации[0]).Равно(ПутьККонфигурации(КаталогВНижнемРегистре));
	Иначе
		Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(2);
		Ожидаем.Что(ФайлыКонфигурации[0]).Равно(ПутьККонфигурации(КаталогВНижнемРегистре));
		Ожидаем.Что(ФайлыКонфигурации[1]).Равно(ПутьККонфигурации(КаталогВВерхнемРегистре));
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиКонфигурациюВложенногоБенчмаркаТолькоПриРекурсивномПоиске() Экспорт

	// Подготовка
	КорневойКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ВложенныйКаталог = ОбъединитьПути(КорневойКаталог, "Вложенный");
	СоздатьКаталог(ВложенныйКаталог);
	СоздатьБенчмаркСКонфигурацией(ВложенныйКаталог, "ВложенныйБенчмарк.os");
	МассивФайлов = МассивИзОдногоЗначения(КорневойКаталог);

	// Действие
	ФайлыБезРекурсии = _Локатор.НайтиФайлыКонфигурации(МассивФайлов);
	ФайлыСРекурсией = _Локатор.НайтиФайлыКонфигурации(МассивФайлов, Истина);

	// Проверка
	Ожидаем.Что(ФайлыБезРекурсии).ИмеетДлину(0);
	Ожидаем.Что(ФайлыСРекурсией).ИмеетДлину(1);
	Ожидаем.Что(ФайлыСРекурсией[0]).Равно(ПутьККонфигурации(ВложенныйКаталог));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКонфигурациюКорневогоКаталогаПриРекурсивномПоиске() Экспорт

	// Подготовка
	КорневойКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ВложенныйКаталог = ОбъединитьПути(КорневойКаталог, "Вложенный");
	СоздатьКаталог(ВложенныйКаталог);
	ЗаписатьТекст(ПутьККонфигурации(КорневойКаталог), "");
	СоздатьБенчмаркСКонфигурацией(ВложенныйКаталог, "ВложенныйБенчмарк.os");

	// Действие
	ФайлыКонфигурации = _Локатор.НайтиФайлыКонфигурации(
		МассивИзОдногоЗначения(КорневойКаталог),
		Истина
	);

	// Проверка
	Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(2);
	Ожидаем.Что(ФайлыКонфигурации[0]).Равно(ПутьККонфигурации(КорневойКаталог));
	Ожидаем.Что(ФайлыКонфигурации[1]).Равно(ПутьККонфигурации(ВложенныйКаталог));

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпорядочитьВложенныеФайлыКонфигурацииПоПолномуПути() Экспорт

	// Подготовка
	КорневойКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПоследнийКаталог = ОбъединитьПути(КорневойКаталог, "z-last");
	СреднийКаталог = ОбъединитьПути(КорневойКаталог, "m-middle");
	ПервыйКаталог = ОбъединитьПути(КорневойКаталог, "a-first");
	СоздатьКаталог(ПоследнийКаталог);
	СоздатьБенчмаркСКонфигурацией(ПоследнийКаталог, "Бенчмарк.os");
	СоздатьКаталог(СреднийКаталог);
	СоздатьБенчмаркСКонфигурацией(СреднийКаталог, "Бенчмарк.os");
	СоздатьКаталог(ПервыйКаталог);
	СоздатьБенчмаркСКонфигурацией(ПервыйКаталог, "Бенчмарк.os");

	// Действие
	ФайлыКонфигурации = _Локатор.НайтиФайлыКонфигурации(
		МассивИзОдногоЗначения(КорневойКаталог),
		Истина
	);

	// Проверка
	Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(3);
	Ожидаем.Что(ФайлыКонфигурации[0]).Равно(ПутьККонфигурации(ПервыйКаталог));
	Ожидаем.Что(ФайлыКонфигурации[1]).Равно(ПутьККонфигурации(СреднийКаталог));
	Ожидаем.Что(ФайлыКонфигурации[2]).Равно(ПутьККонфигурации(ПоследнийКаталог));

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьЯвныйФайлБезРасширенияOS() Экспорт

	// Подготовка
	КаталогБенчмарка = _МенеджерВременныхФайлов.СоздатьКаталог();
	СоздатьБенчмаркСКонфигурацией(КаталогБенчмарка, "ЯвныйБенчмарк.os");
	МассивФайлов = МассивИзОдногоЗначения("ЯвныйБенчмарк");
	УстановитьТекущийКаталог(КаталогБенчмарка);
	ОжидаемыйПутьККонфигурации = ФС.НормализоватьПуть("oscript.cfg");

	// Действие
	ФайлыКонфигурации = _Локатор.НайтиФайлыКонфигурации(МассивФайлов);

	// Проверка
	Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(1);
	Ожидаем.Что(ФайлыКонфигурации[0]).Равно(ОжидаемыйПутьККонфигурации);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьПутиБезКонфигурацииИНесуществующиеПути() Экспорт

	// Подготовка
	КаталогБенчмарков = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогЯвногоФайла = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКЯвномуФайлу = ОбъединитьПути(КаталогЯвногоФайла, "ЯвныйБенчмарк.os");
	ЗаписатьТекст(ОбъединитьПути(КаталогБенчмарков, "БенчмаркИзКаталога.os"), "");
	ЗаписатьТекст(ПутьКЯвномуФайлу, "");

	МассивФайлов = Новый Массив();
	МассивФайлов.Добавить(КаталогБенчмарков);
	МассивФайлов.Добавить(ПутьКЯвномуФайлу);
	МассивФайлов.Добавить(ОбъединитьПути(КаталогБенчмарков, "НесуществующийБенчмарк"));

	// Действие
	ФайлыКонфигурации = _Локатор.НайтиФайлыКонфигурации(МассивФайлов);

	// Проверка
	Ожидаем.Что(ФайлыКонфигурации).ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьБенчмаркСКонфигурацией(Каталог, ИмяФайла)

	ЗаписатьТекст(ОбъединитьПути(Каталог, ИмяФайла), "");
	ЗаписатьТекст(ОбъединитьПути(Каталог, "oscript.cfg"), "");

КонецПроцедуры

Процедура ЗаписатьТекст(ПутьКФайлу, Текст)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

Функция МассивИзОдногоЗначения(Значение)

	Результат = Новый Массив();
	Результат.Добавить(Значение);

	Возврат Результат;

КонецФункции

Функция ПутьККонфигурации(Каталог)

	Возврат ФС.НормализоватьПуть(ОбъединитьПути(Каталог, "oscript.cfg"));

КонецФункции

Функция ЭтоWindows()

	ТекущаяПлатформа = Новый СистемнаяИнформация().ТипПлатформы;

	Возврат ТекущаяПлатформа = ТипПлатформы.Windows_x86_64
		Или ТекущаяПлатформа = ТипПлатформы.Windows_x86;

КонецФункции

#КонецОбласти
