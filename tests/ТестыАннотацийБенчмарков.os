#Использовать asserts
#Использовать autumn
#Использовать reflector
#Использовать "helpers"
#Использовать "fixtures/benchmarks"

#Область Тесты

&Тест
Процедура ТестДолжен_РазвернутьВсеАннотацииБенчмаркаБезОшибок() Экспорт

	// Подготовка
	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	ТипБенчмарка = Тип("БенчмаркСоВсемиАннотациями");
	Рефлектор = Новый Рефлектор();
	КонтейнерАннотаций = Рефлектор.ПолучитьСвойство(Поделка, "КонтейнерАннотаций");
	РазворачивательАннотаций = КонтейнерАннотаций.ПолучитьРазворачивательАннотаций();

	Свойства = Рефлектор.ПолучитьТаблицуСвойств(ТипБенчмарка, Истина);
	Методы = Рефлектор.ПолучитьТаблицуМетодов(ТипБенчмарка);

	Для Каждого ИмяАннотации Из ИменаАннотацийБенчмарков() Цикл
		Ожидаем.Что(
			КонтейнерАннотаций.ПолучитьОпределениеАннотации(ИмяАннотации),
			СтрШаблон("Определение аннотации <%1>", ИмяАннотации)
		).Не_().Равно(Неопределено);

		Ожидаем.Что(
			СвойстваСодержатАннотацию(Свойства, ИмяАннотации)
				Или СвойстваСодержатАннотацию(Методы, ИмяАннотации),
			СтрШаблон("Аннотация <%1> в тестовом бенчмарке", ИмяАннотации)
		).ЭтоИстина();
	КонецЦикла;

	// Действие и Проверка
	РазворачивательАннотаций.РазвернутьАннотацииСвойств(Свойства, ТипБенчмарка);
	РазворачивательАннотаций.РазвернутьАннотацииСвойств(Методы, ТипБенчмарка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИменаАннотацийБенчмарков()

	Имена = "Бенчмарк, ИсполняющаяСреда, ИсточникПараметров, КаталогАртефактов, Категория"
		+ ", КоличествоВызововЗаИтерацию, КоличествоИтераций, КоличествоПрогревочныхИтераций"
		+ ", Колонка, КолонкаRatioSD, КолонкаВерхнийКвартиль, КолонкаМакс, КолонкаМедиана"
		+ ", КолонкаМин, КолонкаНижнийКвартиль, МинимальноеВремяИтерации"
		+ ", МинимальноеКоличествоВызововЗаИтерацию, МониторингПамяти, Параметры"
		+ ", ПередВсеми, ПередИтерацией, ПередКаждымКейсом, ПослеВсех, ПослеИтерации, ПослеКаждогоКейса"
		+ ", СортировкаОтБыстрыхКМедленным, СортировкаОтМедленныхКБыстрым, СортировкаПоМетоду"
		+ ", СтратегияПропускнаяСпособность, СтратегияХолодныйЗапуск"
		+ ", ЭкспортHtml, ЭкспортJson, ЭкспортMarkdown, Эталон";

	Возврат СтрРазделить(Имена, ", ", Ложь);

КонецФункции

Функция СвойстваСодержатАннотацию(Свойства, ИмяАннотации)

	Для Каждого Свойство Из Свойства Цикл
		Если РаботаСАннотациями.ПолучитьАннотацию(Свойство, ИмяАннотации) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
