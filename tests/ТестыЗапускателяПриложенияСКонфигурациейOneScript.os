// BSLLS:LineLength-off

#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать "helpers"

Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов
Перем _ИсходнаяТрассировкаЗагрузкиБиблиотек; // Строка
Перем _ИсходныйМаркерПримененияКонфигурацииOneScript; // Строка

#Область ОбработчикиСобытий

&Инициализация
Процедура ПередВсеми() Экспорт

	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_ИсходнаяТрассировкаЗагрузкиБиблиотек = ПолучитьПеременнуюСреды("OSLIB_LOADER_TRACE");
	_ИсходныйМаркерПримененияКонфигурацииOneScript = ПолучитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED");
	УстановитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED", "");

КонецПроцедуры

&Завершение
Процедура ПослеВсех() Экспорт

	_МенеджерВременныхФайлов.Удалить();
	УстановитьПеременнуюСреды("OSLIB_LOADER_TRACE", _ИсходнаяТрассировкаЗагрузкиБиблиотек);
	УстановитьПеременнуюСреды(
		"BENCHOS_OSCRIPT_CONFIG_APPLIED",
		_ИсходныйМаркерПримененияКонфигурацииOneScript
	);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПосчитатьЗагрузкиБиблиотекиВСклеенномВыводеПроцессов() Экспорт

	// Подготовка
	Вывод = "Загружаю файл allocs.dllПриЗагрузкеБиблиотеки C:\libraries\cmd" + Символы.ПС
		+ "ПриЗагрузкеБиблиотеки /usr/local/lib/cmd" + Символы.ПС
		+ "ПриЗагрузкеБиблиотеки C:\libraries\cmd-extra";

	// Действие
	КоличествоЗагрузок = КоличествоЗагрузокБиблиотеки(Вывод, "cmd");

	// Проверка
	Ожидаем.Что(КоличествоЗагрузок).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПерезапускатьПриложениеПриУстановленномМаркере() Экспорт

	// Подготовка
	КаталогКонфигурации = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКФайлуКонфигурации = ОбъединитьПути(КаталогКонфигурации, "oscript.cfg");
	ЗаписатьТекст(ПутьКФайлуКонфигурации, "lib.system=.");
	ФайлыКонфигурацииOneScript = Новый Массив();
	ФайлыКонфигурацииOneScript.Добавить(ПутьКФайлуКонфигурации);
	КаталогКоманд = ОбъединитьПути(
		ТекущийКаталог(),
		"src",
		"BenchmarkOneScript",
		"cmd"
	);
	КаталогКлассовКоманд = ОбъединитьПути(КаталогКоманд, "Классы");
	ПодключитьСценарий(
		ОбъединитьПути(КаталогКлассовКоманд, "ЗапускательПриложенияСКонфигурациейOneScript.os"),
		"ЗапускательПриложенияСКонфигурациейOneScript"
	);
	УстановитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED", "1");
	Запускатель = Новый ЗапускательПриложенияСКонфигурациейOneScript();

	// Действие
	Результат = Запускатель.ПерезапуститьСКонфигурацией(ФайлыКонфигурацииOneScript);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОдинРазПерезапуститьRunСКонфигурациямиOneScript() Экспорт

	// Подготовка
	КаталогЗапуска = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	КаталогКоманд = ОбъединитьПути(КаталогПроекта, "src", "BenchmarkOneScript", "cmd");
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(ОбъединитьПути(КаталогКоманд, "main.os"));
	КаталогПервогоБенчмарка = ОбъединитьПути(КаталогЗапуска, "first benchmarks");
	КаталогВложенногоПервогоБенчмарка = ОбъединитьПути(КаталогПервогоБенчмарка, "nested");
	КаталогЗависимостейПервогоБенчмарка = ОбъединитьПути(КаталогЗапуска, "first dependencies");
	ИмяКаталогаВторогоБенчмарка = "second'benchmarks";
	КаталогВторогоБенчмарка = ОбъединитьПути(КаталогЗапуска, ИмяКаталогаВторогоБенчмарка);
	КаталогЗависимостейВторогоБенчмарка = ОбъединитьПути(КаталогЗапуска, "second dependencies");
	УстановитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED", "");

	ЗаписатьТекст(
		ОбъединитьПути(КаталогЗапуска, "oscript.cfg"),
		СтрШаблон(
			"lib.system=%1",
			ФС.НормализоватьПуть(ОбъединитьПути(КаталогПроекта, "oscript_modules"))
		)
	);
	ФС.ОбеспечитьКаталог(КаталогПервогоБенчмарка);
	ЗаписатьТекст(
		ОбъединитьПути(КаталогПервогоБенчмарка, "oscript.cfg"),
		"systemlanguage=ru"
	);
	СоздатьБенчмаркСЛокальнойЗависимостью(
		КаталогВложенногоПервогоБенчмарка,
		"shareddependency",
		"ОбщаяЗависимость",
		"ПервыйБенчмарк",
		1,
		КаталогВложенногоПервогоБенчмарка,
		КаталогЗависимостейПервогоБенчмарка
	);
	СоздатьБенчмаркСЛокальнойЗависимостью(
		КаталогВторогоБенчмарка,
		"shareddependency",
		"ОбщаяЗависимость",
		"ВторойБенчмарк",
		2,
		КаталогВторогоБенчмарка,
		КаталогЗависимостейВторогоБенчмарка
	);
	АргументВторогоБенчмарка = ЭкранированиеАргументовКоманднойСтроки
		.ОбернутьАргументКоманднойСтрокиВКавычки(
			ИмяКаталогаВторогоБенчмарка + ПолучитьРазделительПути()
		);

	СтрокаКоманды = СтрШаблон(
		"%1 %2 run --recursive --iterationCount 1 --warmupCount 0 --invocationCount 1 --iterationTime 1 %3 %4",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
			ПутьКСтартовомуСценарию
		),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
			"first benchmarks"
		),
		АргументВторогоБенчмарка
	);
	УстановитьПеременнуюСреды("OSLIB_LOADER_TRACE", "1");

	// Действие
	Результат = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогЗапуска);

	// Проверка
	Ожидаем.Что(Результат.КодВозврата, Результат.Вывод).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит("ПервыйБенчмарк");
	Ожидаем.Что(Результат.Вывод).Содержит("ВторойБенчмарк");
	Ожидаем.Что(Результат.Вывод).Не_().Содержит("Не удалось подключить файл бенчмарка");
	Ожидаем.Что(
		КоличествоЗагрузокБиблиотеки(Результат.Вывод, "cmd"),
		Результат.Вывод
	).Равно(2);
	Ожидаем.Что(ПолучитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED")).Не_().Заполнено();

КонецПроцедуры

&Тест
&Параметры("--help", "Приложение: benchos", 1)
&Параметры("--version", "0.9.0", 1)
Процедура ТестДолжен_НеПерезапускатьСправочнуюКоманду(
	Аргумент,
	ОжидаемыйВывод,
	ОжидаемоеКоличествоЗагрузок
) Экспорт

	// Подготовка
	КаталогЗапуска = _МенеджерВременныхФайлов.СоздатьКаталог();
	КаталогПроекта = ФС.НормализоватьПуть(ТекущийКаталог());
	КаталогКоманд = ОбъединитьПути(КаталогПроекта, "src", "BenchmarkOneScript", "cmd");
	ПутьКСтартовомуСценарию = ФС.НормализоватьПуть(ОбъединитьПути(КаталогКоманд, "main.os"));
	УстановитьПеременнуюСреды("BENCHOS_OSCRIPT_CONFIG_APPLIED", "");

	ЗаписатьТекст(
		ОбъединитьПути(КаталогЗапуска, "oscript.cfg"),
		СтрШаблон(
			"lib.system=%1",
			ФС.НормализоватьПуть(ОбъединитьПути(КаталогПроекта, "oscript_modules"))
		)
	);
	СтрокаКоманды = СтрШаблон(
		"%1 %2 %3",
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьИсполняемыйФайлВКавычки("oscript"),
		ЭкранированиеАргументовКоманднойСтроки.ОбернутьАргументКоманднойСтрокиВКавычки(
			ПутьКСтартовомуСценарию
		),
		Аргумент
	);
	УстановитьПеременнуюСреды("OSLIB_LOADER_TRACE", "1");

	// Действие
	Результат = ТестированиеПроцессов.ВыполнитьКоманду(СтрокаКоманды, КаталогЗапуска);

	// Проверка
	Ожидаем.Что(Результат.КодВозврата, Результат.Вывод).Равно(0);
	Ожидаем.Что(Результат.Вывод).Содержит(ОжидаемыйВывод);
	Ожидаем.Что(КоличествоЗагрузокБиблиотеки(Результат.Вывод, "cmd")).Равно(
		ОжидаемоеКоличествоЗагрузок
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьБенчмаркСЛокальнойЗависимостью(
	КаталогБенчмарка,
	ИмяПакета,
	ИмяМодуля,
	ИмяМетода,
	ОжидаемоеЗначение,
	КаталогКонфигурацииOneScript = Неопределено,
	КаталогЛокальныхБиблиотек = Неопределено
)

	Если КаталогКонфигурацииOneScript = Неопределено Тогда
		КаталогКонфигурацииOneScript = КаталогБенчмарка;
	КонецЕсли;

	Если КаталогЛокальныхБиблиотек = Неопределено Тогда
		КаталогЛокальныхБиблиотек = ОбъединитьПути(КаталогКонфигурацииOneScript, "oscript_modules");
	КонецЕсли;

	КаталогМодулейПакета = ОбъединитьПути(КаталогЛокальныхБиблиотек, ИмяПакета, "src", "Модули");
	ФС.ОбеспечитьКаталог(КаталогБенчмарка);
	ФС.ОбеспечитьКаталог(КаталогМодулейПакета);
	КопироватьФайл(
		ОбъединитьПути(ТекущийКаталог(), "oscript_modules", "package-loader.os"),
		ОбъединитьПути(КаталогЛокальныхБиблиотек, "package-loader.os")
	);

	ЗаписатьТекст(
		ОбъединитьПути(КаталогКонфигурацииOneScript, "oscript.cfg"),
		"lib.system=" + ФС.НормализоватьПуть(КаталогЛокальныхБиблиотек)
	);
	ЗаписатьТекст(
		ОбъединитьПути(КаталогМодулейПакета, ИмяМодуля + ".os"),
		СтрШаблон(
			"Функция ПолучитьЗначение() Экспорт
			|    Возврат %1;
			|КонецФункции",
			ОжидаемоеЗначение
		)
	);
	ЗаписатьТекст(
		ОбъединитьПути(КаталогБенчмарка, ИмяМетода + ".os"),
		СтрШаблон(
			"#Использовать %1
			|
			|&Бенчмарк
			|Процедура %2() Экспорт
			|    Если %3.ПолучитьЗначение() <> %4 Тогда
			|        ВызватьИсключение ""Локальная зависимость вернула неожиданное значение"";
			|    КонецЕсли;
			|КонецПроцедуры",
			ИмяПакета,
			ИмяМетода,
			ИмяМодуля,
			ОжидаемоеЗначение
		)
	);

КонецПроцедуры

Функция КоличествоЗагрузокБиблиотеки(Вывод, ИмяБиблиотеки)

	Шаблон = СтрШаблон(
		"(?im)ПриЗагрузкеБиблиотеки[ \t]+[^\r\n]*[/\\]%1\r?$",
		ИмяБиблиотеки
	);
	РегулярноеВыражение = Новый РегулярноеВыражение(Шаблон);

	Возврат РегулярноеВыражение.НайтиСовпадения(Вывод).Количество();

КонецФункции

Процедура ЗаписатьТекст(ПутьКФайлу, Текст)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

#КонецОбласти
