#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВременныеПоказателиСтандартнойВыборки(Статистика, Коэффициент, Описание)

	Ожидаем.Что(Статистика.Мин, "Мин " + Описание).Равно(12 / Коэффициент);
	Ожидаем.Что(Статистика.НижнийКвартиль, "Нижний квартиль " + Описание).Равно(14.5 / Коэффициент);
	Ожидаем.Что(Статистика.Медиана, "Медиана " + Описание).Равно(17 / Коэффициент);
	Ожидаем.Что(Статистика.Среднее, "Среднее " + Описание).Равно(19 / Коэффициент);
	Ожидаем.Что(Статистика.ВерхнийКвартиль, "Верхний квартиль " + Описание).Равно(23.5 / Коэффициент);
	Ожидаем.Что(Статистика.Макс, "Макс " + Описание).Равно(28 / Коэффициент);
	Ожидаем.Что(Статистика.СтандартноеОтклонение, "Стандартное отклонение " + Описание).Между(6.05 / Коэффициент, 6.06 / Коэффициент);
	Ожидаем.Что(Статистика.СтандартнаяОшибкаСреднего, "Стандартная ошибка " + Описание).Между(2.2 / Коэффициент, 2.3 / Коэффициент);

КонецПроцедуры

Функция НекорректнаяЕдиница(ВариантЕдиницы)

	Если ВариантЕдиницы = "Неопределено" Тогда
		Возврат Неопределено;
	ИначеЕсли ВариантЕдиницы = "Строка" Тогда
		Возврат "Миллисекунда";
	ИначеЕсли ВариантЕдиницы = "Байт" Тогда
		Возврат ЕдиницыИзмеренийБенчмарков.Байт();
	ИначеЕсли ВариантЕдиницы = "НулевойКоэффициент" Тогда
		Коэффициент = 0;
	ИначеЕсли ВариантЕдиницы = "ОтрицательныйКоэффициент" Тогда
		Коэффициент = -1;
	ИначеЕсли ВариантЕдиницы = "СтроковыйКоэффициент" Тогда
		Коэффициент = "1000";
	КонецЕсли;

	Возврат Новый ЕдиницаИзмеренияБенчмарка(
		"invalid",
		"Некорректная единица",
		ЕдиницыИзмеренийБенчмарков.Наносекунда(),
		Коэффициент
	);

КонецФункции

Функция СнимокСтатистики(Статистика)

	Снимок = Новый Структура();
	Снимок.Вставить("КоличествоИтераций", Статистика.КоличествоИтераций);
	Снимок.Вставить("Мин", Статистика.Мин);
	Снимок.Вставить("НижнийКвартиль", Статистика.НижнийКвартиль);
	Снимок.Вставить("Медиана", Статистика.Медиана);
	Снимок.Вставить("Среднее", Статистика.Среднее);
	Снимок.Вставить("ВерхнийКвартиль", Статистика.ВерхнийКвартиль);
	Снимок.Вставить("Макс", Статистика.Макс);
	Снимок.Вставить("СтандартноеОтклонение", Статистика.СтандартноеОтклонение);
	Снимок.Вставить("СтандартнаяОшибкаСреднего", Статистика.СтандартнаяОшибкаСреднего);
	Снимок.Вставить("ОперацийВСекунду", Статистика.ОперацийВСекунду);
	Снимок.Вставить("ВыделяемаяПамять", Статистика.ВыделяемаяПамять);
	Снимок.Вставить("Квантиль", Статистика.Квантиль(0.5));
	Снимок.Вставить("ЗамерыВремени", Статистика.ЗамерыВремени());
	Снимок.Вставить("ЗамерыПамяти", Статистика.ЗамерыПамяти());
	Снимок.Вставить("Представление", Строка(Статистика));

	Возврат Снимок;

КонецФункции

Функция МассивЧисел(Значения)

	Результат = Новый Массив();
	Для Каждого Значение Из СтрРазделить(Значения, ",", Ложь) Цикл
		Результат.Добавить(Число(Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТестовыеЗамеры(СтрокаЗамерыВремени, СтрокаЗамерыПамяти, Множитель = 1) Экспорт

	Замеры = Новый Массив();

	МассивЗамеровВремени = СтрРазделить(СтрокаЗамерыВремени, ",", Ложь);
	МассивЗамеровПамяти = СтрРазделить(СтрокаЗамерыПамяти, ",", Ложь);

	Для Каждого НаносекундЗаОперацию Из МассивЗамеровВремени Цикл
		Замер = Новый РезультатИтерацииКейса();
		Замер.Этап = ЭтапыБенчмарка.Измерение();
		Замер.НаносекундЗаОперацию = Число(НаносекундЗаОперацию) * Множитель;
		Замеры.Добавить(Замер);
	КонецЦикла;

	Для Каждого ВыделяемаяПамятьЗаОперацию Из МассивЗамеровПамяти Цикл
		Замер = Новый РезультатИтерацииКейса();
		Замер.Этап = ЭтапыБенчмарка.Память();
		Замер.ВыделяемаяПамятьЗаОперацию = Число(ВыделяемаяПамятьЗаОперацию) * Множитель;
		Замеры.Добавить(Замер);
	КонецЦикла;

	Возврат Замеры;

КонецФункции

#КонецОбласти
