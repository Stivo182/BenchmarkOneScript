Процедура ТестДолжен_ОтклонитьНекорректнуюЕдиницуБезИзмененияСтатистики(ВариантЕдиницы) Экспорт

	// Подготовка
	Статистика = Новый СтатистикаБенчмарка(ТестовыеЗамеры("100, 200, 300", "100, 200"));
	ИсходноеСостояние = СнимокСтатистики(Статистика);
	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить(НекорректнаяЕдиница(ВариантЕдиницы));

	// Действие и Проверка
	Ожидаем.Что(Статистика).ИмеетМетод("УстановитьЕдиницуВремени");
	Ожидаем
		.Что(Статистика)
		.Метод("УстановитьЕдиницуВремени", ПараметрыМетода)
		.ВыбрасываетИсключение();
	Ожидаем.Что(СнимокСтатистики(Статистика)).Идентично(ИсходноеСостояние);

КонецПроцедуры

