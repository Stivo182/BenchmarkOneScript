&Тест
Процедура ТестДолжен_ИзолироватьКопиюОтВходныхМассивовИПовторногоЧтения() Экспорт

	// Подготовка
	ВходныеЗамерыВремени = МассивЧисел("1000, 3000");
	ВходныеЗамерыПамяти = МассивЧисел("100, 300");
	ВходныеЗамеры = Новый Структура(
		"ЗамерыВремени, ЗамерыПамяти",
		ВходныеЗамерыВремени,
		ВходныеЗамерыПамяти
	);
	Оригинал = Новый СтатистикаБенчмарка(ВходныеЗамеры);
	Копия = Оригинал.ВМикросекунды();
	ИсходноеСостояниеОригинала = СнимокСтатистики(Оригинал);
	ИсходноеСостояниеКопии = СнимокСтатистики(Копия);

	// Действие
	ВходныеЗамерыВремени[0] = 9000;
	ВходныеЗамерыВремени.Добавить(11000);
	ВходныеЗамерыПамяти[0] = 900;
	ВходныеЗамерыПамяти.Добавить(1100);

	// Проверка
	Ожидаем.Что(СнимокСтатистики(Оригинал), "Оригинал после изменения входных массивов")
		.Идентично(ИсходноеСостояниеОригинала);
	Ожидаем.Что(СнимокСтатистики(Копия), "Копия после изменения входных массивов")
		.Идентично(ИсходноеСостояниеКопии);

	// Действие
	НовыеЗамерыВремени = МассивЧисел("5000, 7000");
	НовыеЗамерыПамяти = МассивЧисел("500, 700");
	НовыеЗамеры = Новый Структура(
		"ЗамерыВремени, ЗамерыПамяти",
		НовыеЗамерыВремени,
		НовыеЗамерыПамяти
	);
	Копия.Прочитать(НовыеЗамеры);

	// Проверка
	Ожидаем.Что(СнимокСтатистики(Оригинал), "Оригинал после чтения копией новых замеров")
		.Идентично(ИсходноеСостояниеОригинала);
	Ожидаем.Что(Копия.Среднее, "Среднее обновленной копии").Равно(6);
	Ожидаем.Что(Копия.Квантиль(0.5), "Квантиль обновленной копии").Равно(6);
	Ожидаем.Что(Копия.ВыделяемаяПамять, "Память обновленной копии").Равно(600);

КонецПроцедуры

