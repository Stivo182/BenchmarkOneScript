&Тест
&Параметры("ВСекунды", 1000000000)
&Параметры("ВМиллисекунды", 1000000)
&Параметры("ВМикросекунды", 1000)
&Параметры("ВНаносекунды", 1)
Процедура ТестДолжен_ВернутьКопиюСтатистикиВЦелевойЕдинице(ИмяМетода, Коэффициент) Экспорт

	// Подготовка
	Статистика = Новый СтатистикаБенчмарка(
		ТестовыеЗамеры("12, 15, 22, 25, 17, 28, 14", "100, 101")
	);
	Рефлектор = Новый Рефлектор;

	// Действие
	Результат = Рефлектор.ВызватьМетод(Статистика, ИмяМетода);

	// Проверка
	Ожидаем.Что(Результат, "Результат конвертации").Не_().Равно(Статистика);
	ПроверитьВременныеПоказателиСтандартнойВыборки(Результат, Коэффициент, "результата");
	Ожидаем.Что(Результат.Квантиль(0.5), "Квантиль результата").Равно(17 / Коэффициент);
	ПроверитьВременныеПоказателиСтандартнойВыборки(Статистика, 1, "исходной статистики");
	Ожидаем.Что(Статистика.Квантиль(0.5), "Квантиль исходной статистики").Равно(17);

КонецПроцедуры

&Тест
&Параметры("ВСекунды", 1000000000)
&Параметры("ВМиллисекунды", 1000000)
&Параметры("ВМикросекунды", 1000)
&Параметры("ВНаносекунды", 1)
Процедура ТестДолжен_ВернутьКопиюИзКаноническогоСостояния(ИмяМетода, Коэффициент) Экспорт

	// Подготовка
	ПользовательскаяЕдиница = Новый ЕдиницаИзмеренияБенчмарка(
		"10ns",
		"Десяток наносекунд",
		ЕдиницыИзмеренийБенчмарков.Наносекунда(),
		10
	);
	Статистика = Новый СтатистикаБенчмарка(
		ТестовыеЗамеры("12, 15, 22, 25, 17, 28, 14", "100, 101")
	);
	Статистика.УстановитьЕдиницуВремени(ПользовательскаяЕдиница);
	Статистика.Среднее = 999;
	Рефлектор = Новый Рефлектор;

	// Действие
	Результат = Рефлектор.ВызватьМетод(Статистика, ИмяМетода);

	// Проверка
	ПроверитьВременныеПоказателиСтандартнойВыборки(Результат, Коэффициент, "результата");
	Ожидаем.Что(Результат.Квантиль(0.5), "Квантиль результата").Равно(17 / Коэффициент);
	Ожидаем.Что(Статистика.Среднее, "Измененное среднее исходной статистики").Равно(999);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНаносекундыПослеЦепочкиЧистыхКонвертаций() Экспорт

	// Подготовка
	Статистика = Новый СтатистикаБенчмарка(
		ТестовыеЗамеры("12, 15, 22, 25, 17, 28, 14", "100, 101")
	);

	// Действие
	Результат = Статистика.ВСекунды().ВНаносекунды();

	// Проверка
	Ожидаем.Что(Результат, "Результат конвертации").Не_().Равно(Статистика);
	ПроверитьВременныеПоказателиСтандартнойВыборки(Результат, 1, "результата");
	Ожидаем.Что(Результат.Квантиль(0.5), "Квантиль результата").Равно(17);
	ПроверитьВременныеПоказателиСтандартнойВыборки(Статистика, 1, "исходной статистики");
	Ожидаем.Что(Статистика.Квантиль(0.5), "Квантиль исходной статистики").Равно(17);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзменитьЕдиницуВремениТекущейСтатистики() Экспорт

	// Подготовка
	Статистика = Новый СтатистикаБенчмарка(
		ТестовыеЗамеры("12000000, 15000000, 22000000, 25000000, 17000000, 28000000, 14000000", "100, 200")
	);

	// Действие
	Результат = Статистика.УстановитьЕдиницуВремени(ЕдиницыИзмеренийБенчмарков.Миллисекунда());

	// Проверка
	Ожидаем.Что(Результат, "Результат установки единицы").Равно(Статистика);
	ПроверитьВременныеПоказателиСтандартнойВыборки(Статистика, 1, "текущей статистики");
	Ожидаем.Что(Статистика.Квантиль(0.5), "Квантиль").Равно(17);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПользовательскуюЕдиницуПослеПовторногоЧтения() Экспорт

	// Подготовка
	ПользовательскаяЕдиница = Новый ЕдиницаИзмеренияБенчмарка(
		"10ns",
		"Десяток наносекунд",
		ЕдиницыИзмеренийБенчмарков.Наносекунда(),
		10
	);
	Статистика = Новый СтатистикаБенчмарка(ТестовыеЗамеры("100, 200", "100, 200"));
	Статистика.УстановитьЕдиницуВремени(ПользовательскаяЕдиница);

	// Действие
	Статистика.Прочитать(ТестовыеЗамеры("300, 500", "300, 500"));

	// Проверка
	Ожидаем.Что(Статистика.Среднее, "Среднее").Равно(40);
	Ожидаем.Что(Статистика.Квантиль(0.5), "Квантиль").Равно(40);
	Ожидаем.Что(Строка(Статистика), "Представление статистики").Содержит("10ns");

КонецПроцедуры

