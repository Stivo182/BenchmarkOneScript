// BSLLS:MagicNumber-off

#Использовать fluent
#Использовать asserts
#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ПрочитатьЧисловыеЗамерыВремениИПамяти() Экспорт

	// Подготовка
	ЗамерыВремени = Новый Массив();
	ЗамерыВремени.Добавить(10);
	ЗамерыВремени.Добавить(20);
	ЗамерыВремени.Добавить(30);

	ЗамерыПамяти = Новый Массив();
	ЗамерыПамяти.Добавить(100);
	ЗамерыПамяти.Добавить(200);

	Замеры = Новый Структура("ЗамерыВремени,ЗамерыПамяти", ЗамерыВремени, ЗамерыПамяти);
	Статистика = Новый СтатистикаБенчмарка();

	// Действие
	Статистика.Прочитать(Замеры);

	// Проверка
	Ожидаем.Что(Статистика.Среднее).Равно(20);
	Ожидаем.Что(Статистика.ВыделяемаяПамять).Равно(150);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РассчитатьКоличествоВыбросовПоРезультатамИтераций() Экспорт

	// Подготовка
	РезультатыИтераций = ТестовыеЗамеры("10, 11, 12, 13, 100", "");
	Статистика = Новый СтатистикаБенчмарка();

	// Действие
	Статистика.Прочитать(РезультатыИтераций);

	// Проверка
	Ожидаем.Что(Статистика.КоличествоВыбросов).Равно(1);
	Ожидаем.Что(РезультатыИтераций[4].ЭтоВыброс).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПересчитатьСтатистикуКейсаИПометитьВыбросы() Экспорт

	// Подготовка
	РезультатЗапускаКейса = Новый РезультатЗапускаКейса();
	РезультатЗапускаКейса.Замеры = ТестовыеЗамеры("10, 11, 12, 13, 100", "");

	// Действие
	РезультатЗапускаКейса.ПересчитатьСтатистику();

	// Проверка
	Ожидаем.Что(РезультатЗапускаКейса.Статистика.КоличествоВыбросов).Равно(1);
	Ожидаем.Что(РезультатЗапускаКейса.Замеры[4].ЭтоВыброс).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьПустуюКоллекциюЗамеров() Экспорт

	// Подготовка
	Статистика = Новый СтатистикаБенчмарка();

	// Действие
	Статистика.Прочитать(Новый Массив());

	// Проверка
	Ожидаем.Что(Статистика.Среднее, "Среднее").Равно(0);
	Ожидаем.Что(Статистика.Мин, "Мин").Равно(0);
	Ожидаем.Что(Статистика.Макс, "Макс").Равно(0);
	Ожидаем.Что(Статистика.Медиана, "Медиана").Равно(0);
	Ожидаем.Что(Статистика.НижнийКвартиль, "НижнийКвартиль").Равно(0);
	Ожидаем.Что(Статистика.ВерхнийКвартиль, "ВерхнийКвартиль").Равно(0);
	Ожидаем.Что(Статистика.СтандартноеОтклонение, "Стандартное отклонение").Равно(0);
	Ожидаем.Что(Статистика.СтандартнаяОшибкаСреднего, "Стандартная ошибка").Равно(0);
	Ожидаем.Что(Статистика.Квантиль(0), "Квантиль 0").Равно(0);
	Ожидаем.Что(Статистика.Квантиль(0.3), "Квантиль 0.3").Равно(0);
	Ожидаем.Что(Статистика.Квантиль(1), "Квантиль 1").Равно(0);
	Ожидаем.Что(Статистика.ОперацийВСекунду, "Операций в секунду").Равно(0);
	Ожидаем.Что(Статистика.ВыделяемаяПамять, "Выделяемая память").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РассчитатьСтатистикуДляНечетногоКоличестваЗамеров() Экспорт

	// Подготовка
	ТестовыеЗамеры = ТестовыеЗамеры("12, 15, 22, 25, 17, 28, 14", "100, 101, 102");

	// Действие
	Статистика = Новый СтатистикаБенчмарка(ТестовыеЗамеры);

	// Проверка
	Ожидаем.Что(Статистика.Среднее, "Среднее").Равно(19);
	Ожидаем.Что(Статистика.Мин, "Мин").Равно(12);
	Ожидаем.Что(Статистика.Макс, "Макс").Равно(28);
	Ожидаем.Что(Статистика.Медиана, "Медиана").Равно(17);
	Ожидаем.Что(Статистика.НижнийКвартиль, "НижнийКвартиль").Равно(14.5);
	Ожидаем.Что(Статистика.ВерхнийКвартиль, "ВерхнийКвартиль").Равно(23.5);
	Ожидаем.Что(Статистика.СтандартноеОтклонение, "Стандартное отклонение").Между(6.05, 6.06);
	Ожидаем.Что(Статистика.СтандартнаяОшибкаСреднего, "Стандартная ошибка").Между(2.2, 2.3);
	Ожидаем.Что(Статистика.Квантиль(0), "Квантиль 0").Равно(12);
	Ожидаем.Что(Статистика.Квантиль(0.3), "Квантиль 0.3").Равно(14.8);
	Ожидаем.Что(Статистика.Квантиль(0.5), "Квантиль 0.5").Равно(17);
	Ожидаем.Что(Статистика.Квантиль(1), "Квантиль 1").Равно(28);
	Ожидаем.Что(Статистика.ОперацийВСекунду, "Операций в секунду").Между(52631578, 52631579);
	Ожидаем.Что(Статистика.ВыделяемаяПамять, "Выделяемая память").Равно(101);

КонецПроцедуры

