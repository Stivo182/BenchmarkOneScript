&Тест
Процедура ТестДолжен_РассчитатьДоверительныйИнтервалИДетектироватьВыброс() Экспорт

	// Подготовка
	Замеры = ТестовыеЗамеры("10, 11, 12, 13, 100", "");

	// Действие
	Статистика = Новый СтатистикаБенчмарка(Замеры);

	// Проверка
	Ожидаем.Что(Статистика.ПогрешностьСреднего, "Погрешность среднего").Больше(0);
	Ожидаем.Что(Статистика.НижняяГраницаДоверительногоИнтервала, "Нижняя граница").Меньше(Статистика.Среднее);
	Ожидаем.Что(Статистика.ВерхняяГраницаДоверительногоИнтервала, "Верхняя граница").Больше(Статистика.Среднее);
	Ожидаем.Что(Статистика.КоличествоВыбросов, "Количество выбросов").Равно(1);

КонецПроцедуры

