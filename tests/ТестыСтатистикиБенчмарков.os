Процедура ТестДолжен_СохранитьОстальноеПоведениеВЧистойКопии() Экспорт

	// Подготовка
	Статистика = Новый СтатистикаБенчмарка(ТестовыеЗамеры("1000, 2000, 3000", "100, 200"));
	Делитель = Новый СтатистикаБенчмарка(ТестовыеЗамеры("1000, 1000, 1000", "50, 50"));
	Копия = Статистика.ВМикросекунды();

	// Действие
	ЗамерыВремени = Копия.ЗамерыВремени();
	ЗамерыПамяти = Копия.ЗамерыПамяти();
	РезультатДеления = Копия.Разделить(Делитель);
	Процентили = Копия.ПолучитьПроцентили();
	Представление = Строка(Копия);

	// Проверка
	Ожидаем.Что(ЗамерыВремени).Идентично(МассивЧисел("1000, 2000, 3000"));
	Ожидаем.Что(ЗамерыПамяти).Идентично(МассивЧисел("100, 200"));
	Ожидаем.Что(РезультатДеления.Среднее, "Среднее результата деления").Равно(2);
	Ожидаем.Что(РезультатДеления.Квантиль(0.5), "Квантиль результата деления").Равно(2);
	Ожидаем.Что(РезультатДеления.ВыделяемаяПамять, "Память результата деления").Равно(3);
	Ожидаем.Что(Процентили.P50, "P50").Равно(2);
	Ожидаем.Что(Представление).Содержит("us");
	Ожидаем.Что(Статистика.Среднее, "Среднее исходной статистики").Равно(2000);

