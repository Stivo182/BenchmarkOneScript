#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать "helpers"

Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов
Перем _ИсходныйТекущийКаталог; // Строка

#Область ОбработчикиСобытий

&Инициализация
Процедура ПередВсеми() Экспорт

	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_ИсходныйТекущийКаталог = ТекущийКаталог();

КонецПроцедуры

&Завершение
Процедура ПослеВсех() Экспорт

	УстановитьТекущийКаталог(_ИсходныйТекущийКаталог);
	_МенеджерВременныхФайлов.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_РазрешитьЯвныйФайлБезРасширенияИОтметитьНесуществующийПуть() Экспорт

	// Подготовка
	Каталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКФайлу = ОбъединитьПути(Каталог, "ЯвныйБенчмарк.os");
	ЗаписатьТекст(ПутьКФайлу, "");

	ВходныеПути = Новый Массив();
	ВходныеПути.Добавить("ЯвныйБенчмарк");
	ВходныеПути.Добавить("НесуществующийБенчмарк");

	// Действие
	Результат = РазрешитьИзКаталога(Каталог, ВходныеПути);

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(Результат[0].Разрешен).ЭтоИстина();
	Ожидаем.Что(Результат[0].ВходнойКаталог).Равно(Неопределено);
	Ожидаем.Что(Результат[0].Файлы).ИмеетДлину(1);
	Ожидаем.Что(Результат[0].Файлы[0]).Равно(ФС.НормализоватьПуть(ПутьКФайлу));
	Ожидаем.Что(Результат[1].Разрешен).ЭтоЛожь();
	Ожидаем.Что(Результат[1].Файлы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКорневойКаталогИОтсортированныеРекурсивныеФайлы() Экспорт

	// Подготовка
	КорневойКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПервыйКаталог = ОбъединитьПути(КорневойКаталог, "a-first");
	ПоследнийКаталог = ОбъединитьПути(КорневойКаталог, "z-last");
	СоздатьКаталог(ПоследнийКаталог);
	СоздатьКаталог(ПервыйКаталог);

	ПоследнийФайл = ОбъединитьПути(ПоследнийКаталог, "Бенчмарк.os");
	ПервыйФайл = ОбъединитьПути(ПервыйКаталог, "Бенчмарк.os");
	ЗаписатьТекст(ПоследнийФайл, "");
	ЗаписатьТекст(ПервыйФайл, "");

	// Действие
	Результат = Новый РазрешательВходныхФайловБенчмарков().Разрешить(
		МассивИзОдногоЗначения(КорневойКаталог),
		Истина
	);

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(1);
	Ожидаем.Что(Результат[0].Разрешен).ЭтоИстина();
	Ожидаем.Что(Результат[0].ВходнойКаталог).Равно(ФС.НормализоватьПуть(КорневойКаталог));
	Ожидаем.Что(Результат[0].Файлы).ИмеетДлину(2);
	Ожидаем.Что(Результат[0].Файлы[0]).Равно(ФС.НормализоватьПуть(ПервыйФайл));
	Ожидаем.Что(Результат[0].Файлы[1]).Равно(ФС.НормализоватьПуть(ПоследнийФайл));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьФайлТолькоУПервогоВхода() Экспорт

	// Подготовка
	Каталог = _МенеджерВременныхФайлов.СоздатьКаталог();
	ПутьКФайлу = ОбъединитьПути(Каталог, "Бенчмарк.os");
	ЗаписатьТекст(ПутьКФайлу, "");

	ВходныеПути = Новый Массив();
	ВходныеПути.Добавить(ПутьКФайлу);
	ВходныеПути.Добавить(Каталог);

	// Действие
	Результат = Новый РазрешательВходныхФайловБенчмарков().Разрешить(ВходныеПути);

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(Результат[0].Файлы).ИмеетДлину(1);
	Ожидаем.Что(Результат[1].Файлы).ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьИзКаталога(Каталог, ВходныеПути)

	ИсходныйТекущийКаталог = ТекущийКаталог();
	УстановитьТекущийКаталог(Каталог);

	Попытка
		Результат = Новый РазрешательВходныхФайловБенчмарков().Разрешить(ВходныеПути);
	Исключение
		УстановитьТекущийКаталог(ИсходныйТекущийКаталог);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьТекущийКаталог(ИсходныйТекущийКаталог);

	Возврат Результат;

КонецФункции

Функция МассивИзОдногоЗначения(Значение)

	Результат = Новый Массив();
	Результат.Добавить(Значение);

	Возврат Результат;

КонецФункции

Процедура ЗаписатьТекст(ПутьКФайлу, Текст)

	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

#КонецОбласти
