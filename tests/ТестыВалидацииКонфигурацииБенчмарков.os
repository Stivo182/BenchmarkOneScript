&Тест
Процедура ТестДолжен_ВыброситьИсключениеПриНевалидныхНастройкахАдаптивныхИтераций() Экспорт

	Конфигурация = Новый КонфигурацияБенчмарков();
	НевалидныеПогрешности = Новый Массив();
	НевалидныеПогрешности.Добавить(0);
	НевалидныеПогрешности.Добавить(-0.01);

	Для Каждого НевалиднаяПогрешность Из НевалидныеПогрешности Цикл
		Параметры = Новый Массив();
		Параметры.Добавить(НевалиднаяПогрешность);

		Ожидаем.Что(Конфигурация).Метод("УстановитьЦелевуюОтносительнуюПогрешность", Параметры).ВыбрасываетИсключение();
	КонецЦикла;

	Параметры = Новый Массив();
	Параметры.Добавить(1);

	Ожидаем.Что(Конфигурация).Метод("УстановитьМинимальноеКоличествоАдаптивныхИтераций", Параметры).ВыбрасываетИсключение();
	Ожидаем.Что(Конфигурация).Метод("УстановитьМаксимальноеКоличествоАдаптивныхИтераций", Параметры).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьДробноеКоличествоАдаптивныхИтераций() Экспорт

	// Подготовка
	Конфигурация = Новый КонфигурацияБенчмарков();

	// Действие
	МинимумОтклонен = Ложь;
	Попытка
		Конфигурация.УстановитьМинимальноеКоличествоАдаптивныхИтераций(2.5);
	Исключение
		МинимумОтклонен = Истина;
	КонецПопытки;

	МаксимумОтклонен = Ложь;
	Попытка
		Конфигурация.УстановитьМаксимальноеКоличествоАдаптивныхИтераций(2.5);
	Исключение
		МаксимумОтклонен = Истина;
	КонецПопытки;

	// Проверка
	Ожидаем.Что(МинимумОтклонен).ЭтоИстина();
	Ожидаем.Что(МаксимумОтклонен).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИсключениеПриНевалидныхНастройкахСтатистическогоСравнения() Экспорт

	Конфигурация = Новый КонфигурацияБенчмарков();
	Параметры = Новый Массив();
	Параметры.Добавить(-0.01);

	Ожидаем.Что(Конфигурация).Метод("УстановитьОтносительныйПорогПрактическойЗначимости", Параметры).ВыбрасываетИсключение();

	НевалидныеУровниЗначимости = Новый Массив();
	НевалидныеУровниЗначимости.Добавить(0);
	НевалидныеУровниЗначимости.Добавить(1);

	Для Каждого НевалидныйУровеньЗначимости Из НевалидныеУровниЗначимости Цикл
		Параметры = Новый Массив();
		Параметры.Добавить(НевалидныйУровеньЗначимости);

		Ожидаем.Что(Конфигурация).Метод("УстановитьУровеньЗначимостиСтатистическогоСравнения", Параметры).ВыбрасываетИсключение();
	КонецЦикла;

КонецПроцедуры

