КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТестовыйРезультат()
	Результат = Новый РезультатЗапускаБенчмарков();
	Результат.Запуски.Добавить(ТестовыйЗапуск(
		1, "Сортировка", "Основные", Новый Структура("Размер", 100),
		"1.9.0", Ложь, "1000000, 2000000", "1024, 2048"
	));
	Результат.Запуски.Добавить(ТестовыйЗапуск(
		2, "Сортировка", "Основные", Новый Структура("Размер", 1000),
		"2.0.0", Ложь, "2000000, 3000000", "2048, 4096"
	));
	Результат.Запуски.Добавить(ТестовыйЗапуск(
		3, "Поиск", "Критичные", Новый Структура("Размер, Режим", 1000, "Быстрый"),
		"2.0.0", Истина, "500000, 1000000", "512, 1024"
	));
	Возврат Результат;
КонецФункции

Функция ТестовыйЗапуск(
	Идентификатор, Метод, Категория, Параметры,
	Версия, ЭтоЭталон, ЗамерыВремени, ЗамерыПамяти
)
	Дескриптор = Новый ДескрипторБенчмарка(Неопределено, Метод);
	Дескриптор.УстановитьКатегорию(Категория);
	Дескриптор.ИспользоватьКакЭталон(ЭтоЭталон);
	ПараметрыКейса = Новый Массив();
	Для Каждого Параметр Из Параметры Цикл
		ПараметрыКейса.Добавить(Новый ПараметрБенчмарка(Параметр.Ключ, Параметр.Значение));
	КонецЦикла;
	Среда = Новый ИсполняющаяСредаБенчмарков();
	Среда.Версия = Версия;
	Результат = Новый РезультатЗапускаКейса();
	Результат.Кейс = Новый КейсБенчмарка(Идентификатор, Дескриптор, ПараметрыКейса, Среда);
	Результат.ЭтоЭталон = ЭтоЭталон;
	Результат.Статистика = Новый СтатистикаБенчмарка(Новый Структура(
		"ЗамерыВремени, ЗамерыПамяти",
		МассивЧисел(ЗамерыВремени),
		МассивЧисел(ЗамерыПамяти)
	));
	Возврат Результат;
КонецФункции

Функция МассивЧисел(СтрокаЗначений)
	Результат = Новый Массив();
	Если ПустаяСтрока(СтрокаЗначений) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Значение Из СтрРазделить(СтрокаЗначений, ",") Цикл
		Результат.Добавить(Число(СокрЛП(Значение)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьТекущийИдентификаторКолонки() Экспорт

	// Подготовка
	ИсходныйИдентификатор = КолонкиОтчетаБенчмарков.Мин;

	Попытка
		КолонкиОтчетаБенчмарков.Мин = "ИзмененныйИдентификатор";

		// Действие и Проверка
		Ожидаем.Что(МетрикиБенчмарков.Минимум()).Равно(КолонкиОтчетаБенчмарков.Мин);
	Исключение
		КолонкиОтчетаБенчмарков.Мин = ИсходныйИдентификатор;
		ВызватьИсключение;
	КонецПопытки;

	КолонкиОтчетаБенчмарков.Мин = ИсходныйИдентификатор;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьИдентификаторыЧисловыхМетрик() Экспорт

	// Действие и Проверка
	Метрики = МетрикиБенчмарков;
	Ожидаем.Что(Метрики.Минимум()).Равно(КолонкиОтчетаБенчмарков.Мин);
	Ожидаем.Что(Метрики.Среднее()).Равно(КолонкиОтчетаБенчмарков.Среднее);
	Ожидаем.Что(Метрики.Медиана()).Равно(КолонкиОтчетаБенчмарков.Медиана);
	Ожидаем.Что(Метрики.Максимум()).Равно(КолонкиОтчетаБенчмарков.Макс);
	Ожидаем.Что(Метрики.НижнийКвартиль()).Равно(КолонкиОтчетаБенчмарков.НижнийКвартиль);
	Ожидаем.Что(Метрики.ВерхнийКвартиль()).Равно(КолонкиОтчетаБенчмарков.ВерхнийКвартиль);
	Ожидаем.Что(Метрики.СтандартноеОтклонение()).Равно(КолонкиОтчетаБенчмарков.СтандартноеОтклонение);
	Ожидаем.Что(Метрики.СтандартнаяОшибка()).Равно(КолонкиОтчетаБенчмарков.СтандартнаяОшибка);
	Ожидаем.Что(Метрики.ОперацийВСекунду()).Равно(КолонкиОтчетаБенчмарков.ОперацийВСекунду);
	Ожидаем.Что(Метрики.ВыделяемаяПамять()).Равно(КолонкиОтчетаБенчмарков.ВыделяемаяПамять);
	Ожидаем.Что(Метрики.КоэффициентПроизводительности())
		.Равно(КолонкиОтчетаБенчмарков.КоэффициентПроизводительности);
	Ожидаем.Что(Метрики.RatioSD()).Равно(КолонкиОтчетаБенчмарков.RatioSD);

КонецПроцедуры

