Процедура ТестДолжен_НеИзменитьИсходныйПорядокЗапусков() Экспорт
	// Подготовка
	Результат = ТестовыйРезультат();
	Проверка = Новый ПроверкаРезультатаБенчмарков(Результат).ОтборБенчмарка("Поиск");

	// Действие
	Проверка.Метрика(МетрикиБенчмарков.Минимум()).Больше(0);

	// Проверка
	Ожидаем.Что(Результат.Запуски).ИмеетДлину(3);
	Ожидаем.Что(Результат.Запуски[0].Кейс.Идентификатор()).Равно(1);
	Ожидаем.Что(Результат.Запуски[1].Кейс.Идентификатор()).Равно(2);
	Ожидаем.Что(Результат.Запуски[2].Кейс.Идентификатор()).Равно(3);
КонецПроцедуры

