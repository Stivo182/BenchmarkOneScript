	Проверка.Метрика(МетрикиБенчмарков.Минимум(), ЕдиницыИзмеренийБенчмарков.Микросекунда).Равно(1000);
	Проверка.Метрика(МетрикиБенчмарков.ВыделяемаяПамять(), ЕдиницыИзмеренийБенчмарков.Килобайт).Равно(1);
