&Тест
Процедура ТестДолжен_СообщитьОбоВсехКейсахБезЭталона() Экспорт
	// Подготовка
	Проверка = Новый ПроверкаРезультатаБенчмарков(ТестовыйРезультат());
	Метрики = Новый Массив();
	Метрики.Добавить(МетрикиБенчмарков.КоэффициентПроизводительности());
	Метрики.Добавить(МетрикиБенчмарков.RatioSD());

	// Действие и Проверка
	Для Каждого Метрика Из Метрики Цикл
		ПараметрыМетода = Новый Массив();
		ПараметрыМетода.Добавить(Метрика);
		Ожидаем.Что(Проверка).Метод("Метрика", ПараметрыМетода).ВыбрасываетИсключение("не найден эталон");
		Ожидаем.Что(Проверка).Метод("Метрика", ПараметрыМетода).ВыбрасываетИсключение("2 из 3 кейсов");
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ТестыФильтровКейсов

&Тест
Процедура ТестДолжен_ОбъединитьПовторныеБенчмаркиЧерезИли() Экспорт
	// Подготовка
	Проверка = Новый ПроверкаРезультатаБенчмарков(ТестовыйРезультат())
		.ОтборБенчмарка("Сортировка")
		.ОтборБенчмарка("Поиск");

	ПараметрыСравнения = Новый Массив();
	ПараметрыСравнения.Добавить(0.5);

	// Действие и Проверка
	ПроверкаМетрики = Проверка.Метрика(
		МетрикиБенчмарков.Минимум(), ЕдиницыИзмеренийБенчмарков.Миллисекунда
	);
	Ожидаем.Что(ПроверкаМетрики).Метод("Равно", ПараметрыСравнения)
		.ВыбрасываетИсключение("Нарушений: 2 из 3 кейсов");
	Ожидаем.Что(ПроверкаМетрики).Метод("Равно", ПараметрыСравнения)
		.ВыбрасываетИсключение("Кейс #1");
	Ожидаем.Что(ПроверкаМетрики).Метод("Равно", ПараметрыСравнения)
		.ВыбрасываетИсключение("Кейс #2");
КонецПроцедуры

