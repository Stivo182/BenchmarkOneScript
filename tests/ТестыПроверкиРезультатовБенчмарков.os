	Проверка.Метрика(МетрикиБенчмарков.Процентиль(95)).Больше(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзвлечьОтносительныеМетрикиПриНаличииЭталона() Экспорт
	// Подготовка
	Результат = Новый РезультатЗапускаБенчмарков();
	Эталон = ТестовыйЗапуск(
		1, "Поиск", "", Новый Структура(), "2.0.0", Истина, "1000000, 2000000", "1024"
	);

	Кандидат = ТестовыйЗапуск(
		2, "Поиск", "", Новый Структура(), "2.0.0", Ложь, "2000000, 4000000", "1024"
	);

	Кандидат.Эталон = Эталон;
	Результат.Запуски.Добавить(Эталон);
	Результат.Запуски.Добавить(Кандидат);

	Проверка = Новый ПроверкаРезультатаБенчмарков(Результат);
	// Действие и Проверка
	Проверка.Метрика(МетрикиБенчмарков.КоэффициентПроизводительности()).БольшеИлиРавно(0);
	Проверка.Метрика(МетрикиБенчмарков.RatioSD()).БольшеИлиРавно(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_КонвертироватьЕдиницуМетрики() Экспорт
