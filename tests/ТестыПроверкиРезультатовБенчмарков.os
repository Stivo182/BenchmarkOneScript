#Область ТестыПроверкиМетрик

&Тест
Процедура ТестДолжен_ПроверитьВсеУсловияСравненияИВернутьСебя() Экспорт

	// Подготовка
	Значения = Новый Массив;
	Значения.Добавить(Новый Структура("Значение,ПредставлениеКейса", 10, "кейc"));

	Проверка = Новый ПроверкаМетрикиБенчмарков("Время", "мс", Значения);

	// Действие и Проверка
	Ожидаем.Что(Проверка.Равно(10)).Равно(Проверка);
	Ожидаем.Что(Проверка.Меньше(11)).Равно(Проверка);
	Ожидаем.Что(Проверка.Больше(9)).Равно(Проверка);
	Ожидаем.Что(Проверка.Между(10, 10)).Равно(Проверка);
	Ожидаем.Что(Проверка.Около(10, 0)).Равно(Проверка);
	Ожидаем.Что(Проверка.МеньшеИлиРавно(10)).Равно(Проверка);
	Ожидаем.Что(Проверка.БольшеИлиРавно(10)).Равно(Проверка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьНарушенияИВыдатьИхВИсключении() Экспорт

	// Подготовка
	Значения = Новый Массив;
	Значения.Добавить(Новый Структура("Значение,ПредставлениеКейса", 10, "первый"));
	Значения.Добавить(Новый Структура("Значение,ПредставлениеКейса", 20, "второй"));
	Значения.Добавить(Новый Структура("Значение,ПредставлениеКейса", 30, "третий"));

	Проверка = Новый ПроверкаМетрикиБенчмарков("Время", "мс", Значения);

	// Действие и Проверка
	Аргументы = Новый Массив;
	Аргументы.Добавить(15);

	Ожидаем.Что(Проверка).Метод("Меньше", Аргументы)
		.ВыбрасываетИсключение("Время: ожидаемое условие Меньше 15. Нарушений: 2 из 3 кейсов");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныеАргументыСравнения() Экспорт

	// Подготовка
	Проверка = Новый ПроверкаМетрикиБенчмарков("Время", "мс", Новый Массив());

	// Действие и Проверка
	Аргументы = Новый Массив;
	Аргументы.Добавить(20);
	Аргументы.Добавить(10);

	Ожидаем.Что(Проверка).Метод("Между", Аргументы).ВыбрасываетИсключение("Минимум диапазона");

	Аргументы = Новый Массив;
	Аргументы.Добавить(10);
	Аргументы.Добавить(-1);

	Ожидаем.Что(Проверка)
		.Метод("Около", Аргументы)
		.ВыбрасываетИсключение("Допуск не может быть отрицательным");
	Аргументы = Новый Массив;
	Аргументы.Добавить("10");

	Ожидаем.Что(Проверка).Метод("Равно", Аргументы).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьЧисловойАргументНаПустомНаборе() Экспорт
	// Подготовка
	Проверка = Новый ПроверкаМетрикиБенчмарков("Время", "мс", Новый Массив);
	Аргументы = Новый Массив;
	Аргументы.Добавить("10");

	// Действие и Проверка
	Ожидаем.Что(Проверка)
		.Метод("Равно", Аргументы)
		.ВыбрасываетИсключение("Аргументы сравнения должны быть числами");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыброситьИсключениеНаНарушенииГраницВсехУсловий() Экспорт
	// Подготовка
	Значения = Новый Массив;
	Значения.Добавить(Новый Структура("Значение,ПредставлениеКейса", 10, "кейс"));

	Проверка = Новый ПроверкаМетрикиБенчмарков("Время", "мс", Значения);

	// Действие и Проверка
	ПроверитьНарушение(Проверка, "Равно", Аргументы(9));
	ПроверитьНарушение(Проверка, "Больше", Аргументы(11));
	ПроверитьНарушение(Проверка, "Между", Аргументы(11, 12));
	ПроверитьНарушение(Проверка, "Около", Аргументы(20, 1));
	ПроверитьНарушение(Проверка, "МеньшеИлиРавно", Аргументы(9));
	ПроверитьНарушение(Проверка, "БольшеИлиРавно", Аргументы(11));
КонецПроцедуры

Функция Аргументы(Значение1, Значение2 = Неопределено)
	Результат = Новый Массив;
	Результат.Добавить(Значение1);
	Если Значение2 <> Неопределено Тогда
		Результат.Добавить(Значение2);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ПроверитьНарушение(Проверка, ИмяМетода, Аргументы)
	Ожидаем.Что(Проверка)
		.Метод(ИмяМетода, Аргументы)
		.ВыбрасываетИсключение("Нарушений: 1 из 1 кейсов");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьНеопределенныеАргументыИЕдиницуИзмерения() Экспорт
	// Подготовка
	Проверка = Новый ПроверкаМетрикиБенчмарков(
		"Время", ЕдиницыИзмеренийБенчмарков.Миллисекунда, Новый Массив
	);

	Ожидаем.Что(ЕдиницыИзмеренийБенчмарков.Миллисекунда.Обозначение).Равно("ms");

	// Действие и Проверка
	НевалидныеАргументы = Новый Массив;
	НевалидныеАргументы.Добавить(1);
	НевалидныеАргументы.Добавить(Неопределено);

	Ожидаем.Что(Проверка)
		.Метод("Между", НевалидныеАргументы)
		.ВыбрасываетИсключение("Аргументы сравнения должны быть числами");
	Ожидаем.Что(Проверка)
		.Метод("Около", НевалидныеАргументы)
		.ВыбрасываетИсключение("Аргументы сравнения должны быть числами");

	Значения = Новый Массив;
	Значения.Добавить(Новый Структура("Значение,ПредставлениеКейса", 10, "кейс"));

	Проверка = Новый ПроверкаМетрикиБенчмарков(
		"Время", ЕдиницыИзмеренийБенчмарков.Миллисекунда, Значения
	);

	// Действие и Проверка
	Ожидаем.Что(Проверка).Метод("Меньше", Аргументы(10)).ВыбрасываетИсключение("кейс: 10 ms");
	Ожидаем.Что(Проверка).Метод("Меньше", Аргументы(10)).ВыбрасываетИсключение("Нарушений");
	Ожидаем.Что(Проверка).Метод("Больше", Аргументы(10)).ВыбрасываетИсключение("Нарушений");
КонецПроцедуры

#КонецОбласти

#Область ТестыИзвлеченияМетрик

&Тест
Процедура ТестДолжен_ПроверитьМетрикуВсехКейсовПоУмолчанию() Экспорт
	// Подготовка
	Результат = ТестовыйРезультат();
	ПроверкаМетрики = Новый ПроверкаРезультатаБенчмарков(Результат).Метрика(МетрикиБенчмарков.Минимум());

	ПараметрыМаксимума = Новый Массив();
	ПараметрыМаксимума.Добавить(1500000);

	ПараметрыМинимума = Новый Массив();
	ПараметрыМинимума.Добавить(750000);

	// Действие и Проверка
	Ожидаем.Что(ПроверкаМетрики)
		.Метод("МеньшеИлиРавно", ПараметрыМаксимума)
		.ВыбрасываетИсключение("Кейс #2");
	Ожидаем.Что(ПроверкаМетрики)
		.Метод("БольшеИлиРавно", ПараметрыМинимума)
		.ВыбрасываетИсключение("Кейс #3");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзвлечьСтандартныеМетрики() Экспорт
	// Подготовка
	Проверка = Новый ПроверкаРезультатаБенчмарков(ТестовыйРезультат());
	Метрики = Новый Массив();
	Метрики.Добавить(МетрикиБенчмарков.Минимум());
	Метрики.Добавить(МетрикиБенчмарков.Среднее());
	Метрики.Добавить(МетрикиБенчмарков.Медиана());
	Метрики.Добавить(МетрикиБенчмарков.Максимум());
	Метрики.Добавить(МетрикиБенчмарков.НижнийКвартиль());
	Метрики.Добавить(МетрикиБенчмарков.ВерхнийКвартиль());
	Метрики.Добавить(МетрикиБенчмарков.СтандартноеОтклонение());
	Метрики.Добавить(МетрикиБенчмарков.СтандартнаяОшибка());
	Метрики.Добавить(МетрикиБенчмарков.ОперацийВСекунду());
	Метрики.Добавить(МетрикиБенчмарков.ВыделяемаяПамять());

	// Действие и Проверка
	Для Каждого Метрика Из Метрики Цикл
		Проверка.Метрика(Метрика).Больше(0);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзвлечьПроцентиль() Экспорт
	// Подготовка
	Проверка = Новый ПроверкаРезультатаБенчмарков(ТестовыйРезультат());
