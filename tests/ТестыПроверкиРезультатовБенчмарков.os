КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъединитьЗначенияОдногоПараметраЧерезИли() Экспорт
	// Подготовка
	Результат = ТестовыйРезультат();
	Результат.Запуски.Добавить(ТестовыйЗапуск(
		4, "Запасной", "", Новый Структура("Размер", 10),
		"2.0.0", Ложь, "10000000", "1024"
	));
	Проверка = Новый ПроверкаРезультатаБенчмарков(Результат)
		.ОтборПараметра("Размер", 100)
		.ОтборПараметра("Размер", 1000);

	ПараметрыСравнения = Новый Массив();
	ПараметрыСравнения.Добавить(0.5);
	// Действие и Проверка
	ПроверкаМетрики = Проверка.Метрика(
		МетрикиБенчмарков.Минимум(), ЕдиницыИзмеренийБенчмарков.Миллисекунда
	);
	Ожидаем.Что(ПроверкаМетрики).Метод("Равно", ПараметрыСравнения)
		.ВыбрасываетИсключение("Нарушений: 2 из 3 кейсов");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъединитьРазныеПараметрыЧерезИ() Экспорт
	// Подготовка
	Результат = Новый РезультатЗапускаБенчмарков();
	Результат.Запуски.Добавить(ТестовыйЗапуск(
		1, "Поиск", "", Новый Структура("Размер, Режим", 1000, "Медленный"),
		"2.0.0", Ложь, "1000000", "1024"
	));
	Результат.Запуски.Добавить(ТестовыйЗапуск(
		2, "Поиск", "", Новый Структура("Размер, Режим", 100, "Быстрый"),
		"2.0.0", Ложь, "1000000", "1024"
	));
	Результат.Запуски.Добавить(ТестовыйЗапуск(
		3, "Поиск", "", Новый Структура("Размер, Режим", 1000, "Быстрый"),
		"2.0.0", Ложь, "500000", "1024"
	));
	Проверка = Новый ПроверкаРезультатаБенчмарков(Результат)
		.ОтборПараметра("Размер", 1000)
		.ОтборПараметра("Режим", "Быстрый");

	// Действие и Проверка
	Проверка.Метрика(МетрикиБенчмарков.Минимум(), ЕдиницыИзмеренийБенчмарков.Миллисекунда).Равно(0.5);
КонецПроцедуры

