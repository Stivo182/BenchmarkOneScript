	// Проверка
	Предупреждение = РезультатЗапускаКейса.Предупреждения[0];
	Ожидаем.Что(Предупреждение.Код).Равно(КодыДиагностическихСобытийБенчмарков.НедостаточноИзмерений());
	Ожидаем.Что(Предупреждение.Уровень).Равно(УровниДиагностическихСобытийБенчмарков.Предупреждение());
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.КоличествоИзмерений).Равно(1);
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.ТребуемоеКоличествоИзмерений).Равно(2);

