Процедура ТестДолжен_ПредупредитьОНедостигнутойАдаптивнойПогрешности() Экспорт

	// Подготовка
	Конфигурация = Новый КонфигурацияБенчмарков()
		.ВключитьАдаптивныеИтерации()
		.УстановитьЦелевуюОтносительнуюПогрешность(0.01)
		.УстановитьМаксимальноеКоличествоАдаптивныхИтераций(3)
		.УстановитьМинимальноеКоличествоАдаптивныхИтераций(2);

	РезультатЗапускаКейса = РезультатСЗамерами(10, 3);
	РезультатЗапускаКейса.Замеры[1].НаносекундЗаОперацию = 20;
	РезультатЗапускаКейса.Замеры[2].НаносекундЗаОперацию = 30;
	РезультатЗапускаКейса.ПересчитатьСтатистику();
	РезультатЗапускаКейса.Статистика.ОтносительнаяПогрешность = 0.12;

	Результаты = Новый РезультатЗапускаБенчмарков();
	Результаты.Конфигурация = Конфигурация;
	Результаты.Запуски.Добавить(РезультатЗапускаКейса);

	// Действие
	Результаты.ОценитьДостоверность();

	// Проверка
	Предупреждение = НайтиДиагностическоеСобытие(
		РезультатЗапускаКейса.Предупреждения,
		КодыДиагностическихСобытийБенчмарков.ПогрешностьВышеЦели()
	);
	Ожидаем.Что(Предупреждение.Уровень).Равно(УровниДиагностическихСобытийБенчмарков.Предупреждение());
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.ФактическаяОтносительнаяПогрешность).Равно(0.12);
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.ЦелеваяОтносительнаяПогрешность).Равно(0.01);
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.КоличествоИзмерений).Равно(3);

КонецПроцедуры

