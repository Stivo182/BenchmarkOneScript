&Тест
Процедура ТестДолжен_ПредупредитьОКороткойИтерации() Экспорт

	// Подготовка
	РезультатЗапускаКейса = РезультатСЗамерами(10, 15);
	Для Каждого Замер Из РезультатЗапускаКейса.Замеры Цикл
		Замер.Наносекунд = 80000000;
		Замер.КоличествоОпераций = 65536;
	КонецЦикла;
	Результаты = Новый РезультатЗапускаБенчмарков();
	Результаты.Запуски.Добавить(РезультатЗапускаКейса);

	// Действие
	Результаты.ОценитьДостоверность();

	// Проверка
	Предупреждение = РезультатЗапускаКейса.Предупреждения[0];
	Ожидаем.Что(Предупреждение.Код).Равно(КодыДиагностическихСобытийБенчмарков.СлишкомКороткаяИтерация());
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.СредняяДлительностьИтерацииВМиллисекундах).Равно(80);
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.ЦелеваяДлительностьИтерацииВМиллисекундах).Равно(100);
	Ожидаем.Что(Предупреждение.ЧисловыеПараметры.КоличествоВызовов).Равно(65536);

КонецПроцедуры

