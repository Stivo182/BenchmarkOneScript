	// Проверка
	Ожидаем.Что(ЕстьДиагностическоеСобытие(
		РезультатЗапускаКейса.Предупреждения,
		КодыДиагностическихСобытийБенчмарков.СлишкомКороткаяИтерация()
	)).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатСЗамерами(НаносекундЗаОперацию, КоличествоИтераций)

	Результат = Новый РезультатЗапускаКейса();

	Для НомерИтерации = 1 По КоличествоИтераций Цикл
		Замер = Новый РезультатИтерацииКейса();
		Замер.Этап = ЭтапыБенчмарка.Измерение();
		Замер.НомерИтерации = НомерИтерации;
		Замер.НаносекундЗаОперацию = НаносекундЗаОперацию;
		Замер.Наносекунд = НаносекундЗаОперацию;
		Результат.Замеры.Добавить(Замер);
	КонецЦикла;

	Результат.ПересчитатьСтатистику();

	Возврат Результат;

КонецФункции

Функция ЕстьДиагностическоеСобытие(События, Код)

	Для Каждого Событие Из События Цикл
		Если Событие.Код = Код Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НайтиДиагностическоеСобытие(События, Код)

	Для Каждого Событие Из События Цикл
		Если Событие.Код = Код Тогда
			Возврат Событие;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
