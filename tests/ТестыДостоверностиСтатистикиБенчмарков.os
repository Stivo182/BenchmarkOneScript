#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатСЗамерами(НаносекундЗаОперацию, КоличествоИтераций)

	Результат = Новый РезультатЗапускаКейса();

	Для НомерИтерации = 1 По КоличествоИтераций Цикл
		Замер = Новый РезультатИтерацииКейса();
		Замер.Этап = ЭтапыБенчмарка.Измерение;
		Замер.НомерИтерации = НомерИтерации;
		Замер.НаносекундЗаОперацию = НаносекундЗаОперацию;
		Замер.Наносекунд = НаносекундЗаОперацию;
		Результат.Замеры.Добавить(Замер);
	КонецЦикла;

	Результат.ПересчитатьСтатистику();

	Возврат Результат;

КонецФункции

#КонецОбласти
