&Тест
Процедура ТестДолжен_ВернутьТекстовыеЗначенияРезультатовСтатистическогоСравнения() Экспорт

	// Действие и Проверка
	Ожидаем.Что(РезультатыСравненияБенчмарков.НедостаточноДанных()).Равно("Недостаточно данных");
	Ожидаем.Что(РезультатыСравненияБенчмарков.ПрактическиОдинаково()).Равно("Практически одинаково");
	Ожидаем.Что(РезультатыСравненияБенчмарков.РазличиеНеОбнаружено()).Равно("Различие не обнаружено");
	Ожидаем.Что(РезультатыСравненияБенчмарков.Эталон()).Равно("Эталон");
	Ожидаем.Что(РезультатыСравненияБенчмарков.Быстрее()).Равно("Быстрее");
	Ожидаем.Что(РезультатыСравненияБенчмарков.Медленнее()).Равно("Медленнее");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСравниватьСЭталономБезЯвнойНастройки() Экспорт

	// Подготовка
	Эталон = РезультатСЗамерами(100, 20);
	Эталон.ЭтоЭталон = Истина;
	Текущий = РезультатСЗамерами(10, 20);
	Текущий.Эталон = Эталон;

	Результаты = Новый РезультатЗапускаБенчмарков();
	Результаты.Запуски.Добавить(Текущий);
	Результаты.Запуски.Добавить(Эталон);

	// Действие
	Результаты.ОценитьДостоверность();

	// Проверка
	Ожидаем.Что(Текущий.РезультатСтатистическогоСравнения).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьРезультатСтатистическогоСравненияСЭталоном() Экспорт

	// Подготовка
	Эталон = РезультатСЗамерами(100, 20);
	Эталон.ЭтоЭталон = Истина;
	Текущий = РезультатСЗамерами(10, 20);
	Текущий.Эталон = Эталон;

	Результаты = Новый РезультатЗапускаБенчмарков();
	Результаты.Конфигурация.ВключитьСтатистическоеСравнениеСЭталоном();
	Результаты.Конфигурация.УстановитьОтносительныйПорогПрактическойЗначимости(0.1);
	Результаты.Запуски.Добавить(Текущий);
	Результаты.Запуски.Добавить(Эталон);

	// Действие
	Результаты.ОценитьДостоверность();

	// Проверка
	Ожидаем.Что(Текущий.РезультатСтатистическогоСравнения).Равно(РезультатыСравненияБенчмарков.Быстрее());
	Ожидаем.Что(Эталон.РезультатСтатистическогоСравнения).Равно(РезультатыСравненияБенчмарков.Эталон());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьНастроенныйПорогСтатистическогоСравнения() Экспорт

	// Подготовка
	Эталон = РезультатСЗамерами(100, 25);
	Текущий = РезультатСЗамерами(94, 25);
	Текущий.Эталон = Эталон;

	Результаты = Новый РезультатЗапускаБенчмарков();
	Результаты.Конфигурация.ВключитьСтатистическоеСравнениеСЭталоном();
	Результаты.Конфигурация.УстановитьОтносительныйПорогПрактическойЗначимости(0.1);
	Результаты.Запуски.Добавить(Текущий);

	// Действие
	Результаты.ОценитьДостоверность();

	// Проверка
	Ожидаем.Что(Текущий.РезультатСтатистическогоСравнения).Равно(РезультатыСравненияБенчмарков.ПрактическиОдинаково());

	// Действие
	Результаты.Конфигурация.УстановитьОтносительныйПорогПрактическойЗначимости(0.05);
	Результаты.ОценитьДостоверность();

	// Проверка
	Ожидаем.Что(Текущий.РезультатСтатистическогоСравнения).Равно(РезультатыСравненияБенчмарков.Быстрее());

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьУскорениемУлучшениеМеньшеПрактическогоПорога() Экспорт

	// Подготовка
	ТекущиеЗамеры = Новый Массив();
	ЭталонныеЗамеры = Новый Массив();

	Для НомерЗамера = 1 По 25 Цикл
		ТекущиеЗамеры.Добавить(86);
		ЭталонныеЗамеры.Добавить(100);
	КонецЦикла;

	// Действие
	РезультатСравнения = МатематическиеФункцииБенчмарков.ОценитьРазличиеПоКритериюМаннаУитни(
		ТекущиеЗамеры,
		ЭталонныеЗамеры,
		0.15,
		0.0005
	);

	// Проверка
	Ожидаем.Что(РезультатСравнения).Равно(РезультатыСравненияБенчмарков.ПрактическиОдинаково());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределятьУскорениеПоРангамАНеПоСреднему() Экспорт

	// Подготовка
	ТекущиеЗамеры = Новый Массив();
	ЭталонныеЗамеры = Новый Массив();

	Для НомерЗамера = 1 По 21 Цикл
		ТекущиеЗамеры.Добавить(1);
	КонецЦикла;

	Для НомерЗамера = 1 По 4 Цикл
		ТекущиеЗамеры.Добавить(1000);
	КонецЦикла;

	Для НомерЗамера = 1 По 25 Цикл
		ЭталонныеЗамеры.Добавить(100);
	КонецЦикла;

	// Действие
	РезультатСравнения = МатематическиеФункцииБенчмарков.ОценитьРазличиеПоКритериюМаннаУитни(
		ТекущиеЗамеры,
		ЭталонныеЗамеры,
		0.15,
		0.0005
	);

	// Проверка
	Ожидаем.Что(МатематическиеФункцииБенчмарков.Среднее(ТекущиеЗамеры)).Больше(МатематическиеФункцииБенчмарков.Среднее(ЭталонныеЗамеры));
	Ожидаем.Что(РезультатСравнения).Равно(РезультатыСравненияБенчмарков.Быстрее());

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПредупреждатьОМаломЧислеИзмеренийПриДвухИтерациях() Экспорт

	// Подготовка
	РезультатЗапускаКейса = РезультатСЗамерами(10, 2);
	Результаты = Новый РезультатЗапускаБенчмарков();
	Результаты.Запуски.Добавить(РезультатЗапускаКейса);

	// Действие
	Результаты.ОценитьДостоверность();

	// Проверка
	Ожидаем.Что(РезультатЗапускаКейса.Предупреждения).Не_().Содержит("Недостаточно измерительных итераций: N < 15");
	Ожидаем.Что(РезультатЗапускаКейса.Предупреждения).Не_().Содержит("Невозможно оценить погрешность: требуется не менее двух измерений");

КонецПроцедуры

