Процедура ТестДолжен_НеПредупреждатьОКороткойИтерацииПриДлинномБатче() Экспорт

	// Подготовка
	РезультатЗапускаКейса = РезультатСЗамерами(10, 15);

	Для Каждого Замер Из РезультатЗапускаКейса.Замеры Цикл
		Замер.Наносекунд = 100000000;
	КонецЦикла;

	Результаты = Новый РезультатЗапускаБенчмарков();
	Результаты.Запуски.Добавить(РезультатЗапускаКейса);

