// BSLLS:MagicDate-off
// BSLLS:MagicNumber-off

#Использовать asserts
#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_СериализоватьДатуВJsonВФорматеIsoСБуквойT() Экспорт

	// Действие и Проверка
	Ожидаем.Что(СериализацияОбъектовБенчмаркинга.ВJson(Дата(2025, 1, 1, 0, 0, 0)))
		.Равно("""2025-01-01T00:00:00""");
	Ожидаем.Что(СериализацияОбъектовБенчмаркинга.ВJson(Дата(1970, 1, 1, 0, 0, 0)))
		.Равно("""1970-01-01T00:00:00""");
	Ожидаем.Что(СериализацияОбъектовБенчмаркинга.ВJson(Дата(1, 1, 1, 0, 0, 0)))
		.Равно("""0001-01-01T00:00:00""");
	Ожидаем.Что(СериализацияОбъектовБенчмаркинга.ВJson(Дата(9999, 12, 31, 23, 59, 59)))
		.Равно("""9999-12-31T23:59:59""");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДесериализоватьСтрокуIsoДатыВПроизвольномЗначении() Экспорт

	// Подготовка
	Json = "{
	|	""Name"": ""Дата"",
	|	""Value"": ""2025-01-01T00:00:00"",
	|	""TextValue"": ""01.01.2025 0:00:00"",
	|	""IsMethodParameter"": false
	|}";

	// Действие
	Параметр = СериализацияОбъектовБенчмаркинга.ИзJson(Json, Тип("ПараметрБенчмарка"));

	// Проверка
	Ожидаем.Что(Параметр.Значение(), "Значение параметра").ИмеетТип("Дата");
	Ожидаем.Что(Параметр.Значение(), "Значение параметра").Равно('20250101000000');
	Ожидаем.Что(Параметр.Представление(), "Представление параметра").Равно("01.01.2025 0:00:00");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДесериализоватьСтрокуIsoДатыСZВПроизвольномЗначении() Экспорт

	// Подготовка
	Json = "{
	|	""Name"": ""Дата"",
	|	""Value"": ""2025-01-01T00:00:00Z"",
	|	""TextValue"": ""01.01.2025 0:00:00"",
	|	""IsMethodParameter"": false
	|}";

	// Действие
	Параметр = СериализацияОбъектовБенчмаркинга.ИзJson(Json, Тип("ПараметрБенчмарка"));

	// Проверка
	Ожидаем.Что(Параметр.Значение(), "Значение параметра").ИмеетТип("Дата");
	Ожидаем.Что(Параметр.Значение(), "Значение параметра").Равно('20250101000000');

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДесериализоватьСтрокуIsoДатыСоСмещениемВПроизвольномЗначении() Экспорт

	// Подготовка
	СтрокаДаты = "2025-01-01T12:00:00+03:00";
	Json = "{
	|	""Name"": ""Дата"",
	|	""Value"": """ + СтрокаДаты + """,
	|	""TextValue"": ""01.01.2025 12:00:00"",
	|	""IsMethodParameter"": false
	|}";
	ОжидаемаяДата = ПрочитатьДатуJSON(СтрокаДаты, ФорматДатыJSON.ISO);

	// Действие
	Параметр = СериализацияОбъектовБенчмаркинга.ИзJson(Json, Тип("ПараметрБенчмарка"));

	// Проверка
	Ожидаем.Что(Параметр.Значение(), "Значение параметра").ИмеетТип("Дата");
	Ожидаем.Что(Параметр.Значение(), "Значение параметра").Равно(ОжидаемаяДата);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьСтрокуIsoДатыВПредставленииПараметра() Экспорт

	// Подготовка
	Json = "{
	|	""Name"": ""Дата"",
	|	""Value"": 1,
	|	""TextValue"": ""2025-01-01T00:00:00"",
	|	""IsMethodParameter"": false
	|}";

	// Действие
	Параметр = СериализацияОбъектовБенчмаркинга.ИзJson(Json, Тип("ПараметрБенчмарка"));

	// Проверка
	Ожидаем.Что(Параметр.Представление(), "Представление параметра").ИмеетТип("Строка");
	Ожидаем.Что(Параметр.Представление(), "Представление параметра").Равно("2025-01-01T00:00:00");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПреобразоватьАвтоматическиПрочитаннуюДатуВСтрокуЕслиОжидаетсяСтрока() Экспорт

	// Подготовка
	Десериализатор = Новый ДесериализаторJsonBench();

	// Действие
	Значение = Десериализатор.ПреобразоватьОбъектДесериализации('20250101000000', Тип("Строка"));

	// Проверка
	Ожидаем.Что(Значение, "Преобразованное значение").ИмеетТип("Строка");
	Ожидаем.Что(Значение, "Преобразованное значение").Равно("2025-01-01T00:00:00");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПоведениеНеподдержанногоТипаВНетипизированномМассиве() Экспорт

	// Подготовка
	НеподдержанноеЗначение = Новый ЧтениеXML();
	Массив = Новый Массив;
	Массив.Добавить(НеподдержанноеЗначение);
	Десериализатор = Новый ДесериализаторJsonBench();

	// Действие
	Результат = Десериализатор.ПреобразоватьОбъектДесериализации(Массив, Тип("Массив"));

	// Проверка
	Ожидаем.Что(Результат[0], "Значение неподдержанного типа").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти
