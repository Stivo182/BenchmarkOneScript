&Тест
Процедура ТестДолжен_СериализоватьИДесериализоватьНастройкиЗапускаБенчмарков() Экспорт

	// Подготовка
	Тип = Тип("БенчмаркСАннотациямиКонфигурации");
	Конфигурация = Новый КонфигурацияБенчмарков(Тип);
	КоллекцияДескрипторов = Новый КоллекцияДескрипторовБенчмарков(Тип);

	ИмяФайла = _МенеджерВременныхФайлов.НовоеИмяФайла();

	НастройкиЗапуска = Новый НастройкиЗапускаБенчмарков();
	НастройкиЗапуска.ДескрипторыБенчмарков = КоллекцияДескрипторов;
	НастройкиЗапуска.Конфигурация = Конфигурация;

	// Действие
	Сериализатор = Новый СериализаторНастроекЗапускаБенчмарков();
	Сериализатор.ЗаписатьВJson(НастройкиЗапуска, ИмяФайла);

	ДТО = Сериализатор.ПрочитатьИзJson(ИмяФайла);

	// Проверка
	ПроверитьДескрипторыБенчмаркаСАннотациямиКонфигурации(ДТО.ДескрипторыБенчмарков);
	ПроверитьКонфигурациюБенчмаркаСАннотациямиКонфигурации(ДТО.Конфигурация);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьНастройкиСтатистическогоСравнения() Экспорт

	// Подготовка
	Json = "{""Configuration"": {""StatisticalComparison"": true, ""StatisticalComparisonRelativeThreshold"": 0.05, ""StatisticalComparisonSignificanceLevel"": 0.001}}";

	// Действие
	Настройки = ПрочитатьПримерНастроек(Json);

	// Проверка
	Конфигурация = Настройки.Конфигурация;
	Ожидаем.Что(Конфигурация.СтатистическоеСравнениеСЭталономВключено()).ЭтоИстина();
	Ожидаем.Что(Конфигурация.ОтносительныйПорогПрактическойЗначимости()).Равно(0.05);
	Ожидаем.Что(Конфигурация.УровеньЗначимостиСтатистическогоСравнения()).Равно(0.001);

КонецПроцедуры

