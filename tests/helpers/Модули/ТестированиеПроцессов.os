#Использовать "../../.."

#Область ПрограммныйИнтерфейс

// Выполняет команду в тестовом процессе и объединяет его стандартный вывод и поток ошибок.
// Ожидание завершения ограничено 60 секундами.
//
// Параметры:
//   СтрокаКоманды  - Строка - Команда запуска процесса
//   РабочийКаталог - Строка - Рабочий каталог процесса
//
// Возвращаемое значение:
//   Структура:
//     * КодВозврата - Число - Код возврата процесса
//     * Вывод       - Строка - Объединенные стандартный вывод и поток ошибок
Функция ВыполнитьКоманду(СтрокаКоманды, РабочийКаталог) Экспорт

	Процесс = СоздатьПроцесс(СтрокаКоманды, РабочийКаталог, Истина);
	Процесс.Запустить();

	Вывод = "";
	ВремяНачала = ТекущаяУниверсальнаяДата();
	Пока Не Процесс.Завершен Цикл
		Приостановить(100);
		Вывод = Вывод + ПрочитатьВывод(Процесс);

		Если ТекущаяУниверсальнаяДата() - ВремяНачала >= 60 Тогда
			Процесс.Завершить();
			ВызватьИсключение "Превышено время ожидания завершения тестового процесса";
		КонецЕсли;
	КонецЦикла;

	Вывод = Вывод + ПрочитатьВывод(Процесс);

	Возврат Новый Структура("КодВозврата, Вывод", Процесс.КодВозврата, Вывод);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьВывод(Процесс)

	Вывод = "";
	Если Процесс.ПотокВывода.ЕстьДанные Тогда
		Вывод = Вывод + Процесс.ПотокВывода.Прочитать();
	КонецЕсли;

	Если Процесс.ПотокОшибок.ЕстьДанные Тогда
		Вывод = Вывод + Процесс.ПотокОшибок.Прочитать();
	КонецЕсли;

	Возврат Вывод;

КонецФункции

#КонецОбласти
