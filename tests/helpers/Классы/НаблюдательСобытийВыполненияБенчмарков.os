Перем _События; // Массив Из СобытиеВыполненияБенчмарков

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_События = Новый Массив();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура ОбработатьСобытие(Событие) Экспорт
	_События.Добавить(Событие);
КонецПроцедуры

Функция События() Экспорт
	Возврат _События;
КонецФункции

#КонецОбласти
